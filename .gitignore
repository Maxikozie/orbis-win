# the SDK bundle (92 MB) and anything unpacked from it
sdk/
*.tar.gz
*.tar.gz.sha256

# build trees and packaging output
build/
build-*/
pkgout/
*build-*/
codex_scratch/
__pycache__/
*.py[cod]

# local console settings
config.env

# Sony firmware modules, extracted from the console. NOT redistributable.
sce_module/

# local Mesa build tree (498 MB) — scripts/ rebuild it; the patch is in patches/
mesa-build/

# upstream PS5 source we port from
prospero-win/

# Wine source and the staged PE runtime (built by tools/)
prospero-win/.deps/

# the PS4 build shim (generated)
build/ps4-wine-sdk/

# ps5log destination: a workstation address, never committed (upstream's
# dev.conf.example says the same: "never commit a workstation address").
build/devconf/
