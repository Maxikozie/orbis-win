; Separate Oct 15 runtime control with keyboard directions from the left stick.
[application]
id = oblivion-oct15-stick
name = Oblivion (Oct 15 runtime, left-stick movement)
executable = C:\Games\OblivionGOG\Oblivion.exe
working_directory = C:\Games\OblivionGOG
prefix = oblivion-gog
runtime = wine-wow64
architecture = pe32
graphics = dxvk

[display]
desktop = 1920x1080
view = window
show_fps = true

[input]
mode = keyboard
mouse = right_stick
mouse_speed = 1200
cross = enter
circle = tab
square = f
triangle = e
l1 = alt
r1 = mouse_left
l2 = z
r2 = c
l3 = ctrl
r3 = r
up = up
down = down
left = left
right = right
options = escape
create = t

[runtime]
cpu = translator
