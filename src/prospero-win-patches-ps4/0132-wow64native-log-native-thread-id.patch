From: Codex <codex@local>
Subject: wow64native: log native thread ID with sampled PC

Pass through and print the native thread ID captured by ntdll for each PC
sample. This lets the umutex m_owner TID be matched to its sampled PC/stack.

---
--- a/wine/wow64native/unix.c
+++ b/wine/wow64native/unix.c
@@ -64,7 +64,7 @@
                                            unsigned long long *, unsigned long long *,
                                            unsigned long long *, unsigned long long *,
                                            unsigned long long *, unsigned long long *,
-                                           unsigned long long *);
+                                           unsigned long long *, unsigned long long *);
 static pw_native_pc_query profile_pc_query;
 static int profile_pc_enabled;
 static pthread_mutex_t profile_watch_lock = PTHREAD_MUTEX_INITIALIZER;
@@ -202,12 +202,13 @@
                 unsigned long long stack_deep_words[4] = {0};
                 unsigned long long rsp_words[4] = {0};
                 unsigned long long umtx_words[4] = {0};
+                unsigned long long native_tid = 0;
                 int owner_match;
                 unsigned int frames[8] = {0};
                 unsigned int frame_count = 0;
                 int rc;
                 profile_pc_query(&before, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL,
-                                 NULL, NULL, NULL, NULL, NULL, NULL);
+                                 NULL, NULL, NULL, NULL, NULL, NULL, NULL);
                 rc = pthread_kill(entry->native_thread, SIGPROF);
                 if (!rc)
                 {
@@ -217,7 +218,7 @@
                         nanosleep(&pause, NULL);
                         profile_pc_query(&sequence, &rip, &rsp, &cs, &rax, &rdi, &rsi, &rdx, &r10, &rbp, &rsp0,
                                          &sample_teb, frames64, &stack_limit, &stack_base, stack_words,
-                                         stack_deep_words, rsp_words, umtx_words);
+                                         stack_deep_words, rsp_words, umtx_words, &native_tid);
                         if (sequence != before) break;
                     }
                     owner_match = sample_teb == entry->native_teb;
@@ -244,7 +245,7 @@
                             frame = previous;
                         }
                     }
-                    WINE_MESSAGE("PW_NATIVE_PC teb=%llx native_teb=%llx sample_teb=%llx owner_match=%d seq=%llu rip=%llx rsp=%llx rsp0=%llx rbp=%llx ret=%08x frames=%u[%08x/%08x,%08x/%08x,%08x/%08x,%08x/%08x] host_frames=[%llx/%llx,%llx/%llx,%llx/%llx,%llx/%llx] host_bounds=%llx-%llx host_words=[%llx,%llx,%llx,%llx,%llx,%llx,%llx,%llx] host_deep=[%llx,%llx,%llx,%llx] rsp_words=[%llx,%llx,%llx,%llx] umtx_words=[%llx,%llx,%llx,%llx] cs=%llx rax=%llx rdi=%llx rsi=%llx rdx=%llx r10=%llx sample=%s\n",
+                    WINE_MESSAGE("PW_NATIVE_PC teb=%llx native_teb=%llx sample_teb=%llx owner_match=%d seq=%llu rip=%llx rsp=%llx rsp0=%llx rbp=%llx ret=%08x frames=%u[%08x/%08x,%08x/%08x,%08x/%08x,%08x/%08x] host_frames=[%llx/%llx,%llx/%llx,%llx/%llx,%llx/%llx] host_bounds=%llx-%llx host_words=[%llx,%llx,%llx,%llx,%llx,%llx,%llx,%llx] host_deep=[%llx,%llx,%llx,%llx] rsp_words=[%llx,%llx,%llx,%llx] umtx_words=[%llx,%llx,%llx,%llx] native_tid=%llx cs=%llx rax=%llx rdi=%llx rsi=%llx rdx=%llx r10=%llx sample=%s\n",
                                  entry->state->guest_fs, entry->native_teb, sample_teb, owner_match, sequence, rip, rsp, rsp0, rbp, frames[1], frame_count,
                                  frames[0], frames[1], frames[2], frames[3], frames[4], frames[5],
                                  frames[6], frames[7], frames64[0], frames64[1], frames64[2], frames64[3],
@@ -253,7 +254,7 @@
                                  stack_words[4], stack_words[5], stack_words[6], stack_words[7],
                                  stack_deep_words[0], stack_deep_words[1], stack_deep_words[2], stack_deep_words[3],
                                  rsp_words[0], rsp_words[1], rsp_words[2], rsp_words[3],
-                                 umtx_words[0], umtx_words[1], umtx_words[2], umtx_words[3], cs,
+                                 umtx_words[0], umtx_words[1], umtx_words[2], umtx_words[3], native_tid, cs,
                                  rax, rdi, rsi, rdx, r10,
                                  sequence != before ? "ok" : "timeout");
                 }
