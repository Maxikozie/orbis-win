From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] build: accept PS4 Wine patch 0943

Allow the measured raw Orbis trap-code fix for the next PS4 runtime test.

---
diff --git a/tools/build_wine_ps5.sh b/tools/build_wine_ps5.sh
--- a/tools/build_wine_ps5.sh
+++ b/tools/build_wine_ps5.sh
@@ -171,8 +171,8 @@
         number=$(printf '%s' "$patch" | cut -c1-4 | sed 's/^0*//')
         number=${number:-0}
-        [ "$number" -ge 100 ] && [ "$number" -le 942 ] ||
-            fail "patch number outside 0100-0942: $patch"
+        [ "$number" -ge 100 ] && [ "$number" -le 943 ] ||
+            fail "patch number outside 0100-0943: $patch"
         [ "$number" -ne "$last" ] || fail "duplicate patch number: $patch"
         last=$number
         grep -q '^Subject: ' "$patches/$patch" || fail "patch has no Subject: $patch"
---
2.43.0
