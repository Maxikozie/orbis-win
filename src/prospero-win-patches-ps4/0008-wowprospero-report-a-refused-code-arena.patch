From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ps4-gladius <ps4-gladius@invalid>
Date: Thu, 8 Oct 2026 09:20:00 +0000
Subject: [PATCH] wowprospero: say why the code arena was refused.

With emulated TLS in place the translator runs, and stops on its own memory:

    err:wow:BTCpuSimulate DBT error -9 at eip 0x7bf33290

-9 is PW_ERR_VM, "the memory backend refused a request". It reaches the caller
from pw_x86_engine's first commit of the code arena, and carries no status, no
size and no protection -- place_above_guest and commit_code both answer every
refusal with NULL or -1.

The arena is the one allocation on this console that has to end up executable,
and a plain executable mapping is refused here: orbis_jit.c gets it by mapping
direct memory read-write and protecting it afterwards. Which of the two calls
diff --git a/src/pw_x86_engine.c b/src/pw_x86_engine.c
index 92c877a..3ca3bbc 100644
--- a/src/pw_x86_engine.c
+++ b/src/pw_x86_engine.c
@@ -953,7 +953,27 @@ dispatch:;
     }
     engine->retired_instructions+=report->retired;
     if(invoked==PW_X86_REENCODE_HOST_STEP)return PW_ERR_UNSUPPORTED;
-    return invoked==PW_ERR_X87_TRAP?PW_ERR_X87_TRAP:invoked?PW_ERR_VM:PW_OK;
+    if(invoked && invoked!=PW_ERR_X87_TRAP) {
+        /* ⚠ DIAGNOSTIC. Running a translated block answers with its own
+         * status, and every value but these two collapses into PW_ERR_VM on the
+         * way out -- the same code the translator uses for a refused host
+         * allocation and for guest memory it cannot read. Keep the value. */
+#ifdef __PROSPERO__
+        extern int sceKernelDebugOutText(int channel,const char *text);
+        extern int snprintf(char *,size_t,const char *,...);
+        static int left=8;
+        if(left>0) {
+            char line[160];
+            left--;
+            snprintf(line,sizeof(line),
+                     "wowprospero: invoke returned %d at guest eip %08x\n",
+                     invoked,(unsigned)state->eip);
+            sceKernelDebugOutText(0,line);
+        }
+#endif
+        return PW_ERR_VM;
+    }
+    return invoked==PW_ERR_X87_TRAP?PW_ERR_X87_TRAP:PW_OK;
 }
 
 int pw_x86_execution_clock_batch(PwX86ExecutionClock clock, void *opaque, uint64_t *mean_ns)
diff --git a/wine/wowprospero/cpu.c b/wine/wowprospero/cpu.c
index 549dbd4..a64d382 100644
--- a/wine/wowprospero/cpu.c
+++ b/wine/wowprospero/cpu.c
@@ -527,7 +527,13 @@ void WINAPI BTCpuSimulate(void)
             raise_guest_exception( ctx, EXCEPTION_FLT_INVALID_OPERATION, 0, 0 );
             break;
         default:
-            ERR( "DBT error %d at eip %#lx\n", params.status, ctx->Eip );
+            /* ⚠ The address matters as much as the status: PW_ERR_VM is how
+             * the translator reports both a refused host allocation and guest
+             * memory it cannot read, and only the fault address tells them
+             * apart. */
+            ERR( "DBT error %d at eip %#lx, fault address %#lx%s\n", params.status,
+                 ctx->Eip, (unsigned long)params.fault_address,
+                 params.fault_write ? " (write)" : "" );
             /* End the process the way ExitProcess does: the other threads
              * first, which marks the process as exiting, so the call for
              * itself leaves through exit() and the host's exit handlers run
diff --git a/wine/wowprospero/unix.c b/wine/wowprospero/unix.c
index 01d21a5..13e8c84 100644
--- a/wine/wowprospero/unix.c
+++ b/wine/wowprospero/unix.c
@@ -43,6 +43,20 @@
 #include "call_top.h"
 #include "host_memory.h"
 
+/* ⚠ On the console this module's stderr goes nowhere: the sink ntdll installs
+ * is ntdll's own, and a PRX carries its own libc. Diagnostics go to klog
+ * instead. Off the console there is no klog and stderr is fine. */
+#ifdef __PROSPERO__
+extern int sceKernelDebugOutText( int channel, const char *text );
+#define PW_WOW_NOTE( ... ) do { \
+        char pw_wow_line[160]; \
+        snprintf( pw_wow_line, sizeof(pw_wow_line), __VA_ARGS__ ); \
+        sceKernelDebugOutText( 0, pw_wow_line ); \
+    } while (0)
+#else
+#define PW_WOW_NOTE( ... ) fprintf( stderr, __VA_ARGS__ )
+#endif
+
 /* The guest range every translated access is checked against (load_state). */
 enum { GUEST_LOW = 0x10000u, GUEST_HIGH = 0xfffff000u };
 /* The guest GPRs held in host registers across linked blocks: seven fit, and
@@ -357,11 +371,22 @@ static void *place_above_guest( size_t bytes, ULONG type, ULONG protect )
     MEM_EXTENDED_PARAMETER parameter = { 0 };
     SIZE_T size = bytes;
     void *base = NULL;
+    NTSTATUS status;
 
     parameter.Type = MemExtendedParameterAddressRequirements;
     parameter.Pointer = &requirements;
-    if (NtAllocateVirtualMemoryEx( NtCurrentProcess(), &base, &size, type, protect, &parameter, 1 ))
+    if ((status = NtAllocateVirtualMemoryEx( NtCurrentProcess(), &base, &size, type,
+                                             protect, &parameter, 1 )))
+    {
+        /* ⚠ DIAGNOSTIC. The translator's code arena is the one allocation on
+         * this console that has to end up executable, and every refusal here
+         * reached the caller as a bare PW_ERR_VM -- "the memory backend refused
+         * a request" -- with no status, no size and no protection:
+         *     err:wow:BTCpuSimulate DBT error -9 at eip 0x7bf33290 */
+        PW_WOW_NOTE( "wowprospero: %zu bytes type %x protect %x refused: %08x\n",
+                     bytes, (unsigned int)type, (unsigned int)protect, (unsigned int)status );
         return NULL;
+    }
     return base;
 }
 
@@ -385,9 +410,18 @@ static void *reserve_code( size_t bytes )
 static int commit_code( void *base, size_t bytes )
 {
     SIZE_T size = bytes;
+    void *at = base;
+    NTSTATUS status;
 
-    return NtAllocateVirtualMemory( NtCurrentProcess(), &base, 0, &size, MEM_COMMIT,
-                                    PAGE_EXECUTE_READWRITE ) ? -1 : 0;
+    if (!(status = NtAllocateVirtualMemory( NtCurrentProcess(), &base, 0, &size, MEM_COMMIT,
+                                            PAGE_EXECUTE_READWRITE )))
+        return 0;
+    /* ⚠ DIAGNOSTIC -- see place_above_guest. Executable memory is the whole
+     * question here: this console refuses a plain executable mapping and wants
+     * direct memory mapped read-write and then protected (orbis_jit.c). */
+    PW_WOW_NOTE( "wowprospero: commit %p %zu bytes executable refused: %08x\n",
+                 at, bytes, (unsigned int)status );
+    return -1;
 }
 
 static void release( void *base, size_t bytes )
