--- a/src/pw_x86_engine.c
+++ b/src/pw_x86_engine.c
@@ -5,6 +5,23 @@
 #include <stdint.h>
 #include <string.h>
 
+/* ⚠ DIAGNOSTIC. PW_ERR_VM is returned from twenty places in the translator --
+ * a refused host allocation, guest memory it cannot read, a span that leaves
+ * the 32-bit address space, a block that would not execute -- and they all
+ * arrive at the caller as the same number:
+ *     err:wow:BTCpuSimulate DBT error -9 at eip 0x7bf33290, fault address 0
+ * Name the one that fired. Bounded, and only on the console: this file also
+ * builds for the host, which has no klog. */
+#ifdef __PROSPERO__
+extern void pw_wow_log( const char *format, ... );
+#define PW_VM_NOTE(tag) do { \
+        static int pw_vm_left = 4; \
+        if (pw_vm_left > 0) { pw_vm_left--; pw_wow_log( "wowprospero: PW_ERR_VM at %s\n", tag ); } \
+    } while (0)
+#else
+#define PW_VM_NOTE(tag) ((void)0)
+#endif
+
 /* A zero tag would match guest PC zero and jump through an empty pointer.
  * PC one hashes to slot one, so it cannot match any lookup in empty slot
  * zero in either bank. A published PC zero replaces this sentinel normally.
@@ -276,9 +293,9 @@ static int emit_return_stub(PwX86Engine *engine)
     options.native_fp = engine->native_fp;
     if(!(bytes = pw_x86_reencode_return_stub(stub, sizeof(stub), &options))) return PW_ERR_UNSUPPORTED;
     const size_t page = engine->backend->page_bytes, end = ((bytes + page - 1) / page) * page;
-    if(protection(engine, 0, end, PW_PROT_READ|PW_PROT_WRITE) != PW_OK) return PW_ERR_VM;
+    if(protection(engine, 0, end, PW_PROT_READ|PW_PROT_WRITE) != PW_OK) { PW_VM_NOTE("pw_x86_engine.c:302"); return PW_ERR_VM; }
     memcpy(engine->code.write_base, stub, bytes);
-    if(protection(engine, 0, end, PW_PROT_READ|PW_PROT_EXEC) != PW_OK) return PW_ERR_VM;
+    if(protection(engine, 0, end, PW_PROT_READ|PW_PROT_EXEC) != PW_OK) { PW_VM_NOTE("pw_x86_engine.c:304"); return PW_ERR_VM; }
     engine->return_stub_bytes = (bytes + 63) & ~(size_t)63;
     engine->cache.cursor = engine->return_stub_bytes;
     return PW_OK;
@@ -621,7 +638,7 @@ static int compile_block(PwX86Engine *engine,uint32_t pc,const PwX86CacheEntry *
     size_t end=((tail+page-1)/page)*page;
     if(end>engine->code.bytes)end=engine->code.bytes;
     if(protection(engine,first,end-first,PW_PROT_READ|PW_PROT_WRITE)!=PW_OK)
-        return PW_ERR_VM;
+        { PW_VM_NOTE("pw_x86_engine.c:647"); return PW_ERR_VM; }
     memcpy((uint8_t *)engine->code.write_base+engine->cache.cursor,scratch,best.code_bytes);
     status=pw_x86_cache_publish(&engine->cache,pc,&best,engine->cache.cursor,entry);
     if(status!=PW_OK) {
@@ -630,7 +647,7 @@ static int compile_block(PwX86Engine *engine,uint32_t pc,const PwX86CacheEntry *
         return status;
     }
     if(protection(engine,first,end-first,PW_PROT_READ|PW_PROT_EXEC)!=PW_OK) {
-        engine->failed=1;return PW_ERR_VM;
+        engine->failed=1;{ PW_VM_NOTE("pw_x86_engine.c:656"); return PW_ERR_VM; }
     }
 
     /* Initialize link slot stubs */
@@ -953,7 +970,21 @@ dispatch:;
     }
     engine->retired_instructions+=report->retired;
     if(invoked==PW_X86_REENCODE_HOST_STEP)return PW_ERR_UNSUPPORTED;
-    return invoked==PW_ERR_X87_TRAP?PW_ERR_X87_TRAP:invoked?PW_ERR_VM:PW_OK;
+    if(invoked && invoked!=PW_ERR_X87_TRAP) {
+        /* ⚠ DIAGNOSTIC. Running a translated block answers with its own
+         * status, and every value but these two collapses into PW_ERR_VM on the
+         * way out -- the same code the translator uses for a refused host
+         * allocation and for guest memory it cannot read. Keep the value. */
+#ifdef __PROSPERO__
+        {
+            static int left = 8;
+            if (left > 0) { left--; pw_wow_log( "wowprospero: invoke returned %d at guest eip %08x\n",
+                                                invoked, (unsigned)state->eip ); }
+        }
+#endif
+        { PW_VM_NOTE("pw_x86_engine.c:997"); return PW_ERR_VM; }
+    }
+    return invoked==PW_ERR_X87_TRAP?PW_ERR_X87_TRAP:PW_OK;
 }
 
 int pw_x86_execution_clock_batch(PwX86ExecutionClock clock, void *opaque, uint64_t *mean_ns)
@@ -963,10 +994,10 @@ int pw_x86_execution_clock_batch(PwX86ExecutionClock clock, void *opaque, uint64
     uint64_t means[8];
     for(unsigned i=0;i<8;i++) {
         uint64_t begin=clock(opaque),last=begin;
-        if(!begin)return PW_ERR_VM;
+        if(!begin){ PW_VM_NOTE("pw_x86_engine.c:1009"); return PW_ERR_VM; }
         for(unsigned read=0;read<1024;read++) {
             uint64_t now=clock(opaque);
-            if(!now || now<last)return PW_ERR_VM;
+            if(!now || now<last){ PW_VM_NOTE("pw_x86_engine.c:1012"); return PW_ERR_VM; }
             last=now;
         }
         uint64_t elapsed=last-begin;
@@ -1007,7 +1038,7 @@ int pw_x86_engine_reset(PwX86Engine *engine,uint32_t generation)
      * about to be poisoned need RW; unused reservations must stay uncommitted. */
     if(writable_bytes && (engine->sealed || engine->failed) &&
        protection(engine,0,writable_bytes,PW_PROT_READ|PW_PROT_WRITE)!=PW_OK)
-        return PW_ERR_VM;
+        { PW_VM_NOTE("pw_x86_engine.c:1053"); return PW_ERR_VM; }
 
     /* Count unlinks before cache entries are zeroed */
     for(uint32_t i=0; i<engine->cache.capacity; i++) {
diff --git a/wine/wowprospero/cpu.c b/wine/wowprospero/cpu.c
index 549dbd4..a64d382 100644
--- a/wine/wowprospero/cpu.c
+++ b/wine/wowprospero/cpu.c
@@ -527,7 +527,13 @@ void WINAPI BTCpuSimulate(void)
             raise_guest_exception( ctx, EXCEPTION_FLT_INVALID_OPERATION, 0, 0 );
             break;
         default:
-            ERR( "DBT error %d at eip %#lx\n", params.status, ctx->Eip );
+            /* ⚠ The address matters as much as the status: PW_ERR_VM is how
+             * the translator reports both a refused host allocation and guest
+             * memory it cannot read, and only the fault address tells them
+             * apart. */
+            ERR( "DBT error %d at eip %#lx, fault address %#lx%s\n", params.status,
+                 ctx->Eip, (unsigned long)params.fault_address,
+                 params.fault_write ? " (write)" : "" );
             /* End the process the way ExitProcess does: the other threads
              * first, which marks the process as exiting, so the call for
              * itself leaves through exit() and the host's exit handlers run
diff --git a/wine/wowprospero/unix.c b/wine/wowprospero/unix.c
index 01d21a5..560805c 100644
--- a/wine/wowprospero/unix.c
+++ b/wine/wowprospero/unix.c
@@ -43,6 +43,16 @@
 #include "call_top.h"
 #include "host_memory.h"
 
+/* ⚠ On the console this module's stderr goes nowhere: the sink ntdll installs
+ * is ntdll's own, and a PRX carries its own libc. Diagnostics go to klog
+ * instead. Off the console there is no klog and stderr is fine. */
+#ifdef __PROSPERO__
+extern void pw_wow_log( const char *format, ... );
+#define PW_WOW_NOTE( ... ) pw_wow_log( __VA_ARGS__ )
+#else
+#define PW_WOW_NOTE( ... ) fprintf( stderr, __VA_ARGS__ )
+#endif
+
 /* The guest range every translated access is checked against (load_state). */
 enum { GUEST_LOW = 0x10000u, GUEST_HIGH = 0xfffff000u };
 /* The guest GPRs held in host registers across linked blocks: seven fit, and
@@ -357,11 +367,22 @@ static void *place_above_guest( size_t bytes, ULONG type, ULONG protect )
     MEM_EXTENDED_PARAMETER parameter = { 0 };
     SIZE_T size = bytes;
     void *base = NULL;
+    NTSTATUS status;
 
     parameter.Type = MemExtendedParameterAddressRequirements;
     parameter.Pointer = &requirements;
-    if (NtAllocateVirtualMemoryEx( NtCurrentProcess(), &base, &size, type, protect, &parameter, 1 ))
+    if ((status = NtAllocateVirtualMemoryEx( NtCurrentProcess(), &base, &size, type,
+                                             protect, &parameter, 1 )))
+    {
+        /* ⚠ DIAGNOSTIC. The translator's code arena is the one allocation on
+         * this console that has to end up executable, and every refusal here
+         * reached the caller as a bare PW_ERR_VM -- "the memory backend refused
+         * a request" -- with no status, no size and no protection:
+         *     err:wow:BTCpuSimulate DBT error -9 at eip 0x7bf33290 */
+        PW_WOW_NOTE( "wowprospero: %zu bytes type %x protect %x refused: %08x\n",
+                     bytes, (unsigned int)type, (unsigned int)protect, (unsigned int)status );
         return NULL;
+    }
     return base;
 }
 
@@ -385,9 +406,18 @@ static void *reserve_code( size_t bytes )
 static int commit_code( void *base, size_t bytes )
 {
     SIZE_T size = bytes;
+    void *at = base;
+    NTSTATUS status;
 
-    return NtAllocateVirtualMemory( NtCurrentProcess(), &base, 0, &size, MEM_COMMIT,
-                                    PAGE_EXECUTE_READWRITE ) ? -1 : 0;
+    if (!(status = NtAllocateVirtualMemory( NtCurrentProcess(), &base, 0, &size, MEM_COMMIT,
+                                            PAGE_EXECUTE_READWRITE )))
+        return 0;
+    /* ⚠ DIAGNOSTIC -- see place_above_guest. Executable memory is the whole
+     * question here: this console refuses a plain executable mapping and wants
+     * direct memory mapped read-write and then protected (orbis_jit.c). */
+    PW_WOW_NOTE( "wowprospero: commit %p %zu bytes executable refused: %08x\n",
+                 at, bytes, (unsigned int)status );
+    return -1;
 }
 
 static void release( void *base, size_t bytes )
