From: Codex <codex@local>
Subject: build: allow PS4 Wine patch 0968

Allow the optional native WoW64 frame-pointer sampler patch to follow the
existing PS4 Wine patch series.

---
--- a/tools/build_wine_ps5.sh
+++ b/tools/build_wine_ps5.sh
@@ -153,7 +153,7 @@
     (cd "$ps5opengl_sdk" && sha256sum --status --check manifest.sha256) ||
     fail "PS5 OpenGL SDK does not match its SHA-256 manifest"
 
-# The series: NNNN-lower-case-name.patch, unique numbers through 0966, each a
+# The series: NNNN-lower-case-name.patch, unique numbers through 0968, each a
 # mail-formatted patch with a subject. Printed in the order it is applied.
 series() {
     [ -d "$patches" ] || fail "no patch directory $patches"
@@ -167,8 +167,8 @@
             fail "patch name must be NNNN-lower-case-words.patch: $patch"
         number=$(printf '%s' "$patch" | cut -c1-4 | sed 's/^0*//')
         number=${number:-0}
-        [ "$number" -ge 100 ] && [ "$number" -le 967 ] ||
-            fail "patch number outside 0100-0967: $patch"
+        [ "$number" -ge 100 ] && [ "$number" -le 968 ] ||
+            fail "patch number outside 0100-0968: $patch"
         [ "$number" -ne "$last" ] || fail "duplicate patch number: $patch"
         last=$number
         grep -q '^Subject: ' "$patches/$patch" || fail "patch has no Subject: $patch"
-- 
