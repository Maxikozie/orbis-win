From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Subject: [PATCH] profile/input: restore keyboard_stick, stick_deadzone and the
 stick direction keys

The upstream sync dropped the left-stick-to-keyboard feature entirely. Unlike
the eboot release, NO patch file captured it -- it existed only in the
gitignored prospero-win tree, so the merge overwrote it without a trace.
Recovered from prospero-win's own history at 8471db8 (the pre-sync PS4 work).

Symptom: Oblivion's buttons worked and its left stick did nothing. The profile
still parsed, because the interim fix for the diverged parsers had stripped the
two keys from the profile data rather than restoring the code.

Restored in four places:
  - src/pw_game_profile.h: keyboard_stick, stick_deadzone, stick_keys[4].
  - src/pw_game_profile.c: the keyboard_stick/stick_deadzone/stick_* keys,
    WASD defaults, deadzone 25, and the overlay merge.
  - native/pw_wine_display.{c,h}: pw_wine_keyboard_stick_step(), with the
    5-count hysteresis at the dead zone edge and release-before-press so a
    direction reversal cannot briefly hold both keys.
  - native/wine64_main.c: the per-frame step, the events array grown by 4, and
    a release path so held directions do not stick if the pad stops reporting.

WATCH THE SET MASK. Upstream took bit 4 for SET_PLAYER2, which is what
SET_KEYBOARD_STICK used before the sync; these are now bits 5 and 6. Replaying
the pre-sync patch verbatim would silently corrupt player2 handling.

Verified by parsing the real profile: keyboard_stick=left, deadzone=25,
stick W/S/A/D, and the D-pad to VK_UP/VK_DOWN/VK_LEFT/VK_RIGHT.

---
diff --git a/native/pw_wine_display.c b/native/pw_wine_display.c
index b9aaf81..e6a9609 100644
--- a/native/pw_wine_display.c
+++ b/native/pw_wine_display.c
@@ -95,6 +95,53 @@ size_t pw_wine_game_inputs(const PwGameInput *input, uint32_t pressed, uint32_t
     return add_edges(input, pressed, 1, out, used, max);
 }
 
+enum { KEY_STICK_UP = 1u << 0, KEY_STICK_DOWN = 1u << 1,
+       KEY_STICK_LEFT = 1u << 2, KEY_STICK_RIGHT = 1u << 3 };
+
+static int stick_direction(uint8_t value, int negative, int was_held, unsigned deadzone)
+{
+    /* Five raw stick counts of hysteresis keep a noisy axis from tapping the
+     * key repeatedly at the edge of its dead zone. */
+    int threshold = (int)(127u * deadzone / 100u);
+    int delta = (int)value - 128;
+    if (negative) return delta < -(threshold - (was_held ? 5 : 0));
+    return delta > threshold - (was_held ? 5 : 0);
+}
+
+size_t pw_wine_keyboard_stick_step(const PwGameInput *input, uint8_t stick_x, uint8_t stick_y,
+                                  int connected, PwWineKeyboardStick *state,
+                                  PwWineInput *out, size_t max)
+{
+    static const uint8_t bits[4] = { KEY_STICK_UP, KEY_STICK_DOWN, KEY_STICK_LEFT, KEY_STICK_RIGHT };
+    uint8_t wanted = 0, previous;
+    size_t used = 0;
+
+    if (!input || !state || !out) return 0;
+    previous = state->held;
+    if (connected && input->keyboard_stick != PW_GAME_STICK_NONE) {
+        if (stick_direction(stick_y, 1, !!(previous & KEY_STICK_UP), input->stick_deadzone))
+            wanted |= KEY_STICK_UP;
+        if (stick_direction(stick_y, 0, !!(previous & KEY_STICK_DOWN), input->stick_deadzone))
+            wanted |= KEY_STICK_DOWN;
+        if (stick_direction(stick_x, 1, !!(previous & KEY_STICK_LEFT), input->stick_deadzone))
+            wanted |= KEY_STICK_LEFT;
+        if (stick_direction(stick_x, 0, !!(previous & KEY_STICK_RIGHT), input->stick_deadzone))
+            wanted |= KEY_STICK_RIGHT;
+    }
+    /* Release first so a direct direction reversal cannot momentarily hold
+     * both keys. The caller reserves room for all four transitions. */
+    for (size_t i = 0; i < 4 && used < max; i++) {
+        if ((previous & bits[i]) && !(wanted & bits[i]))
+            out[used++] = (PwWineInput){ PW_WINE_INPUT_KEY, input->stick_keys[i], 0, 0, 0 };
+    }
+    for (size_t i = 0; i < 4 && used < max; i++) {
+        if (!(previous & bits[i]) && (wanted & bits[i]))
+            out[used++] = (PwWineInput){ PW_WINE_INPUT_KEY, input->stick_keys[i], 0, 0, 1 };
+    }
+    state->held = wanted;
+    return used;
+}
+
 static const struct { uint32_t dualsense; uint16_t xinput; } pad_buttons[] = {
     { 0x4000u, 0x1000u }, { 0x2000u, 0x2000u }, { 0x8000u, 0x4000u }, { 0x1000u, 0x8000u },
     { 0x400u, 0x0100u }, { 0x800u, 0x0200u }, { 0x2u, 0x0040u }, { 0x4u, 0x0080u },
diff --git a/native/pw_wine_display.h b/native/pw_wine_display.h
index c94a3e5..95f1630 100644
--- a/native/pw_wine_display.h
+++ b/native/pw_wine_display.h
@@ -52,6 +52,18 @@ int pw_wine_frame_box_take(PwWineFrameBox *box, uint64_t *seen, uint8_t *out,
 size_t pw_wine_game_inputs(const PwGameInput *input, uint32_t pressed, uint32_t released,
                            PwWineInput *out, size_t max);
 
+/* Digital key emulation for one analog stick. Direction bits are retained
+ * across frames so key-down is sent only on a threshold crossing, and every
+ * held direction is released when the controller disconnects.
+ *
+ * Restored 2026-10-28: the upstream sync removed this along with the
+ * keyboard_stick/stick_deadzone profile keys, which left Oblivion's left
+ * stick doing nothing while its buttons still worked. */
+typedef struct PwWineKeyboardStick { uint8_t held; } PwWineKeyboardStick;
+size_t pw_wine_keyboard_stick_step(const PwGameInput *input, uint8_t stick_x, uint8_t stick_y,
+                                  int connected, PwWineKeyboardStick *state,
+                                  PwWineInput *out, size_t max);
+
 /* The DualSense as an XInput gamepad: its held buttons (Cross A, Circle B,
  * Square X, Triangle Y, L1/R1 shoulders, L3/R3 thumbs, Options Start,
  * Create Back, a touchpad click Back on its left half and Guide on its
diff --git a/native/wine64_main.c b/native/wine64_main.c
index ecc4f3a..a92eebf 100644
--- a/native/wine64_main.c
+++ b/native/wine64_main.c
@@ -75,6 +75,19 @@
  * src/prospero-win-patches-ps4/0026-wine64-report-gnm-submit-done.patch,
  * dropped by the 2026-10-28 upstream merge. */
 extern int32_t sceGnmSubmitDone(void);
+#ifdef PW_RELOCATABLE_WINE
+/* Present only in the relocatable PRX build. Keep the eboot image mapped
+ * through Sony display/input setup, then release its low range immediately
+ * before Wine starts the selected Windows process.
+ *
+ * Restored 2026-10-28: the upstream sync dropped this, so the eboot stayed
