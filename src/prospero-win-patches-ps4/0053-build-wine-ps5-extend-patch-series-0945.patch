From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] build: accept PS4 Wine patch 0945

Allow the corrected Orbis privileged-instruction classification and opcode
diagnostic patch.

---
--- a/tools/build_wine_ps5.sh
+++ b/tools/build_wine_ps5.sh
@@ -153,7 +153,7 @@
     (cd "$ps5opengl_sdk" && sha256sum --status --check manifest.sha256) ||
     fail "PS5 OpenGL SDK does not match its SHA-256 manifest"
 
-# The series: NNNN-lower-case-name.patch, unique numbers through 0933, each a
+# The series: NNNN-lower-case-name.patch, unique numbers through 0945, each a
 # mail-formatted patch with a subject. Printed in the order it is applied.
 series() {
     [ -d "$patches" ] || fail "no patch directory $patches"
@@ -167,8 +167,8 @@
             fail "patch name must be NNNN-lower-case-words.patch: $patch"
         number=$(printf '%s' "$patch" | cut -c1-4 | sed 's/^0*//')
         number=${number:-0}
-        [ "$number" -ge 100 ] && [ "$number" -le 944 ] ||
-            fail "patch number outside 0100-0944: $patch"
+        [ "$number" -ge 100 ] && [ "$number" -le 945 ] ||
+            fail "patch number outside 0100-0945: $patch"
         [ "$number" -ne "$last" ] || fail "duplicate patch number: $patch"
         last=$number
         grep -q '^Subject: ' "$patches/$patch" || fail "patch has no Subject: $patch"
-- 
2.43.0
