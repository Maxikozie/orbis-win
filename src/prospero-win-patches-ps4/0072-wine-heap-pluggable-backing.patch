From: Codex <codex@localhost>
Subject: [PATCH] wine: support direct-memory backing for the Unix heap

Allow the Wine Unix heap to use a platform-provided mapping for spans and
large allocations while retaining anonymous mmap as its fallback. Add a host
test for owned unmapping and fallback behavior.

---
diff --git a/tests/test_pw_wine_heap.c b/tests/test_pw_wine_heap.c
index 598469d..b44c10e 100644
--- a/tests/test_pw_wine_heap.c
+++ b/tests/test_pw_wine_heap.c
@@ -7,6 +7,32 @@
 
 enum { THREADS=8,ROUNDS=20000 };
 
+typedef struct FakeBacking {
+    void *address;
+    unsigned maps, unmaps;
+    int refuse;
+} FakeBacking;
+
+static void *fake_map(void *context,size_t bytes)
+{
+    FakeBacking *backing=context;
+    backing->maps++;
+    if(backing->refuse)return NULL;
+    backing->address=malloc(bytes);
+    return backing->address;
+}
+
+static int fake_unmap(void *context,void *address,size_t bytes)
+{
+    FakeBacking *backing=context;
+    (void)bytes;
+    if(address!=backing->address)return 1;
+    free(address);
+    backing->address=NULL;
+    backing->unmaps++;
+    return 0;
+}
+
 static void *worker(void *seed_pointer)
 {
     unsigned seed=(unsigned)(uintptr_t)seed_pointer;void *live[64]={0};size_t sizes[64]={0};
@@ -105,5 +131,20 @@ int main(void)
     for(unsigned t=0;t<THREADS;t++)assert(!pthread_join(threads[t],NULL));
     pw_wine_heap_stats(&s);
     assert(s.live_bytes==0 && !s.large_live && s.allocations==s.frees && s.peak_live_bytes>1000000);
+    /* Backing allocations are paired with their own unmap callback; refusing
+     * a later allocation falls back to anonymous mmap and munmap. */
+    FakeBacking fake={0};
+    PwWineHeapBacking callbacks={&fake,fake_map,fake_unmap};
+    pw_wine_heap_set_backing(&callbacks);
+    void *backed=pw_wine_heap_malloc(200000);
+    assert(backed && fake.maps==1 && fake.address);
+    pw_wine_heap_free(backed);
+    assert(fake.unmaps==1 && !fake.address);
+    fake.refuse=1;
+    void *fallback=pw_wine_heap_malloc(200000);
+    assert(fallback && fake.maps==2);
+    pw_wine_heap_free(fallback);
+    assert(fake.unmaps==1 && !fake.address);
+    pw_wine_heap_set_backing(NULL);
     return 0;
 }
diff --git a/wine/ps5/pw_wine_heap.c b/wine/ps5/pw_wine_heap.c
index c677631..ca9d6fe 100644
--- a/wine/ps5/pw_wine_heap.c
+++ b/wine/ps5/pw_wine_heap.c
@@ -35,12 +35,26 @@ static uint8_t *carve,*carve_end;
 static void *larges[MAX_LARGE];
 static uint32_t large_count;
 static PwWineHeapStats stats;
+static PwWineHeapBacking backing;
 
 static void *map(size_t bytes)
 {
-    void *p=mmap(NULL,bytes,PROT_READ|PROT_WRITE,MAP_PRIVATE|MAP_ANONYMOUS,-1,0);
+    void *p=backing.map?backing.map(backing.context,bytes):NULL;
+    if(p)return p;
+    p=mmap(NULL,bytes,PROT_READ|PROT_WRITE,MAP_PRIVATE|MAP_ANONYMOUS,-1,0);
     return p==MAP_FAILED?NULL:p;
 }
+static void unmap(void *address,size_t bytes)
+{
+    if(backing.unmap&&!backing.unmap(backing.context,address,bytes))return;
+    (void)munmap(address,bytes);
+}
+void pw_wine_heap_set_backing(const PwWineHeapBacking *value)
+{
+    pthread_mutex_lock(&lock);
+    if(value)backing=*value;else memset(&backing,0,sizeof(backing));
+    pthread_mutex_unlock(&lock);
+}
 static void note_mapped(int64_t delta)
 {
     stats.mapped_bytes+=(uint64_t)delta;
@@ -142,7 +156,7 @@ static void release(Header *header)
         LargeHeader *large=(LargeHeader *)header-1;uint64_t mapped=large->mapped;
         uint32_t slot=large_slot(header+1);
         memmove(&larges[slot],&larges[slot+1],(large_count-slot-1)*sizeof(larges[0]));
-        large_count--;header->magic=0;(void)munmap(large,mapped);note_mapped(-(int64_t)mapped);stats.large_live--;
+        large_count--;header->magic=0;unmap(large,mapped);note_mapped(-(int64_t)mapped);stats.large_live--;
     }
 }
 static Header *owned(const void *pointer)
diff --git a/wine/ps5/pw_wine_heap.h b/wine/ps5/pw_wine_heap.h
index a174297..2f952ee 100644
--- a/wine/ps5/pw_wine_heap.h
+++ b/wine/ps5/pw_wine_heap.h
@@ -26,4 +26,15 @@ void *pw_wine_heap_memalign(size_t alignment,size_t bytes);
 size_t pw_wine_heap_usable_size(const void *pointer);
 void pw_wine_heap_stats(PwWineHeapStats *stats);
 
+/* Optional backing for new spans and large blocks. map may refuse so the
+ * heap can fall back to anonymous mappings. unmap returns 0 when it handled
+ * the address, nonzero when the address belongs to the fallback mmap path.
+ * Both callbacks run with the heap mutex held and must not allocate here. */
+typedef struct PwWineHeapBacking {
+    void *context;
+    void *(*map)(void *context, size_t bytes);
+    int (*unmap)(void *context, void *address, size_t bytes);
+} PwWineHeapBacking;
+void pw_wine_heap_set_backing(const PwWineHeapBacking *backing);
+
 #endif
