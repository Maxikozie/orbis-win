From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] build: accept PS4 Wine patch 0935

The PS4 Wine queue now explicitly applies executable host protection after
executable mappings. Extend the local ordered-patch limit by one.

diff --git a/tools/build_wine_ps5.sh b/tools/build_wine_ps5.sh
index 0000000..0000000 100755
--- a/tools/build_wine_ps5.sh
+++ b/tools/build_wine_ps5.sh
@@ -168,7 +168,7 @@ series() {
         number=$(printf '%s' "$patch" | cut -c1-4 | sed 's/^0*//')
         number=${number:-0}
-        [ "$number" -ge 100 ] && [ "$number" -le 934 ] ||
-            fail "patch number outside 0100-0934: $patch"
+        [ "$number" -ge 100 ] && [ "$number" -le 935 ] ||
+            fail "patch number outside 0100-0935: $patch"
         [ "$number" -ne "$last" ] || fail "duplicate patch number: $patch"
         last=$number
         grep -q '^Subject: ' "$patches/$patch" || fail "patch has no Subject: $patch"
-- 
2.43.0
