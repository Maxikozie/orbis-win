From: Codex <codex@local>
Subject: [PATCH] wow64native: sample guest PCs at native dispatch boundaries

The dispatched-call-ID samples were zero for every thread in the stalled GTA
IV startup capture, despite tens of millions of counted transitions. Sample
the guest EIP already saved in the WOW64 CPU context instead. This is a
signal-free sample of the instruction that entered each syscall or Unix-call
thunk, and lets the next capture distinguish a hot guest call site from a
Wine transition loop.

---
--- a/wine/wow64native/cpu.c
+++ b/wine/wow64native/cpu.c
@@ -403,7 +403,10 @@
                    "movl %edx,0xc0(%r13)\n\t"   /* context->EFlags */
                    "leaq 4(%r14),%rdx\n\t"
                    "movl %edx,0xc4(%r13)\n\t"   /* context->Esp */
-                   PW_PROFILE_ENTRY("40", "72", "movl 16(%rsp),%ecx\n\t")
+                   /* Record the 32-bit guest instruction that entered the
+                    * syscall thunk. RAX is not a reliable syscall ID at
+                    * this boundary on every WOW64 dispatch path. */
+                   PW_PROFILE_ENTRY("40", "72", "movl 0xb8(%r13),%ecx\n\t")
                    "call pw_native_restore_host_fs\n\t"
                    "movq %rax,%rcx\n\t"         /* syscall number */
                    "leaq 8(%r14),%rdx\n\t"      /* parameters */
@@ -473,7 +476,10 @@
                    "movl %edx,0xbc(%r13)\n\t"   /* context->SegCs */
                    "leaq 20(%r14),%rdx\n\t"
                    "movl %edx,0xc4(%r13)\n\t"   /* context->Esp */
-                   PW_PROFILE_ENTRY("32", "328", "movl 4(%r14),%ecx\n\tshll $16,%ecx\n\torl 12(%r14),%ecx\n\t")
+                   /* Use the saved guest EIP here too; the unix-call handle
+                    * and ordinal are not consistently available before the
+                    * host FS transition. */
+                   PW_PROFILE_ENTRY("32", "328", "movl 0xb8(%r13),%ecx\n\t")
                    "call pw_native_restore_host_fs\n\t"
                    "movq 4(%r14),%rcx\n\t"      /* handle */
                    "movl 12(%r14),%edx\n\t"     /* code */
--- a/wine/wow64native/unix.c
+++ b/wine/wow64native/unix.c
@@ -97,7 +97,7 @@
     if (!p) return;
     sys_end = (unsigned int)(syscall_calls >> PW_NATIVE_PROFILE_SAMPLE_SHIFT);
     unix_end = (unsigned int)(unix_calls >> PW_NATIVE_PROFILE_SAMPLE_SHIFT);
-    WINE_MESSAGE("PW_NATIVE_CALL_IDS teb=%llx syscall=%x,%x,%x,%x,%x,%x,%x,%x,%x,%x,%x,%x,%x,%x,%x,%x unix=%x,%x,%x,%x,%x,%x,%x,%x,%x,%x,%x,%x,%x,%x,%x,%x\n",
+    WINE_MESSAGE("PW_NATIVE_GUEST_PC teb=%llx syscall=%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x unix=%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x\n",
                  state->guest_fs,
                  p->syscall_samples[(sys_end - 0) & 63], p->syscall_samples[(sys_end - 1) & 63],
                  p->syscall_samples[(sys_end - 2) & 63], p->syscall_samples[(sys_end - 3) & 63],
@@ -293,7 +293,7 @@
          * fixed; ordinary CPU-time and transition counters need no signal. */
         profile_pc_enabled = (caps & 0x20u) && profile_pc_query &&
                              getenv("PW_NATIVE_PC") && !strcmp(getenv("PW_NATIVE_PC"), "1");
-        WINE_MESSAGE("PW_NATIVE_STAGE process_init caps=%x required=%x\n",
+        WINE_MESSAGE("PW_NATIVE_STAGE process_init caps=%08x required=%08x\n",
                      caps, PW_NW64_CAP_REQUIRED);
         WINE_MESSAGE("PW_NATIVE_STAGE process_init pc_sampler=%d query=%p\n",
                      profile_pc_enabled, profile_pc_query);
@@ -320,7 +320,7 @@
 {
     struct pw_native_thread_params *params = args;
     NTSTATUS status;
-    WINE_MESSAGE("PW_NATIVE_STAGE thread_init enter args=%p version=%u expected=%u teb=%x initialized=%d\n",
+    WINE_MESSAGE("PW_NATIVE_STAGE thread_init enter args=%p version=%u expected=%u teb=%08x initialized=%d\n",
                  args, params ? params->version : 0, PW_NATIVE_ABI_VERSION,
