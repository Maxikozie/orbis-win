From: Codex <codex@local>
Subject: wow64native: sample caller above syscall wrapper

Capture the guest frame return address above the ntdll syscall wrapper, with a conservative same-stack range check. Label the field as caller; zero it when EBP is absent or outside the nearby guest stack.

---
--- a/wine/wow64native/cpu.c
+++ b/wine/wow64native/cpu.c
@@ -411,8 +411,24 @@
                    PW_PROFILE_ENTRY("40", "840",
                                     "movl 0xb8(%r13),%ecx\n\t"
                                     "movl %ecx,72(%rax,%rdx,4)\n\t"
-                                    "movl 4(%r14),%ecx\n\t"
-                                    "movl %ecx,584(%rax,%rdx,4)\n\t"
+                                    /* Follow the current EBP frame one level
+                                     * above the syscall wrapper. Only read a
+                                     * nearby frame on the current guest stack. */
+                                    "movl 0xb4(%r13),%ecx\n\t"
+                                    "testl %ecx,%ecx\n\t"
+                                    "jz 8f\n\t"
+                                    "movl 0xc4(%r13),%esi\n\t"
+                                    "cmpl %esi,%ecx\n\t"
+                                    "jb 8f\n\t"
+                                    "movl %ecx,%esi\n\t"
+                                    "subl 0xc4(%r13),%esi\n\t"
+                                    "cmpl $0x4000,%esi\n\t"
+                                    "ja 8f\n\t"
+                                    "movl 4(%ecx),%ecx\n\t"
+                                    "jmp 7f\n\t"
+                                    "8:\n\t"
+                                    "xorl %ecx,%ecx\n\t"
+                                    "7:\n\t"
                                     "movl %ecx,584(%rax,%rdx,4)\n\t"
                                     "movl 16(%rsp),%ecx\n\t")
                    "call pw_native_restore_host_fs\n\t"
--- a/wine/wow64native/unix.c
+++ b/wine/wow64native/unix.c
@@ -95,7 +95,7 @@
     unsigned int end;
     if (!p) return;
     end = (unsigned int)(syscall_calls >> PW_NATIVE_PROFILE_SAMPLE_SHIFT);
-    WINE_MESSAGE("PW_NATIVE_ACTIVE_SYSCALLS teb=%llx calls=%llu pc=%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x arg1=%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x id=%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x\n",
+    WINE_MESSAGE("PW_NATIVE_ACTIVE_SYSCALLS teb=%llx calls=%llu pc=%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x caller=%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x id=%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x\n",
                  state->guest_fs, syscall_calls,
                  p->syscall_samples[(end - 0) & 63], p->syscall_samples[(end - 1) & 63],
                  p->syscall_samples[(end - 2) & 63], p->syscall_samples[(end - 3) & 63],
--- a/wine/wow64native/wow64native.h
+++ b/wine/wow64native/wow64native.h
@@ -46,8 +46,8 @@
     /* A 64-entry rolling sample of every 1024th dispatched call. */
     unsigned int syscall_samples[PW_NATIVE_PROFILE_SAMPLE_COUNT];
     unsigned int unix_samples[PW_NATIVE_PROFILE_SAMPLE_COUNT];
-    /* Guest return addresses for sampled syscall stubs, parallel to
-     * syscall_samples. */
+    /* One-frame-up guest return addresses for sampled syscalls, parallel to
+     * syscall_samples; zero when EBP is not a nearby guest stack frame. */
     unsigned int syscall_caller_samples[PW_NATIVE_PROFILE_SAMPLE_COUNT];
     /* Native syscall numbers parallel to sampled guest syscall PCs. */
     unsigned int syscall_id_samples[PW_NATIVE_PROFILE_SAMPLE_COUNT];
