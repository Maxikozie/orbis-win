From: Codex <codex@local>
Subject: wow64native: report native syscall return addresses

The PC sampler found a hot libkernel syscall path, but its current EBP
walker only understands 32-bit guest frames. Include the captured 64-bit
stack-top word in the existing opt-in sample so syscall callers can be
mapped back to their Wine module and call site.

---
--- a/wine/wow64native/unix.c
+++ b/wine/wow64native/unix.c
@@ -57,7 +57,8 @@
                                            unsigned long long *, unsigned long long *,
                                            unsigned long long *, unsigned long long *,
                                            unsigned long long *, unsigned long long *,
-                                           unsigned long long *, unsigned long long *);
+                                           unsigned long long *, unsigned long long *,
+                                           unsigned long long *);
 static pw_native_pc_query profile_pc_query;
 static int profile_pc_enabled;
 static pthread_mutex_t profile_watch_lock = PTHREAD_MUTEX_INITIALIZER;
@@ -154,11 +155,11 @@
             if (profile_pc_enabled && cpu_delta_ns > 100000000ull)
             {
                 unsigned long long before = 0, sequence = 0, rip = 0, rsp = 0, cs = 0;
-                unsigned long long rax = 0, rdi = 0, rsi = 0, rdx = 0, r10 = 0, rbp = 0;
+                unsigned long long rax = 0, rdi = 0, rsi = 0, rdx = 0, r10 = 0, rbp = 0, rsp0 = 0;
                 unsigned int frames[8] = {0};
                 unsigned int frame_count = 0;
                 int rc;
-                profile_pc_query(&before, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL);
+                profile_pc_query(&before, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL);
                 rc = pthread_kill(entry->native_thread, SIGPROF);
                 if (!rc)
                 {
                     struct timespec pause = {0, 1000000};
                     for (unsigned int attempt = 0; attempt < 50; ++attempt)
                     {
                         nanosleep(&pause, NULL);
-                        profile_pc_query(&sequence, &rip, &rsp, &cs, &rax, &rdi, &rsi, &rdx, &r10, &rbp);
+                        profile_pc_query(&sequence, &rip, &rsp, &cs, &rax, &rdi, &rsi, &rdx, &r10, &rbp, &rsp0);
                         if (sequence != before) break;
                     }
                     /* Walk at most four conventional 32-bit EBP frames. The
@@ -192,8 +193,8 @@
                             frame = previous;
                         }
                     }
-                    WINE_MESSAGE("PW_NATIVE_PC teb=%llx seq=%llu rip=%llx rsp=%llx rbp=%llx ret=%08x frames=%u[%08x/%08x,%08x/%08x,%08x/%08x,%08x/%08x] cs=%llx rax=%llx rdi=%llx rsi=%llx rdx=%llx r10=%llx sample=%s\n",
-                                 entry->state->guest_fs, sequence, rip, rsp, rbp, frames[1], frame_count,
+                    WINE_MESSAGE("PW_NATIVE_PC teb=%llx seq=%llu rip=%llx rsp=%llx rsp0=%llx rbp=%llx ret=%08x frames=%u[%08x/%08x,%08x/%08x,%08x/%08x,%08x/%08x] cs=%llx rax=%llx rdi=%llx rsi=%llx rdx=%llx r10=%llx sample=%s\n",
+                                 entry->state->guest_fs, sequence, rip, rsp, rsp0, rbp, frames[1], frame_count,
                                  frames[0], frames[1], frames[2], frames[3], frames[4], frames[5],
                                  frames[6], frames[7], cs,
                                  rax, rdi, rsi, rdx, r10,
