From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Subject: [PATCH] wow64native: add PS4 low-TCB bridge and live diagnostics

The PS4 libkernel signal trampoline reads a thread-control block through the
qword at the 32-bit TEB's FS:0x10. A high pointer overlaps both FiberData and
ArbitraryUserPointer. Hardware tests show that a writable TCB below 4 GiB
works when its pointer is stored in FiberData and the upper field stays zero.
Install a zeroed low mapping per native WOW64 thread, save the prior
non-fiber FiberData sentinel, and restore it when the thread exits. Log each
process/thread initialization stage and sample transition counters from a
low-rate host thread, including when the guest stalls without returning to
Wine.

This remains experimental: applications that convert or switch fibers can
replace FiberData while the native backend is active and need separate testing.
diff --git a/wine/wow64native/cpu.c b/wine/wow64native/cpu.c
index 87cb97c..d2ae329 100644
--- a/wine/wow64native/cpu.c
+++ b/wine/wow64native/cpu.c
@@ -527,6 +527,8 @@ static NTSTATUS process_init(void)
     NTSTATUS (WINAPI **p__wine_unix_call_dispatcher)( unixlib_handle_t, unsigned int, void * );
     WOW64INFO *wow64info = NtCurrentTeb()->TlsSlots[WOW64_TLS_WOW64INFO];
 
+    WINE_MESSAGE( "ORBW00029 native diag: process_init entered\n" );
+
     if ((ULONG_PTR)syscall_32to64 >> 32 || (ULONG_PTR)unix_call_32to64 >> 32 ||
         (ULONG_PTR)code_buffer > 0x100000000ULL - sizeof(code_buffer))
     {
@@ -538,19 +540,36 @@ static NTSTATUS process_init(void)
      * not enter compatibility mode until its TLS/signal transition layer
      * has explicitly completed initialization. */
     status = init_xstate();
+    WINE_MESSAGE( "ORBW00029 native diag: xstate status=%08x avx=%u\n", (unsigned int)status, pw_native_avx );
     if (status) return status;
     status = WINE_UNIX_CALL( pw_native_process_init, &native );
+    WINE_MESSAGE( "ORBW00029 native diag: unix init status=%08x ready=%u fs_set=%p fs32=%04x\n",
+                  (unsigned int)status, native.transitions_ready,
+                  (void *)(ULONG_PTR)native.fs_set_proc, native.fs32_selector );
     if (status) return status;
-    if (!native.transitions_ready) return STATUS_NOT_SUPPORTED;
-    if (!native.fs_set_proc) return STATUS_ENTRYPOINT_NOT_FOUND;
+    if (!native.transitions_ready)
+    {
+        WINE_MESSAGE( "ORBW00029 native diag: transitions not ready\n" );
+        return STATUS_NOT_SUPPORTED;
+    }
+    if (!native.fs_set_proc)
+    {
+        WINE_MESSAGE( "ORBW00029 native diag: sysarch entry missing\n" );
+        return STATUS_ENTRYPOINT_NOT_FOUND;
+    }
     pw_native_sysarch = (void *)(ULONG_PTR)native.fs_set_proc;
 
     LdrGetDllHandle( NULL, 0, &str, &module );
     p__wine_unix_call_dispatcher = RtlFindExportedRoutineByName( module, "__wine_unix_call_dispatcher" );
-    if (!p__wine_unix_call_dispatcher) return STATUS_ENTRYPOINT_NOT_FOUND;
+    if (!p__wine_unix_call_dispatcher)
+    {
+        WINE_MESSAGE( "ORBW00029 native diag: unix dispatcher export missing\n" );
+        return STATUS_ENTRYPOINT_NOT_FOUND;
+    }
     __wine_unix_call_dispatcher = *p__wine_unix_call_dispatcher;
 
     RtlCaptureContext( &context );
+    WINE_MESSAGE( "ORBW00029 native diag: host context cs=%04x\n", context.SegCs );
     if (context.SegCs != PW_NATIVE_CS64) return STATUS_NOT_SUPPORTED;
 
     /* Do not obtain compatibility selectors from a 64-bit thread context. */
@@ -573,6 +592,7 @@ static NTSTATUS process_init(void)
     thunk->unix_thunk.cs    = cs64_sel;
 
     status = NtProtectVirtualMemory( GetCurrentProcess(), (void **)&thunk, &size, PAGE_EXECUTE_READ, &old_prot );
+    WINE_MESSAGE( "ORBW00029 native diag: protect status=%08x thunk=%p\n", (unsigned int)status, thunk );
     if (status) return status;
     wow64info->CpuFlags |= WOW64_CPUFLAGS_MSFT64;
     WINE_MESSAGE( "wow64native initialized: cs32=%04x ss32=%04x cs64=%04x avx=%u\n",
@@ -584,7 +604,9 @@ static NTSTATUS process_init(void)
 NTSTATUS WINAPI BTCpuProcessInit(void)
 {
     /* The pinned Wine caller ignores this status; Simulate enforces it. */
+    WINE_MESSAGE( "ORBW00029 native diag: BTCpuProcessInit entered\n" );
     process_status = process_init();
+    WINE_MESSAGE( "ORBW00029 native diag: BTCpuProcessInit status=%08x\n", (unsigned int)process_status );
     return process_status;
 }
 
@@ -617,6 +639,7 @@ void * WINAPI pw_native_prepare_simulate(void)
     if (status)
     {
         /* Do not dispatch a guest exception through uninitialized BOP code. */
+        WINE_MESSAGE( "ORBW00029 native diag: prepare_simulate terminating status=%08x\n", (unsigned int)status );
         NtTerminateProcess(GetCurrentProcess(), status);
         RtlRaiseStatus(status);
     }
diff --git a/wine/wow64native/unix.c b/wine/wow64native/unix.c
index c6ed5d4..a5d5386 100644
--- a/wine/wow64native/unix.c
+++ b/wine/wow64native/unix.c
@@ -9,26 +9,97 @@
 #include "wine/debug.h"
 #include <stdlib.h>
 #include <string.h>
+#ifdef __PROSPERO__
+#include <errno.h>
+#include <stdint.h>
+#include <sys/mman.h>
+#endif
 
 WINE_DEFAULT_DEBUG_CHANNEL(wow);
 #ifdef __PROSPERO__
 #include <dlfcn.h>
+#include <pthread.h>
+#include <unistd.h>
 #endif
 
 static __thread struct pw_native_thread_state thread_state;
 static __thread int thread_initialized;
+#ifdef __PROSPERO__
+/* libkernel's compat signal trampoline reads a host signal TCB through the
+ * qword at guest TEB32.FiberData/ArbitraryUserPointer (FS:0x10). Keep the
+ * upper ArbitraryUserPointer dword untouched by placing the shim below 4 GiB
+ * and using FiberData's existing non-fiber sentinel offset. */
+static __thread void *signal_tcb_page;
+static __thread ULONG saved_fiber_data;
+static __thread ULONG signal_tcb_fiber_data;
+#endif
 static int process_ready;
 static int profile_enabled;
 static __thread struct pw_native_profile thread_profile;
+#ifdef __PROSPERO__
+/* The test title can sit in guest code forever, so BTCpuThreadTerm is not a
+ * reliable place to collect counters. A low-rate host thread samples the
+ * first native thread's profile while it is still alive. */
+static pthread_mutex_t profile_watch_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct pw_native_thread_state *profile_watch_state;
+static pthread_t profile_watch_thread;
+static volatile int profile_watch_started;
+static volatile int profile_watch_stop;
+#endif
 static void profile_report(void *arg)
 {
     const struct pw_native_thread_state *state = arg;
     const struct pw_native_profile *p = (void *)state->profile;
+    unsigned long long host_calls, guest_calls, host_ticks, guest_ticks;
+    unsigned long long unix_calls, syscall_calls, last_tsc;
     if (!p) return;
+    host_calls = __atomic_load_n(&p->host_calls, __ATOMIC_RELAXED);
+    guest_calls = __atomic_load_n(&p->guest_calls, __ATOMIC_RELAXED);
+    host_ticks = __atomic_load_n(&p->host_sysarch_ticks, __ATOMIC_RELAXED);
+    guest_ticks = __atomic_load_n(&p->guest_sysarch_ticks, __ATOMIC_RELAXED);
+    unix_calls = __atomic_load_n(&p->unix_calls, __ATOMIC_RELAXED);
+    syscall_calls = __atomic_load_n(&p->syscall_calls, __ATOMIC_RELAXED);
+    last_tsc = __atomic_load_n(&p->last_tsc, __ATOMIC_RELAXED);
     WINE_MESSAGE("PW_NATIVE_PROFILE version=1 teb=%llx tsc=%llu host_calls=%llu guest_calls=%llu host_sysarch_ticks=%llu guest_sysarch_ticks=%llu unix_calls=%llu syscall_calls=%llu\n",
-                 state->guest_fs, p->last_tsc, p->host_calls, p->guest_calls,
-                 p->host_sysarch_ticks, p->guest_sysarch_ticks, p->unix_calls, p->syscall_calls);
+                 state->guest_fs, last_tsc, host_calls, guest_calls,
+                 host_ticks, guest_ticks, unix_calls, syscall_calls);
+}
+
+#ifdef __PROSPERO__
+static void *profile_watch_main(void *unused)
+{
+    (void)unused;
+    while (!__atomic_load_n(&profile_watch_stop, __ATOMIC_RELAXED))
+    {
+        sleep(2);
+        pthread_mutex_lock(&profile_watch_lock);
+        if (profile_watch_state) profile_report(profile_watch_state);
+        pthread_mutex_unlock(&profile_watch_lock);
+    }
+    return NULL;
+}
+
+static void profile_watch_start(struct pw_native_thread_state *state)
+{
+    int expected = 0;
+    if (!__atomic_compare_exchange_n(&profile_watch_started, &expected, 1, 0,
+                                    __ATOMIC_RELAXED, __ATOMIC_RELAXED)) return;
+    pthread_mutex_lock(&profile_watch_lock);
+    profile_watch_state = state;
+    pthread_mutex_unlock(&profile_watch_lock);
+    if (pthread_create(&profile_watch_thread, NULL, profile_watch_main, NULL))
+    {
+        pthread_mutex_lock(&profile_watch_lock);
+        profile_watch_state = NULL;
+        pthread_mutex_unlock(&profile_watch_lock);
+        __atomic_store_n(&profile_watch_started, 0, __ATOMIC_RELAXED);
+        WINE_MESSAGE("PW_NATIVE_PROFILE watcher-start failed\n");
+        return;
+    }
+    pthread_detach(profile_watch_thread);
+    WINE_MESSAGE("PW_NATIVE_PROFILE watcher-start interval=2s teb=%llx\n", state->guest_fs);
 }
+#endif
 
 static NTSTATUS capture_host_fs(unsigned long long *base)
 {
@@ -50,10 +121,16 @@ static NTSTATUS capture_host_fs(unsigned long long *base)
 static NTSTATUS process_init(void *args)
 {
     struct pw_native_init_params *params = args;
+    WINE_MESSAGE("PW_NATIVE_STAGE process_init enter args=%p version=%u expected=%u\n",
+                 args, params ? params->version : 0, PW_NATIVE_ABI_VERSION);
     process_ready = 0;
     profile_enabled = 0;
     if (!params || params->version != PW_NATIVE_ABI_VERSION)
+    {
+        WINE_MESSAGE("PW_NATIVE_STAGE process_init reject params=%p version=%u\n",
+                     args, params ? params->version : 0);
         return STATUS_INVALID_PARAMETER;
+    }
     params->transitions_ready = 0;
     params->fs32_selector = 0;
     params->fs_set_proc = 0;
@@ -65,17 +142,28 @@ static NTSTATUS process_init(void *args)
         /* Resolve through ntdll's Wine dl facade: this optional export is
          * absent in older runtimes, which must keep the backend disabled. */
         query = dlsym(RTLD_DEFAULT, PW_NATIVE_SIGNAL_QUERY);
-        if (!query) return STATUS_NOT_SUPPORTED;
+        WINE_MESSAGE("PW_NATIVE_STAGE process_init query=%p\n", query);
+        if (!query)
+        {
+            WINE_MESSAGE("PW_NATIVE_STAGE process_init missing-query\n");
+            return STATUS_NOT_SUPPORTED;
+        }
         caps = query(PW_NW64_CAPS_VERSION);
+        WINE_MESSAGE("PW_NATIVE_STAGE process_init caps=%08x required=%08x\n",
+                     caps, PW_NW64_CAP_REQUIRED);
         if ((caps & PW_NW64_CAP_REQUIRED) != PW_NW64_CAP_REQUIRED)
+        {
+            WINE_MESSAGE("PW_NATIVE_STAGE process_init insufficient-caps\n");
             return STATUS_NOT_SUPPORTED;
+        }
         params->fs_set_proc = (unsigned long long)sysarch;
         params->transitions_ready = 1;
         process_ready = 1;
-        {
-            const char *value = getenv("PW_NATIVE_PROFILE");
-            profile_enabled = value && !strcmp(value, "1");
-        }
+        /* ORBW00040 diagnostic build: collect FS-transition counters and
+         * report them periodically and when the native thread exits. */
+        profile_enabled = 1;
+        WINE_MESSAGE("PW_NATIVE_STAGE process_init ready fs_set_proc=%p profile=%d\n",
+                     (void *)(ULONG_PTR)params->fs_set_proc, profile_enabled);
         return STATUS_SUCCESS;
     }
 #endif
@@ -86,19 +174,65 @@ static NTSTATUS thread_init(void *args)
 {
     struct pw_native_thread_params *params = args;
     NTSTATUS status;
-    if (!params || params->version != PW_NATIVE_ABI_VERSION) return STATUS_INVALID_PARAMETER;
+    WINE_MESSAGE("PW_NATIVE_STAGE thread_init enter args=%p version=%u expected=%u teb=%08x initialized=%d\n",
+                 args, params ? params->version : 0, PW_NATIVE_ABI_VERSION,
+                 params ? (unsigned)params->guest_teb : 0, thread_initialized);
+    if (!params || params->version != PW_NATIVE_ABI_VERSION)
+    {
+        WINE_MESSAGE("PW_NATIVE_STAGE thread_init reject params=%p version=%u\n",
+                     args, params ? params->version : 0);
+        return STATUS_INVALID_PARAMETER;
+    }
     params->state = 0;
     if (params->guest_teb < 0x10000 || params->guest_teb > 0xfffff000)
+    {
+        WINE_MESSAGE("PW_NATIVE_STAGE thread_init invalid-teb teb=%08x\n",
+                     (unsigned)params->guest_teb);
         return STATUS_INVALID_ADDRESS;
+    }
     if (thread_initialized)
     {
-        if (thread_state.guest_fs != params->guest_teb) return STATUS_INVALID_PARAMETER;
+        if (thread_state.guest_fs != params->guest_teb)
+        {
+            WINE_MESSAGE("PW_NATIVE_STAGE thread_init teb-mismatch old=%llx new=%llx\n",
+                         thread_state.guest_fs, params->guest_teb);
+            return STATUS_INVALID_PARAMETER;
+        }
         thread_state.status = process_ready ? STATUS_SUCCESS : STATUS_NOT_SUPPORTED;
         params->state = (unsigned long long)&thread_state;
+        WINE_MESSAGE("PW_NATIVE_STAGE thread_init reuse state=%p status=%08x ready=%d\n",
+                     &thread_state, (unsigned)thread_state.status, process_ready);
         return thread_state.status;
     }
     status = capture_host_fs(&thread_state.host_fs);
+    WINE_MESSAGE("PW_NATIVE_STAGE thread_init host-fs status=%08x base=%llx\n",
+                 (unsigned)status, thread_state.host_fs);
     if (status) return status;
+#ifdef __PROSPERO__
+    {
+        const size_t page_size = 0x4000;
+        const ULONG fiber_offset = 0x1e00;
+        ULONG *fiber_data = (ULONG *)(ULONG_PTR)(params->guest_teb + 0x10);
+        void *page = mmap((void *)0x10000000, page_size, PROT_READ | PROT_WRITE,
+                          MAP_PRIVATE | MAP_ANON, -1, 0);
+        WINE_MESSAGE("PW_NATIVE_STAGE thread_init mmap page=%p errno=%d\n", page, errno);
+        if (page == MAP_FAILED || (ULONG_PTR)page > 0xffffffffu - fiber_offset)
+        {
+            WINE_MESSAGE("PW_NATIVE_STAGE thread_init mmap-rejected page=%p\n", page);
+            if (page != MAP_FAILED) munmap(page, page_size);
+            return STATUS_NO_MEMORY;
+        }
+        memset(page, 0, page_size);
+        signal_tcb_page = page;
+        saved_fiber_data = *fiber_data;
+        signal_tcb_fiber_data = (ULONG)((ULONG_PTR)page + fiber_offset);
+        *fiber_data = signal_tcb_fiber_data;
+        WINE_MESSAGE("PW_NATIVE_STAGE thread_init tcb teb=%08x page=%p fiber=%08x previous=%08x\n",
+                     (unsigned)params->guest_teb, page, signal_tcb_fiber_data, saved_fiber_data);
+        WINE_MESSAGE("PW_NATIVE_SIGNAL_TCB guest_teb=%08x page=%p fiber=%08x previous=%08x\n",
+                     (unsigned)params->guest_teb, page, signal_tcb_fiber_data, saved_fiber_data);
+    }
+#endif
     thread_profile = (struct pw_native_profile){0};
     if (profile_enabled)
     {
@@ -109,6 +243,11 @@ static NTSTATUS thread_init(void *args)
     thread_state.status = process_ready ? STATUS_SUCCESS : STATUS_NOT_SUPPORTED;
     thread_initialized = 1;
     params->state = (unsigned long long)&thread_state;
+    WINE_MESSAGE("PW_NATIVE_STAGE thread_init ready state=%p status=%08x ready=%d\n",
+                 &thread_state, (unsigned)thread_state.status, process_ready);
+#ifdef __PROSPERO__
+    if (profile_enabled) profile_watch_start(&thread_state);
+#endif
     return thread_state.status;
 }
 
@@ -126,7 +265,28 @@ static NTSTATUS thread_get(void *args)
 
 static NTSTATUS thread_term(void *args)
 {
+#ifdef __PROSPERO__
+    WINE_MESSAGE("PW_NATIVE_STAGE thread_term enter args=%p initialized=%d teb=%llx page=%p\n",
+                 args, thread_initialized, thread_state.guest_fs, signal_tcb_page);
+    if (signal_tcb_page)
+    {
+        ULONG *fiber_data = (ULONG *)(ULONG_PTR)(thread_state.guest_fs + 0x10);
+        if (*fiber_data == signal_tcb_fiber_data) *fiber_data = saved_fiber_data;
+        munmap(signal_tcb_page, 0x4000);
+        signal_tcb_page = NULL;
+        saved_fiber_data = signal_tcb_fiber_data = 0;
+    }
+#endif
     profile_report(&thread_state);
+#ifdef __PROSPERO__
+    pthread_mutex_lock(&profile_watch_lock);
+    if (profile_watch_state == &thread_state)
+    {
+        profile_watch_state = NULL;
+        __atomic_store_n(&profile_watch_stop, 1, __ATOMIC_RELAXED);
+    }
+    pthread_mutex_unlock(&profile_watch_lock);
+#endif
     thread_profile = (struct pw_native_profile){0};
     thread_state = (struct pw_native_thread_state){0};
     thread_initialized = 0;
