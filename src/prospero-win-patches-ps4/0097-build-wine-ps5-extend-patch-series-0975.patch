From: Codex <codex@localhost>
Subject: build: allow PS4 Wine patch 0975

Extend the PS4 Wine patch-series limit to include the bounded Vulkan cursor
handoff trace in patch 0975.

---
--- a/tools/build_wine_ps5.sh
+++ b/tools/build_wine_ps5.sh
@@ -153,6 +153,6 @@
     (cd "$ps5opengl_sdk" && sha256sum --status --check manifest.sha256) ||
     fail "PS5 OpenGL SDK does not match its SHA-256 manifest"
 
-# The series: NNNN-lower-case-name.patch, unique numbers through 0974, each a
+# The series: NNNN-lower-case-name.patch, unique numbers through 0975, each a
 # mail-formatted patch with a subject. Printed in the order it is applied.
 series() {
@@ -167,8 +167,8 @@
             fail "patch name must be NNNN-lower-case-words.patch: $patch"
         number=$(printf '%s' "$patch" | cut -c1-4 | sed 's/^0*//')
         number=${number:-0}
-        [ "$number" -ge 100 ] && [ "$number" -le 974 ] ||
-            fail "patch number outside 0100-0974: $patch"
+        [ "$number" -ge 100 ] && [ "$number" -le 975 ] ||
+            fail "patch number outside 0100-0975: $patch"
         [ "$number" -ne "$last" ] || fail "duplicate patch number: $patch"
         last=$number
         grep -q '^Subject: ' "$patches/$patch" || fail "patch has no Subject: $patch"
-- 
