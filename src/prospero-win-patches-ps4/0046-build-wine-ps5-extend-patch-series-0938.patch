From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] build: accept PS4 Wine patch 0938

The new SIGILL context diagnostic is the next ordered PS4 patch. Extend the
local patch-series limit by one.

---
diff --git a/tools/build_wine_ps5.sh b/tools/build_wine_ps5.sh
index 0000000..0000000 100755
--- a/tools/build_wine_ps5.sh
+++ b/tools/build_wine_ps5.sh
@@ -168,7 +168,7 @@ series() {
         number=$(printf '%s' "$patch" | cut -c1-4 | sed 's/^0*//')
         number=${number:-0}
-        [ "$number" -ge 100 ] && [ "$number" -le 937 ] ||
-            fail "patch number outside 0100-0937: $patch"
+        [ "$number" -ge 100 ] && [ "$number" -le 938 ] ||
+            fail "patch number outside 0100-0938: $patch"
         [ "$number" -ne "$last" ] || fail "duplicate patch number: $patch"
         last=$number
         grep -q '^Subject: ' "$patches/$patch" || fail "patch has no Subject: $patch"
-- 
2.43.0
