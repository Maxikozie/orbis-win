From: Codex <codex@local>
Subject: wow64native: log saved native transition caller slots

Expose the additional stack words captured by ntdll. The final slot is the
caller return address saved below pw_native_switch_fs's assembly frame.

---
--- a/wine/wow64native/unix.c
+++ b/wine/wow64native/unix.c
@@ -61,7 +61,8 @@
                                            unsigned long long *, unsigned long long *,
                                            unsigned long long *, unsigned long long *,
                                            unsigned long long *, unsigned long long *,
-                                           unsigned long long *, unsigned long long *);
+                                           unsigned long long *, unsigned long long *,
+                                           unsigned long long *);
 static pw_native_pc_query profile_pc_query;
 static int profile_pc_enabled;
 static pthread_mutex_t profile_watch_lock = PTHREAD_MUTEX_INITIALIZER;
@@ -161,12 +162,13 @@
                 unsigned long long rax = 0, rdi = 0, rsi = 0, rdx = 0, r10 = 0, rbp = 0, rsp0 = 0;
                 unsigned long long sample_teb = 0, frames64[8] = {0};
                 unsigned long long stack_limit = 0, stack_base = 0, stack_words[8] = {0};
+                unsigned long long stack_deep_words[4] = {0};
                 int owner_match;
                 unsigned int frames[8] = {0};
                 unsigned int frame_count = 0;
                 int rc;
                 profile_pc_query(&before, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL,
-                                 NULL, NULL, NULL);
+                                 NULL, NULL, NULL, NULL);
                 rc = pthread_kill(entry->native_thread, SIGPROF);
                 if (!rc)
                 {
@@ -175,7 +177,8 @@
                     {
                         nanosleep(&pause, NULL);
                         profile_pc_query(&sequence, &rip, &rsp, &cs, &rax, &rdi, &rsi, &rdx, &r10, &rbp, &rsp0,
-                                         &sample_teb, frames64, &stack_limit, &stack_base, stack_words);
+                                         &sample_teb, frames64, &stack_limit, &stack_base, stack_words,
+                                         stack_deep_words);
                         if (sequence != before) break;
                     }
                     owner_match = sample_teb == entry->native_teb;
@@ -202,13 +205,14 @@
                             frame = previous;
                         }
                     }
-                    WINE_MESSAGE("PW_NATIVE_PC teb=%llx native_teb=%llx sample_teb=%llx owner_match=%d seq=%llu rip=%llx rsp=%llx rsp0=%llx rbp=%llx ret=%08x frames=%u[%08x/%08x,%08x/%08x,%08x/%08x,%08x/%08x] host_frames=[%llx/%llx,%llx/%llx,%llx/%llx,%llx/%llx] host_bounds=%llx-%llx host_words=[%llx,%llx,%llx,%llx,%llx,%llx,%llx,%llx] cs=%llx rax=%llx rdi=%llx rsi=%llx rdx=%llx r10=%llx sample=%s\n",
+                    WINE_MESSAGE("PW_NATIVE_PC teb=%llx native_teb=%llx sample_teb=%llx owner_match=%d seq=%llu rip=%llx rsp=%llx rsp0=%llx rbp=%llx ret=%08x frames=%u[%08x/%08x,%08x/%08x,%08x/%08x,%08x/%08x] host_frames=[%llx/%llx,%llx/%llx,%llx/%llx,%llx/%llx] host_bounds=%llx-%llx host_words=[%llx,%llx,%llx,%llx,%llx,%llx,%llx,%llx] host_deep=[%llx,%llx,%llx,%llx] cs=%llx rax=%llx rdi=%llx rsi=%llx rdx=%llx r10=%llx sample=%s\n",
                                  entry->state->guest_fs, entry->native_teb, sample_teb, owner_match, sequence, rip, rsp, rsp0, rbp, frames[1], frame_count,
                                  frames[0], frames[1], frames[2], frames[3], frames[4], frames[5],
