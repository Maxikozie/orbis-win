From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@localhost>
Date: Mon, 19 Oct 2026 00:00:00 -0700
Subject: [PATCH] build: accept PS4 Wine patches through 0961

Allow the final PS4 wait-backend and bounded large-file-mapping diagnostics
to be applied by the normal Wine patch-series builder.
---
 tools/build_wine_ps5.sh | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/tools/build_wine_ps5.sh b/tools/build_wine_ps5.sh
--- a/tools/build_wine_ps5.sh
+++ b/tools/build_wine_ps5.sh
@@ -153,7 +153,7 @@
     (cd "$ps5opengl_sdk" && sha256sum --status --check manifest.sha256) ||
     fail "PS5 OpenGL SDK does not match its SHA-256 manifest"
 
-# The series: NNNN-lower-case-name.patch, unique numbers through 0958, each a
+# The series: NNNN-lower-case-name.patch, unique numbers through 0961, each a
 # mail-formatted patch with a subject. Printed in the order it is applied.
 series() {
@@ -167,8 +167,8 @@
             fail "patch name must be NNNN-lower-case-words.patch: $patch"
         number=$(printf '%s' "$patch" | cut -c1-4 | sed 's/^0*//')
         number=${number:-0}
-        [ "$number" -ge 100 ] && [ "$number" -le 958 ] ||
-            fail "patch number outside 0100-0958: $patch"
+        [ "$number" -ge 100 ] && [ "$number" -le 961 ] ||
+            fail "patch number outside 0100-0961: $patch"
         [ "$number" -ne "$last" ] || fail "duplicate patch number: $patch"
         last=$number
         grep -q '^Subject: ' "$patches/$patch" || fail "patch has no Subject: $patch"
-- 
