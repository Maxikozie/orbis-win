@@ -1072,6 +1120,10 @@ int main(int argc, char **argv)
             PS5LOG_LOG("PW_WINE64 prefix temp folders=%d last=%s", folders,
                        temp.count ? temp.folders[temp.count - 1] : "-");
         }
+        if (game->runtime.nglide_desktop_resolution) {
