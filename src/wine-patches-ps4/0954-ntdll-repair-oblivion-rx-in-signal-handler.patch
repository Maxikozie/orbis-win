From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] ntdll: retry Oblivion instruction fault after RX repair

The 0968 PS4 run verified that the exact page can regain RX, then observed
another instruction-fetch fault at the same address. Repair the measured page
from the SIGSEGV handler and return to retry the interrupted instruction. Keep
the workaround limited to that image page and bounded to eight faults.

---
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -2823,6 +2823,63 @@ static void __attribute__((used)) segv_handler( int signal, siginfo_t *siginfo,
     EXCEPTION_RECORD rec = { .ExceptionAddress = (void *)RIP_sig(sigcontext) };
 
 #ifdef __PROSPERO__
+    /* The 0968 heartbeat proved that this exact Oblivion image page can be
+     * changed from R to RX, but the permission disappears again before the
+     * next instruction fetch. Retry the fetch from the signal context after
+     * repairing the kernel mapping. Returning from this handler restores the
+     * interrupted guest context and retries RIP_sig(). Keep this scoped to
+     * the one measured page and to x86 instruction-fetch faults. */
+    if ((signal == SIGBUS || signal == SIGSEGV) && siginfo &&
+        (ERROR_sig(sigcontext) & 0x10) &&
+        (uintptr_t)siginfo->si_addr >= 0x004a8000 &&
+        (uintptr_t)siginfo->si_addr < 0x004ac000 &&
+        RIP_sig(sigcontext) == (uintptr_t)siginfo->si_addr)
+    {
+        struct ps4_virtual_query_info
+        {
+            void *start, *end;
+            int64_t offset;
+            int32_t protection, memory_type;
+            uint8_t flags;
+            char name[32];
+        } info;
+        extern int sceKernelVirtualQuery( const void *, int, void *, size_t );
+        extern int __wine_ps5_mprotect( void *, size_t, int );
+        extern int sceKernelDebugOutText( int, const char * );
+        static unsigned int repair_count;
+        unsigned int attempt = __atomic_add_fetch( &repair_count, 1, __ATOMIC_RELAXED );
+
+        if (attempt <= 8)
+        {
+            int query_rc, mprotect_rc = -999, verify_rc = -1, protection = -1;
+            char line[256];
+
+            memset( &info, 0, sizeof(info) );
+            query_rc = sceKernelVirtualQuery( siginfo->si_addr, 1, &info, sizeof(info) );
+            if (!query_rc && (uintptr_t)info.start == 0x004a8000 &&
+                (uintptr_t)info.end == 0x004ac000 &&
+                (info.protection & PROT_READ) && !(info.protection & PROT_EXEC))
+            {
+                mprotect_rc = __wine_ps5_mprotect( (void *)0x004a8000, 0x4000,
+                                                  PROT_READ | PROT_EXEC );
+                memset( &info, 0, sizeof(info) );
+                verify_rc = sceKernelVirtualQuery( siginfo->si_addr, 1, &info, sizeof(info) );
+                if (!verify_rc) protection = info.protection;
+            }
+            if (!query_rc && !verify_rc && (protection & PROT_EXEC))
+            {
+                snprintf( line, sizeof(line),
+                          "ntdll ps4-fault-rx-retry build=0969 attempt=%u addr=%p rc=%d prot=%#x; retrying RIP\n",
+                          attempt, siginfo->si_addr, mprotect_rc, protection );
+                sceKernelDebugOutText( 0, line );
+                return;
+            }
+            snprintf( line, sizeof(line),
+                      "ntdll ps4-fault-rx-retry build=0969 attempt=%u addr=%p query=%d rc=%d verify=%d prot=%#x; falling through\n",
+                      attempt, siginfo->si_addr, query_rc, mprotect_rc, verify_rc, protection );
+            sceKernelDebugOutText( 0, line );
+        }
+    }
     /* Record the raw Orbis page-fault context before wowprospero's hook can
      * consume it. The image was granted RX by sceKernelMprotect, but Wine
      * still reports a read AV at Oblivion's EIP. The x86 page-fault error
