From: Codex <codex@local>
Subject: ntdll: include PS4 native thread IDs in profiler samples

Include pthread_getthreadid_np() in each sampled native-PC record so a
FreeBSD umutex owner TID can be matched to the sampled thread's PC and stack.

---
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -28,6 +28,9 @@
 
 #include <assert.h>
 #include <pthread.h>
+#ifdef HAVE_PTHREAD_GETTHREADID_NP
+extern int pthread_getthreadid_np(void);
+#endif
 #include <signal.h>
 #include <dlfcn.h>
 #include <stdlib.h>
@@ -109,6 +112,7 @@
 static volatile unsigned long long pw_native_pc_stack_deep_words[4];
 static volatile unsigned long long pw_native_pc_rsp_words[4];
 static volatile unsigned long long pw_native_pc_umtx_words[4];
+static volatile unsigned long long pw_native_pc_native_tid;
 
 __attribute__((visibility("default")))
 unsigned int __wine_prospero_native_wow64_caps( unsigned int version )
@@ -135,7 +139,8 @@
                                                      unsigned long long *stack_words,
                                                      unsigned long long *stack_deep_words,
                                                      unsigned long long *rsp_words,
-                                                     unsigned long long *umtx_words )
+                                                     unsigned long long *umtx_words,
+                                                     unsigned long long *native_tid )
 {
     unsigned long long seq = __atomic_load_n( &pw_native_pc_sequence, __ATOMIC_ACQUIRE );
     if (sequence) *sequence = seq;
@@ -162,6 +167,7 @@
         rsp_words[i] = __atomic_load_n( &pw_native_pc_rsp_words[i], __ATOMIC_RELAXED );
     if (umtx_words) for (unsigned int i = 0; i < 4; ++i)
         umtx_words[i] = __atomic_load_n( &pw_native_pc_umtx_words[i], __ATOMIC_RELAXED );
+    if (native_tid) *native_tid = __atomic_load_n( &pw_native_pc_native_tid, __ATOMIC_RELAXED );
     return 1;
 }
 
@@ -1136,6 +1142,11 @@
     __atomic_store_n( &pw_native_pc_r10, R10_sig(context), __ATOMIC_RELAXED );
     __atomic_store_n( &pw_native_pc_rbp, RBP_sig(context), __ATOMIC_RELAXED );
     __atomic_store_n( &pw_native_pc_teb, (uintptr_t)data->teb, __ATOMIC_RELAXED );
+#ifdef HAVE_PTHREAD_GETTHREADID_NP
+    __atomic_store_n( &pw_native_pc_native_tid, (unsigned int)pthread_getthreadid_np(), __ATOMIC_RELAXED );
+#else
+    __atomic_store_n( &pw_native_pc_native_tid, 0, __ATOMIC_RELAXED );
+#endif
     for (unsigned int i = 0; i < 8; ++i)
     {
         __atomic_store_n( &pw_native_pc_frames64[i], 0, __ATOMIC_RELAXED );
