-HRESULT WINAPI DCompositionCreateDevice(IDXGIDevice *dxgi_device, REFIID iid, void **device)
+/* ⚠ A device that exists, rather than E_NOTIMPL and an untouched out pointer.
+ *
+ * The stub returned E_NOTIMPL and never wrote *device, and a caller that does
+ * not check the HRESULT then reads through whatever the variable held. GTA IV's
+ * loader does exactly that:
+ *
+ *     fixme:dcomp:DCompositionCreateDevice 00000000, {c37ea93a-...}, 002541D0.
+ *     err:wow:raise_guest_exception guest exception 0xc0000005 at eip 0x79f9d308
+ *                                   esp 0x21fe64 address 0x2c
+ *
+ * -- the 0x2c being a field read off the NULL it was left with, and the crash
+ * that had been read as a DRM check through most of a day. It is the last thing
+ * between this port and a rendered frame: by the time it is reached DXVK has
+ * compiled its shaders and built its pipelines.
+ *
+ * Every method still answers E_NOTIMPL. What changes is that there is an object
+ * to answer, with a reference count and a working QueryInterface, so a caller
+ * that ignores the HRESULT gets a pointer rather than a fault. This is not
+ * DirectComposition and does not pretend to be; it is the difference between
+ * failing and crashing. */
+
+struct dcomp_device
+{
+    IDCompositionDevice IDCompositionDevice_iface;
+    LONG refcount;
+};
+
+static ULONG WINAPI device_AddRef( IDCompositionDevice *iface );
+static ULONG WINAPI device_Release( IDCompositionDevice *iface );
+
+static HRESULT WINAPI device_QueryInterface( IDCompositionDevice *iface, REFIID iid, void **out )
+{
+    struct dcomp_device *device = CONTAINING_RECORD( iface, struct dcomp_device, IDCompositionDevice_iface );
+
+    if (IsEqualGUID( iid, &IID_IDCompositionDevice ) || IsEqualGUID( iid, &IID_IUnknown ))
+    {
+        device_AddRef( &device->IDCompositionDevice_iface );
+        *out = &device->IDCompositionDevice_iface;
+        return S_OK;
+    }
+    WARN( "%s not implemented.\n", debugstr_guid(iid) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI device_AddRef( IDCompositionDevice *iface )
+{
+    struct dcomp_device *device = CONTAINING_RECORD( iface, struct dcomp_device, IDCompositionDevice_iface );
+    return InterlockedIncrement( &device->refcount );
+}
+
+static ULONG WINAPI device_Release( IDCompositionDevice *iface )
+{
+    struct dcomp_device *device = CONTAINING_RECORD( iface, struct dcomp_device, IDCompositionDevice_iface );
+    ULONG refcount = InterlockedDecrement( &device->refcount );
+
+    if (!refcount) free( device );
+    return refcount;
+}
