+HRESULT WINAPI DCompositionCreateDevice(IDXGIDevice *dxgi_device, REFIID iid, void **device)
+{
+    struct dcomp_device *object;
+    HRESULT hr;
+
+    FIXME("%p, %s, %p: returning a stub device.\n", dxgi_device, debugstr_guid(iid), device);
+
+    if (!device) return E_INVALIDARG;
+    *device = NULL;
+    if (!(object = calloc( 1, sizeof(*object) ))) return E_OUTOFMEMORY;
+    object->IDCompositionDevice_iface.lpVtbl = (void *)dcomp_device_vtbl;
+    object->refcount = 1;
+
+    hr = device_QueryInterface( &object->IDCompositionDevice_iface, iid, device );
+    device_Release( &object->IDCompositionDevice_iface );
+    return hr;
+}
