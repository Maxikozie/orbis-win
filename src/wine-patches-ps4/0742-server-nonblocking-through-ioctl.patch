From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ps4-gladius <ps4-gladius@invalid>
Date: Thu, 8 Oct 2026 09:10:00 +0000
Subject: [PATCH] server: set non-blocking mode with ioctl, not fcntl.

0741 named the failure outright:

    init_thread 0024 FAILED: O_NONBLOCK on the reply pipe refused
                     (reply_fd=33 wait_fd=35 errno=13) in flight:

errno 13 is EACCES: this console refuses fcntl( fd, F_SETFL, O_NONBLOCK ). The
thread then left init_thread without a reply pipe, and the server killed it on
its first request -- which ntdll turns into abort_thread and an uncatchable
SIGSYS, taking the title down.

The empty in-flight list in that line is not a second fault: both descriptors
were found and thread_get_inflight_fd clears the slot it answers from, so it
confirms the handover in 0737 and 0738 works.

This console's fcntl is selectively implemented -- F_DUPFD and F_GETFD are
refused as well -- so set the mode through FIONBIO, the ioctl FreeBSD has always
carried for it, and keep fcntl as the fallback. One helper, used by every site
that asks for non-blocking mode: three of them were fatal when refused and the
rest ignored the result, which would have left descriptors blocking in the
server's poll loop.

If FIONBIO is refused too, it says so once through klog before falling back.
---
diff --git a/server/fd.c b/server/fd.c
index 7cfcbf44c4..f71b47a621 100644
--- a/server/fd.c
+++ b/server/fd.c
@@ -25,6 +25,9 @@
 #include <dirent.h>
 #include <errno.h>
 #include <fcntl.h>
+#ifdef __PROSPERO__
+#include <sys/ioctl.h>
+#endif
 #include <limits.h>
 #include <signal.h>
 #include <stdarg.h>
@@ -2146,6 +2149,33 @@ int is_fd_overlapped( struct fd *fd )
 }
 
 /* retrieve the unix fd for an object */
+/* put a descriptor in non-blocking mode.
+ *
+ * ⚠ fcntl( fd, F_SETFL, O_NONBLOCK ) is refused on this console: it returns
+ * -1 with EACCES, measured on the reply pipe in init_thread, where the failure
+ * left the thread without one and the server killed it on its first request.
+ * This console's fcntl is selectively implemented -- F_DUPFD and F_GETFD are
+ * refused too -- so set the mode through the ioctl FreeBSD has always carried
+ * for it, and keep fcntl as the fallback. */
+int pw_set_nonblocking( int fd )
+{
+#ifdef __PROSPERO__
+    static int reported;
+    int on = 1;
+
+    if (!ioctl( fd, FIONBIO, &on )) return 0;
+    if (!reported++)
+    {
+        extern int sceKernelDebugOutText( int channel, const char *text );
+        char line[128];
+        snprintf( line, sizeof(line),
+                  "wineserver: FIONBIO refused (errno %d), falling back to fcntl\n", errno );
+        sceKernelDebugOutText( 0, line );
+    }
+#endif
+    return fcntl( fd, F_SETFL, O_NONBLOCK );
+}
+
 int get_unix_fd( struct fd *fd )
 {
     if (fd->unix_fd == -1) set_error( fd->no_fd_status );
diff --git a/server/file.h b/server/file.h
index a1c8a3f636..d9d93dd385 100644
--- a/server/file.h
+++ b/server/file.h
@@ -294,4 +294,7 @@ static inline int async_queued( struct async_queue *queue )
 #define FILE_MAPPING_WRITE  0x40000000  /* set for writable shared mappings */
 #define FILE_MAPPING_ACCESS 0x20000000  /* set for all mappings */
 
+/* put a descriptor in non-blocking mode (fcntl is refused on PS4) */
+extern int pw_set_nonblocking( int fd );
+
 #endif  /* __WINE_SERVER_FILE_H */
diff --git a/server/process.c b/server/process.c
index 49211ef01d..3a1d4d830e 100644
--- a/server/process.c
+++ b/server/process.c
@@ -1144,7 +1144,7 @@ DECL_HANDLER(new_process)
     }
     if (params.root) release_object( params.root );  /* unused */
 
-    if (fcntl( socket_fd, F_SETFL, O_NONBLOCK ) == -1)
+    if (pw_set_nonblocking( socket_fd ) == -1)
     {
         set_error( STATUS_INVALID_HANDLE );
         close( socket_fd );
diff --git a/server/request.c b/server/request.c
index 1544adc178..693836a120 100644
--- a/server/request.c
+++ b/server/request.c
@@ -765,7 +765,7 @@ static void master_socket_poll_event( struct fd *fd, int event )
         int client = accept( get_unix_fd( master_socket->fd ), (struct sockaddr *) &dummy, &len );
 #endif
         if (client == -1) return;
-        fcntl( client, F_SETFL, O_NONBLOCK );
+        pw_set_nonblocking( client );
         if ((process = create_process( client, NULL, 0, NULL, NULL, NULL, 0, NULL )))
         {
             struct thread *thread = create_thread( -1, process, NULL );
diff --git a/server/sock.c b/server/sock.c
index 0716b3f71f..12eead9030 100644
--- a/server/sock.c
+++ b/server/sock.c
@@ -1964,7 +1964,7 @@ static int init_socket( struct sock *sock, int family, int type, int protocol )
         else set_win32_error( sock_get_error( errno ));
         return -1;
     }
-    fcntl(sockfd, F_SETFL, O_NONBLOCK); /* make socket nonblocking */
+    pw_set_nonblocking( sockfd ); /* make socket nonblocking */
 
     if (family == WS_AF_IPX && protocol >= WS_NSPROTO_IPX && protocol <= WS_NSPROTO_IPX + 255)
     {
@@ -2060,7 +2060,7 @@ static int accept_new_fd( struct sock *sock )
     socklen_t slen = sizeof(saddr);
     int acceptfd = accept( get_unix_fd(sock->fd), &saddr, &slen );
     if (acceptfd != -1)
-        fcntl( acceptfd, F_SETFL, O_NONBLOCK );
+        pw_set_nonblocking( acceptfd );
     else
         set_error( sock_get_ntstatus( errno ));
     return acceptfd;
@@ -3800,7 +3800,7 @@ static void ifchange_poll_event( struct fd *fd, int event )
         set_error( sock_get_ntstatus( errno ));
         return NULL;
     }
-    fcntl( unix_fd, F_SETFL, O_NONBLOCK ); /* make socket nonblocking */
+    pw_set_nonblocking( unix_fd ); /* make socket nonblocking */
     memset( &addr, 0, sizeof(addr) );
     addr.nl_family = AF_NETLINK;
     addr.nl_groups = RTMGRP_IPV4_IFADDR;
diff --git a/server/thread.c b/server/thread.c
index 6a870dea47..cbd47f5955 100644
--- a/server/thread.c
+++ b/server/thread.c
@@ -1774,7 +1774,7 @@ DECL_HANDLER(new_thread)
             goto done;
         }
     }
-    else if (request_fd == -1 || fcntl( request_fd, F_SETFL, O_NONBLOCK ) == -1)
+    else if (request_fd == -1 || pw_set_nonblocking( request_fd ) == -1)
     {
         if (request_fd != -1) close( request_fd );
         set_error( STATUS_INVALID_HANDLE );
@@ -1882,7 +1882,7 @@ static int init_thread( struct thread *thread, int reply_fd, int wait_fd )
         goto error;
     }
 
-    if (fcntl( reply_fd, F_SETFL, O_NONBLOCK ) == -1)
+    if (pw_set_nonblocking( reply_fd ) == -1)
     {
 #ifdef __PROSPERO__
         pw_init_thread_note( thread, "FAILED: O_NONBLOCK on the reply pipe refused", want_reply, want_wait );
