From: Codex <codex@localhost>
Subject: ntdll: log bounded WoW64 fault stack words

Capture a small window from the interrupted 32-bit guest stack before Wine
constructs its exception frame. Read only when the CS identifies the WoW64
guest and RSP lies within the TEB32 stack bounds. This supplements first-
exception registers for guest faults without changing execution state.

---
diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
index fe6305b029de05aa49d63632aeb9f72f6f140a17..f03e427fcd3e34d29ccd710d4ba222fecb692197 100644
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -1914,3 +1914,36 @@ static void setup_raise_exception( struct thread_data *data, ucontext_t *sigcont
                  (unsigned long long)context->R15, (unsigned long long)context->EFlags,
                  context->SegCs, context->SegSs, context->SegFs, context->SegGs );
+
+            /* A 32-bit guest fault keeps its interrupted stack in guest
+             * address space. Snapshot a small, bounds-checked window from
+             * that stack before Wine constructs the exception frame. */
+            if ((context->SegCs & 0xffff) == 0x33 && data && data->teb)
+            {
+                WOW_TEB *wow_teb = get_wow_teb( data->teb );
+                ULONG guest_rsp = (ULONG)context->Rsp;
+
+                if (wow_teb && guest_rsp >= wow_teb->Tib.StackLimit &&
+                    guest_rsp < wow_teb->Tib.StackBase)
+                {
+                    ULONG available = wow_teb->Tib.StackBase - guest_rsp;
+                    unsigned int words = available / sizeof(ULONG), i;
+
+                    if (words > 16) words = 16;
+                    ERR( "PW_EXCEPTION_GUEST_STACK n=%u rsp=%08x bounds=%08x-%08x words=%u\n",
+                         n, guest_rsp, wow_teb->Tib.StackLimit,
+                         wow_teb->Tib.StackBase, words );
+                    for (i = 0; i < words; i += 4)
+                    {
+                        ULONG v0 = *(const volatile ULONG *)(ULONG_PTR)(guest_rsp + 4 * i);
+                        ULONG v1 = i + 1 < words ? *(const volatile ULONG *)(ULONG_PTR)(guest_rsp + 4 * (i + 1)) : 0;
+                        ULONG v2 = i + 2 < words ? *(const volatile ULONG *)(ULONG_PTR)(guest_rsp + 4 * (i + 2)) : 0;
+                        ULONG v3 = i + 3 < words ? *(const volatile ULONG *)(ULONG_PTR)(guest_rsp + 4 * (i + 3)) : 0;
+
+                        ERR( "PW_EXCEPTION_GUEST_STACK n=%u +%02x: %08x %08x %08x %08x\n",
+                             n, 4 * i, v0, v1, v2, v3 );
+                    }
+                }
+                else ERR( "PW_EXCEPTION_GUEST_STACK n=%u unavailable rsp=%08x teb=%p\n",
+                         n, guest_rsp, wow_teb );
+            }
         }
