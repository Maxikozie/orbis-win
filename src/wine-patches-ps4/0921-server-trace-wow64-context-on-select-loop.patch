diff --git a/server/request.c b/server/request.c
index d9df8fb52e..707978696d 100644
--- a/server/request.c
+++ b/server/request.c
@@ -485,6 +485,9 @@ static void call_req_handler( struct thread *thread )
                       handles[4], handles[5], handles[6], handles[7], ctx_count,
                       ctx_machine, ctx_flags, ctx_rip );
             sceKernelDebugOutText( 0, line );
+            if (select->timeout == 0 && !select->size && ctx_count &&
+                ctx_machine == 0x8664 && (n <= 32 || !(n & (n - 1))))
+                ps5_trace_guest_context( thread );
         }
