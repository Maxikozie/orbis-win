From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Subject: [PATCH] server: trace get_process_debug_info request stages on PS4

The last observed client request before Oblivion stalls is request 10,
get_process_debug_info. Emit bounded entry, lookup, reply, and exit markers to
the PS4 kernel log so the next run shows whether the handler completes.

---
diff --git a/server/process.c b/server/process.c
index 3a1d4d830e..7860335781 100644
--- a/server/process.c
+++ b/server/process.c
@@ -1528,12 +1528,52 @@ DECL_HANDLER(get_process_debug_info)
 {
     struct process *process;
 
-    if (!(process = get_process_from_handle( req->handle, PROCESS_QUERY_LIMITED_INFORMATION ))) return;
+#ifdef __PROSPERO__
+    extern int sceKernelDebugOutText( int channel, const char *text );
+    static unsigned int trace_count;
+    char trace[128];
+    unsigned int count = __atomic_add_fetch( &trace_count, 1, __ATOMIC_RELAXED );
+
+    if (count <= 16)
+    {
+        snprintf( trace, sizeof(trace), "wineserver: debug_info begin n=%u tid=%04x handle=%08x\n",
+                  count, current->id, req->handle );
+        sceKernelDebugOutText( 0, trace );
+    }
+#endif
+
+    if (!(process = get_process_from_handle( req->handle, PROCESS_QUERY_LIMITED_INFORMATION )))
+    {
+#ifdef __PROSPERO__
+        if (count <= 16)
+        {
+            snprintf( trace, sizeof(trace), "wineserver: debug_info no_process n=%u error=%08x\n",
+                      count, current->error );
+            sceKernelDebugOutText( 0, trace );
+        }
+#endif
+        return;
+    }
 
     reply->debug_children = process->debug_children;
     if (!process->debug_obj) set_error( STATUS_PORT_NOT_SET );
     else reply->debug = alloc_handle( current->process, process->debug_obj, MAXIMUM_ALLOWED, 0 );
+#ifdef __PROSPERO__
+    if (count <= 16)
+    {
+        snprintf( trace, sizeof(trace), "wineserver: debug_info n=%u pid=%04x obj=%p reply=%08x children=%u error=%08x\n",
+                  count, process->id, process->debug_obj, reply->debug, reply->debug_children, current->error );
+        sceKernelDebugOutText( 0, trace );
+    }
+#endif
     release_object( process );
+#ifdef __PROSPERO__
+    if (count <= 16)
+    {
+        snprintf( trace, sizeof(trace), "wineserver: debug_info end n=%u\n", count );
+        sceKernelDebugOutText( 0, trace );
+    }
+#endif
 }
 
 /* fetch the name of the process image */
