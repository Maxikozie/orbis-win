From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: prospero-win <prospero-win@invalid>
Subject: [PATCH] ntdll: Name the step that refuses a builtin on ps5.

GTA IV loads 29 modules and then every further builtin is refused with
STATUS_NO_MEMORY -- wmvcore, powrprof, oleaut32, dinput8, wintrust,
shell32 -- out of open_dll_file, before any placement happens. That rules
out the address space: 0873 never fired because the image never reached
map_image_view at all.

Size is not it either. powrprof is 25 KiB and fails where user32 at
1.8 MiB had just succeeded, and the set moves between runs, so it is a
count of something consumed per load, not a property of the module.

open_dll_file is two calls reporting one status, so split it: the file
not opening and the file not becoming a section consume quite different
things. Print the heap counters alongside, because everything the loader
allocates comes from pw_wine_heap -- the title's libc stops near 13 MiB --
and the directory listings this port now keeps are a new tenant of it:
nothing was ever cached while read_names could not list /data, so the
getdents fix gave this heap a consumer it did not have before. live,
mapped, peak and the failure count say whether that is where it went.

Also report a refusal from server_get_unix_fd, which runs before any
mapping trace and so looks identical from outside, and the status at the
map_image_view call site, independently of 0873.

Diagnostic only; no behaviour changes.
diff --git a/dlls/ntdll/unix/loader.c b/dlls/ntdll/unix/loader.c
index e90f83c79e..9e6c326208 100644
--- a/dlls/ntdll/unix/loader.c
+++ b/dlls/ntdll/unix/loader.c
@@ -1096,6 +1096,40 @@ static NTSTATUS open_dll_file( const char *name, OBJECT_ATTRIBUTES *attr, HANDLE
                               SECTION_MAP_READ | SECTION_MAP_EXECUTE,
                               NULL, &size, PAGE_EXECUTE_READ, SEC_IMAGE, handle );
     NtClose( handle );
+#ifdef __PROSPERO__
+    /* ⚠ DIAGNOSTIC. open_dll_file is two calls and reports one status, so
+     * "open failed c0000017" does not say whether the file could not be opened
+     * or could not be turned into a section. GTA IV's 30th module onwards all
+     * end here, whatever their size -- powrprof is 25 KiB and fails where
+     * user32 at 1.8 MiB did not -- so it is a count, not a size, and the two
+     * halves consume quite different things.
+     *
+     * The heap counters come with it. Everything the loader allocates comes
+     * from pw_wine_heap (the title's libc stops near 13 MiB), and the
+     * directory listings this port now keeps are a new tenant of it: nothing
+     * was ever cached while read_names could not list /data. live, mapped and
+     * the failure count say whether that is where the memory went. */
+    if (status)
+    {
+        struct pw_heap_stats {
+            unsigned long long live, peak_live, mapped, peak_mapped;
+            unsigned long long allocs, frees, failures, foreign, large;
+        } heap = { 0 };
+        extern void pw_wine_heap_stats( struct pw_heap_stats *stats );
+        static int reported;
+
+        if (reported < 12)
+        {
+            reported++;
+            pw_wine_heap_stats( &heap );
+            ERR( "ps5 section refused %s: %x, heap live %llu KiB mapped %llu KiB "
+                 "peak %llu KiB allocs %llu frees %llu failures %llu large %llu\n",
+                 debugstr_a(name), (unsigned int)status,
+                 heap.live / 1024, heap.mapped / 1024, heap.peak_mapped / 1024,
+                 heap.allocs, heap.frees, heap.failures, heap.large );
+        }
+    }
+#endif
     return status;
 }
 
diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
index 1091901bad..f7f8e9c45d 100644
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -3795,7 +3795,15 @@ static NTSTATUS virtual_map_image( HANDLE mapping, void **addr_ptr, SIZE_T *size
         return STATUS_INVALID_PARAMETER;
 
     if ((status = server_get_unix_fd( mapping, 0, &unix_fd, &needs_close, NULL, NULL )))
+    {
+#ifdef __PROSPERO__
+        /* ⚠ DIAGNOSTIC. Runs before anything is placed and before any mapping
+         * trace, so from outside it looks exactly like a placement failure. */
+        static int reported;
+        if (reported < 8) { reported++; ERR( "ps5 image fd refused: %x\n", (unsigned int)status ); }
+#endif
         return status;
+    }
 
     if (pe_mapping->shared_file &&
         ((status = server_get_unix_fd( pe_mapping->shared_file, FILE_READ_DATA|FILE_WRITE_DATA,
@@ -3820,6 +3828,17 @@ static NTSTATUS virtual_map_image( HANDLE mapping, void **addr_ptr, SIZE_T *size
     server_enter_uninterrupted_section( &virtual_mutex, &sigset );
 
     status = map_image_view( &view, &pe_mapping->image, size, limit_low, limit_high, alloc_type );
+#ifdef __PROSPERO__
+    {
+        static int reported;
+        if (status && reported < 8)
+        {
+            reported++;
+            ERR( "ps5 image view refused: %u KiB -> %x\n",
+                 (unsigned int)(size / 1024), (unsigned int)status );
+        }
+    }
+#endif
     if (status) goto done;
 
     status = map_image_into_view( view, &pe_mapping->nt_name, unix_fd, &pe_mapping->image,
