From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] ntdll: consume Prospero single-step inside syscall stack

The PS4 run delivered a #DB single-step with TF set through segv_handler while
RSP was inside Wine's syscall stack. Wine classified TRAP_TRACE as an illegal
instruction and replayed a stale syscall frame indefinitely. Clear TF and
resume at the next host instruction for this internal syscall-stack case.

---
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -2907,6 +2907,29 @@
     }
 #endif
     save_context( data, &context, sigcontext );
+#ifdef __PROSPERO__
+    /* On PS4, a native syscall return can surface its single-step (#DB) as
+     * SIGILL. The syscall stack and TF bit identify it; treating TRAP_TRACE
+     * as an illegal instruction sends it back through a stale Wine frame and
+     * repeats forever. Single-step through Wine's host syscall machinery is
+     * not useful to the Windows caller, so clear TF and resume at the next
+     * host instruction. */
+    if (TRAP_sig(sigcontext) == TRAP_x86_TRCTRAP && data->teb &&
+        (EFL_sig(sigcontext) & 0x100) && is_inside_syscall( data, RSP_sig(sigcontext) ))
+    {
+        static unsigned int trace_count;
+        unsigned int n = __atomic_add_fetch( &trace_count, 1, __ATOMIC_RELAXED );
+        if (n <= 8 || !(n & (n - 1)))
+            ERR_(seh)( "Consuming Prospero single-step n=%u sig=%d rip=%016lx rsp=%016lx frame=%p frame_id=%08x frame_rip=%016lx\n",
+                      n, signal, (unsigned long)RIP_sig(sigcontext),
+                      (unsigned long)RSP_sig(sigcontext), get_syscall_frame( data ),
+                      get_syscall_frame( data )->syscall_id,
+                      (unsigned long)get_syscall_frame( data )->rip );
+        EFL_sig(sigcontext) &= ~0x100;
+        leave_handler( data, sigcontext );
+        return;
+    }
+#endif
 
     switch(TRAP_sig(sigcontext))
     {
-- 
