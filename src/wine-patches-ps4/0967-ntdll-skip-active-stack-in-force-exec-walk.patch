From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] ntdll: skip active stack during legacy force-exec walk

The Orbis kernel can fault while sceKernelMprotect changes permissions on
the direct-memory view containing the stack used by the current syscall.
Leave that one view unchanged during Wine's startup ProcessExecuteFlags walk.
This is a one-time startup check, with no per-frame cost, and is PS4-only.

---
diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -5681,6 +5681,9 @@ void virtual_set_force_exec( BOOL enable )
 {
     struct file_view *view;
     sigset_t sigset;
+#ifdef __PS4__
+    ULONG_PTR stack_addr = (ULONG_PTR)&sigset;
+#endif
 
     server_enter_uninterrupted_section( &virtual_mutex, &sigset );
     if (!force_exec_prot != !enable)  /* change all existing views */
@@ -5691,8 +5694,17 @@ void virtual_set_force_exec( BOOL enable )
         WINE_RB_FOR_EACH_ENTRY( view, &views_tree, struct file_view, entry )
         {
             /* file mappings are always accessible */
             BYTE commit = is_view_valloc( view ) ? 0 : VPROT_COMMITTED;
 
+#ifdef __PS4__
+            /* Do not change permissions on the stack this walk is currently
+             * using. On Orbis, mprotecting its direct-memory view can unmap
+             * the return stack while sceKernelMprotect is still executing. */
+            if (stack_addr >= (ULONG_PTR)view->base &&
+                stack_addr - (ULONG_PTR)view->base < view->size)
+                continue;
+#endif
+
             mprotect_range( view->base, view->size, commit, 0 );
         }
     }
