+static void trace_adapter_buffer( const char *where, ULONG call, const void *buffer )
+{
+    MEMORY_BASIC_INFORMATION info;
+    SIZE_T size;
+
+    if (!buffer)
+    {
+        MESSAGE( "PW_GAA buffer call=%lu where=%s ptr=NULL\n", call, where );
+        return;
+    }
+
+    size = VirtualQuery( buffer, &info, sizeof(info) );
