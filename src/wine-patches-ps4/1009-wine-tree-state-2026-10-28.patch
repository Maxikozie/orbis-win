+    if (!ps5_image_view_fd_release_enabled() || !view_refs ||
+        fd->obj.refcount <= 1 || view_refs != fd->obj.refcount - 1 ||
+        fd->unix_fd == -1 || fd->access != (FILE_MAPPING_ACCESS | FILE_MAPPING_IMAGE) ||
+        fd->user || !fd->inode || !fd->closed ||
