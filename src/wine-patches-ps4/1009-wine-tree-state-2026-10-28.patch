+    RECORD( glVertex4f );
+    RECORD( glTexCoord2f );
+    RECORD( glColor3f );
+    RECORD( glColor4f );
+    RECORD( glColor3ub );
+    RECORD( glColor4ub );
+    RECORD( glNormal3f );
+    RECORD( glMultiTexCoord2f );
+    RECORD( glMultiTexCoord2fARB );
