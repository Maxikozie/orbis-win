+#define PW_PS4_NSIG 32
+/* mc_addr within the FreeBSD amd64 mcontext (see machine/fbsd_mcontext.h). Read
+ * by offset rather than through the struct so this block does not depend on
+ * where the header lands in the include order. */
+#define PW_PS4_MC_ADDR 136
+
+static void (*pw_ps4_fault_handler[PW_PS4_NSIG])( int, siginfo_t *, void * );
+
+static int pw_ps4_is_fault_signal( int signal )
+{
+    return signal == SIGSEGV || signal == SIGBUS || signal == SIGILL ||
+           signal == SIGFPE  || signal == SIGTRAP;
