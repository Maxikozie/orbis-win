+static void poll_timeout( void *private );
+
+static void poll_arm( struct dir *dir )
+{
+    dir->poll->timeout = add_timeout_user( current_time + dir->poll->interval, poll_timeout, dir );
+}
+
+static void poll_timeout( void *private )
+{
+    struct dir *dir = private;
+    struct poll_watch *watch = dir->poll;
+    struct poll_item *items = NULL;
+    unsigned int count = 0, size = 0;
+    struct timespec before, after;
+    const char *base;
+    long long took;
+
+    watch->timeout = NULL;
+    if (!(base = get_fd_unix_name( dir->fd ))) return;
+    clock_gettime( CLOCK_MONOTONIC, &before );
+    poll_scan( base, "", dir->subtree, 0, &items, &count, &size );
+    clock_gettime( CLOCK_MONOTONIC, &after );
+    if (items) qsort( items, count, sizeof(*items), poll_compare );
+    poll_compare_lists( dir, watch->items, watch->count, items, count );
+    poll_free_items( watch->items, watch->count );
+    watch->items = items;
+    watch->count = count;
+    /* a listing that takes long is made less often: eight times as long between two */
+    took = ((long long)(after.tv_sec - before.tv_sec) * 1000000000 + (after.tv_nsec - before.tv_nsec)) / 100;
+    watch->interval = took * 8 < POLL_MIN_INTERVAL ? POLL_MIN_INTERVAL
+                      : took * 8 > POLL_MAX_INTERVAL ? POLL_MAX_INTERVAL : took * 8;
+    poll_arm( dir );
+}
+
+static void poll_watch_free( struct dir *dir )
+{
+    struct poll_watch *watch = dir->poll;
+
+    if (!watch) return;
+    if (watch->timeout) remove_timeout_user( watch->timeout );
+    poll_free_items( watch->items, watch->count );
+    free( watch );
+    dir->poll = NULL;
+}
+
+static int inotify_adjust_changes( struct dir *dir )
+{
+    struct poll_watch *watch;
+    const char *base;
+    unsigned int size = 0;
+
+    if (dir->poll) return 1;
+    if (!(base = get_fd_unix_name( dir->fd )) || !(watch = calloc( 1, sizeof(*watch) ))) return 0;
+    dir->poll = watch;
+    watch->interval = POLL_MIN_INTERVAL;
+    /* the list the next ones are compared with is made now, before the caller can change anything */
+    poll_scan( base, "", dir->subtree, 0, &watch->items, &watch->count, &size );
+    if (watch->items) qsort( watch->items, watch->count, sizeof(*watch->items), poll_compare );
+    poll_arm( dir );
+    return 1;
+}
