+        return FALSE;
+    }
+    return !RegNotifyChangeKeyValue( fqdn_key, TRUE, REG_NOTIFY_CHANGE_NAME | REG_NOTIFY_CHANGE_LAST_SET,
+                                     fqdn_changed, TRUE );
