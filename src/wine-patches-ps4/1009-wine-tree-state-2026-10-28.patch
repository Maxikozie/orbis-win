+             * context. Probe every read: the watchdog must not crash the title
+             * while trying to inspect an absent or stale CPU pointer. */
+            if (probe[1] != -1 && teb <= UINTPTR_MAX - 0x1488 &&
+                ps5_peek( probe, teb + 0x1488, &cpu, sizeof(cpu) ) && cpu &&
+                cpu <= UINTPTR_MAX - (4 + 0xc8) &&
+                ps5_peek( probe, cpu + 2, &machine, sizeof(machine) ) &&
+                machine == 0x14c /* IMAGE_FILE_MACHINE_I386 */ &&
+                ps5_peek( probe, cpu + 4 + 0xb8, &eip, sizeof(eip) ) &&
+                ps5_peek( probe, cpu + 4 + 0xc4, &esp, sizeof(esp) ))
+            {
+                fprintf( stderr, "wine-ps5: guest tid=%04x eip=%08x esp=%08x:", thread->id, eip, esp );
+                if (esp) for (i = 0; i < 32; i++)
+                {
+                    unsigned int word;
+                    if (!ps5_peek( probe, (uintptr_t)esp + 4 * i, &word, sizeof(word) )) break;
+                    fprintf( stderr, " %08x", word );
+                }
+                fprintf( stderr, "\n" );
+                /* Critical sections among the stack's pointers: a pointer whose
+                 * DebugInfo points back at it. Memory is read only after write()
+                 * to a pipe accepts it, so a bad pointer is skipped, not a crash. */
+                if (esp)
