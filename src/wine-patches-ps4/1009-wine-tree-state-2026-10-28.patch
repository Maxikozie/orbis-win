+        MESSAGE( "PW_GAA buffer call=%lu where=%s ptr=%p query=%lu base=%p alloc=%p region=%lu state=%08lx protect=%08lx type=%08lx\n",
+                 call, where, buffer, (ULONG)size, info.BaseAddress, info.AllocationBase,
+                 (ULONG)info.RegionSize, info.State, info.Protect, info.Type );
+    else
+        MESSAGE( "PW_GAA buffer call=%lu where=%s ptr=%p query-failed error=%lu\n",
+                 call, where, buffer, GetLastError() );
