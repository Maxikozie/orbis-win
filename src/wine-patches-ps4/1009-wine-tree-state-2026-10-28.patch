+/* Resource cleanup; read the prefix setting once, without retaining a file. */
+int ps5_image_view_fd_release_enabled(void)
+{
+#ifdef __PROSPERO__
+    static int enabled = -1;
+    const char *value;
+    char buffer[3];
+    int file, result = 0, saved_errno = errno;
+    size_t count = 0;
+    ssize_t size = -1;
+
+    if (enabled != -1) return enabled;
+    if ((value = getenv( "WINE_PS5_IMAGE_VIEW_FD_RELEASE" )))
+        result = !strcmp( value, "1" );
+    else if (config_dir_fd != -1)
+    {
+        if ((file = openat( config_dir_fd, "pw_image_view_fd_release", O_RDONLY )) != -1)
+        {
+            while (count < sizeof(buffer) &&
+                   (size = read( file, buffer + count, sizeof(buffer) - count )) > 0)
+                count += size;
+            close( file );
+            result = size == 0 && (count == 1 || (count == 2 && buffer[1] == '\n')) &&
+                     buffer[0] == '1';
+        }
+        else if (errno == ENOENT) result = 1;
+    }
+    enabled = result;
+    fprintf( stderr, "wine-ps5: image-view fd release: %s\n", enabled ? "on" : "off" );
+    errno = saved_errno;
+    return enabled;
+#else
+    return 0;
+#endif
