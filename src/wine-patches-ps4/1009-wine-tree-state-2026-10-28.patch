+/* the layout of PwWineInput in wine/ps5/pw_wine_sink.h */
+struct ps5_input
+{
+    UINT type;              /* 1 key, 2 mouse move, 3 mouse button, 4 wheel */
+    UINT code;              /* virtual key, or button 0 left 1 right 2 middle */
+    INT  x, y;              /* mouse move: relative motion in desktop pixels */
+    UINT down;
+};
+
+enum { PS5_MAX_WINDOWS = 64, PS5_INPUT_BATCH = 64, PS5_MAX_PARTS = 32 };
+
+struct ps5_window
+{
+    HWND hwnd;
+    RECT visible;           /* screen coordinates */
+    BOOL shown;
+};
+
+static int (*present_frame)( const void *bgra, UINT width, UINT height, UINT stride );
+static int (*next_input)( struct ps5_input *input );
+static int (*input_fd)(void);
+
+static pthread_mutex_t screen_lock = PTHREAD_MUTEX_INITIALIZER;
+static UINT screen_width = 800, screen_height = 600;
+/* The display mode an application set, at most the desktop's. win32u maps
+ * a smaller mode onto the desktop scaled uniformly from its top left, so
+ * frames show that part, content_width x content_height, which the title
+ * then centres on the TV as it does any frame. */
+static UINT content_width, content_height;
+static UINT32 *screen;
+/* the desktop's top level windows, in its z order, the topmost first */
+static struct ps5_window windows[PS5_MAX_WINDOWS];
+static UINT window_count;
+static POINT cursor;
+/* The cursor image, straight-alpha ARGB, NULL when hidden; frame is the
+ * screen with the cursor drawn over it, what the title is given. */
+static UINT32 *cursor_image, *frame;
+static UINT cursor_width, cursor_height;
+static POINT cursor_hotspot;
+/* The cursor image's visible (non-transparent) pixels, in image coordinates */
+static RECT cursor_box;
+/* WINE_PS5_VIEW=window shows only the visible top-level windows' bounding
+ * box, which the title scales to the whole TV, instead of the desktop;
+ * view is what the last frame showed, in screen coordinates. */
+static BOOL view_windows;
+static RECT view;
+static BOOL display_published;
+static DWORD input_threads[PS5_MAX_WINDOWS];
+static UINT input_thread_count;
+
+static struct ps5_window *find_window( HWND hwnd )
+{
+    UINT i;
+    for (i = 0; i < window_count; i++) if (windows[i].hwnd == hwnd) return &windows[i];
+    return NULL;
+}
+
+/* screen_lock held */
+static void clear_screen_rect( const RECT *rect )
+{
+    RECT clip = {0, 0, screen_width, screen_height};
+    INT y;
+
+    if (!intersect_rect( &clip, &clip, rect )) return;
+    for (y = clip.top; y < clip.bottom; y++)
+        memset( screen + y * screen_width + clip.left, 0, (clip.right - clip.left) * 4 );
+}
+
+/* screen_lock held: blend the cursor into out, a width x height copy of
+ * the screen area whose top left is origin.  The pointer reaches every
+ * pixel, so at the right and bottom edges an arrow's hotspot would leave
+ * all but its tip outside the frame, and a centred hotspot would do so at
+ * every edge; the drawn cursor is moved just enough to stay whole, as a
+ * console's pointer does, while the pointer itself stays where it is. */
+static void draw_cursor( UINT32 *out, POINT origin, INT width, INT height )
+{
+    INT left = cursor.x - cursor_hotspot.x - origin.x, top = cursor.y - cursor_hotspot.y - origin.y, x, y;
+
+    left = max( min( left, width - cursor_box.right ), -cursor_box.left );
+    top = max( min( top, height - cursor_box.bottom ), -cursor_box.top );
+    for (y = max( top, 0 ); y < min( top + (INT)cursor_height, height ); y++)
+    {
+        const UINT32 *src = cursor_image + (y - top) * cursor_width;
+        UINT32 *dst = out + y * width;
+        for (x = max( left, 0 ); x < min( left + (INT)cursor_width, width ); x++)
+        {
+            UINT32 s = src[x - left], d = dst[x], a = s >> 24, blended = 0;
+            UINT shift;
+            if (!a) continue;
+            for (shift = 0; shift < 24; shift += 8)
+                blended |= ((((s >> shift) & 0xff) * a + ((d >> shift) & 0xff) * (255 - a)) / 255) << shift;
+            dst[x] = blended | 0xff000000;
+        }
+    }
+}
+
+/* screen_lock held: the part of the screen a frame shows */
+static RECT view_rect(void)
+{
+    RECT screen_rect = {0, 0, content_width, content_height}, box = {0, 0, 0, 0};
+    UINT i;
+
+    if (!view_windows) return screen_rect;
+    for (i = 0; i < window_count; i++)
+        if (windows[i].shown) union_rect( &box, &box, &windows[i].visible );
+    if (!intersect_rect( &box, &box, &screen_rect )) return screen_rect;
+    return box;
+}
+
+/* screen_lock held */
+static void present_screen(void)
+{
+    INT width, height, y;
+
+    if (!present_frame) return;
+    view = view_rect();
+    width = view.right - view.left;
+    height = view.bottom - view.top;
+    if ((!cursor_image || !frame) && width == (INT)screen_width && height == (INT)screen_height &&
+        !view.left && !view.top)
+    {
+        present_frame( screen, screen_width, screen_height, screen_width * 4 );
+        return;
+    }
+    if (!frame) return;
+    for (y = 0; y < height; y++)
+        memcpy( frame + y * width, screen + (view.top + y) * screen_width + view.left, width * 4 );
+    if (cursor_image) draw_cursor( frame, (POINT){view.left, view.top}, width, height );
+    present_frame( frame, width, height, width * 4 );
+}
+
+/***********************************************************************
+ *           display
+ */
+static UINT ps5_UpdateDisplayDevices( const struct gdi_device_manager *manager, void *param )
+{
+    struct pci_id pci_id = {0};
+    struct gdi_monitor monitor = {0};
+    DEVMODEW mode = {.dmSize = sizeof(mode)};
+
+    mode.dmFields = DM_DISPLAYORIENTATION | DM_BITSPERPEL | DM_PELSWIDTH | DM_PELSHEIGHT |
+                    DM_DISPLAYFLAGS | DM_DISPLAYFREQUENCY | DM_POSITION;
+    mode.dmDisplayOrientation = DMDO_DEFAULT;
+    mode.dmBitsPerPel = 32;
+    mode.dmPelsWidth = screen_width;
+    mode.dmPelsHeight = screen_height;
+    mode.dmDisplayFrequency = 60;
+
+    SetRect( &monitor.rc_monitor, 0, 0, screen_width, screen_height );
+    monitor.rc_work = monitor.rc_monitor;
+
+    manager->add_gpu( "PS5", &pci_id, NULL, param );
+    manager->add_source( "PS5", DISPLAY_DEVICE_ATTACHED_TO_DESKTOP | DISPLAY_DEVICE_PRIMARY_DEVICE,
+                         NtUserGetSystemDpiForProcess( NULL ), param );
+    manager->add_monitor( &monitor, param );
+    manager->add_modes( &mode, 1, &mode, param );
+    return STATUS_SUCCESS;
+}
+
+/* An application's display mode, one win32u offers below the desktop's
+ * (Warcraft III plays its cinematics at 800x600): win32u keeps it and maps
+ * the application's windows onto the desktop, and frames show the part the
+ * mode covers there. */
+static LONG ps5_ChangeDisplaySettings( DEVMODEW *displays, const WCHAR *primary_name, HWND hwnd, DWORD flags,
+                                       void *param )
+{
+    DEVMODEW *mode;
+
+    for (mode = displays; mode->dmSize; mode = (DEVMODEW *)((char *)(mode + 1) + mode->dmDriverExtra))
+    {
+        UINT width, height;
+
+        if (wcsicmp( mode->dmDeviceName, primary_name )) continue;
+        width = (mode->dmFields & DM_PELSWIDTH) ? mode->dmPelsWidth : screen_width;
+        height = (mode->dmFields & DM_PELSHEIGHT) ? mode->dmPelsHeight : screen_height;
+        if (!width || !height || width > screen_width || height > screen_height) return DISP_CHANGE_BADMODE;
+        if (flags & CDS_TEST) return DISP_CHANGE_SUCCESSFUL;
+        pthread_mutex_lock( &screen_lock );
+        /* scaled uniformly to fit the desktop, as win32u maps it */
+        if ((UINT64)width * screen_height <= (UINT64)height * screen_width)
+        {
+            content_width = (UINT)((UINT64)width * screen_height / height);
+            content_height = screen_height;
+        }
+        else
+        {
+            content_width = screen_width;
+            content_height = (UINT)((UINT64)height * screen_width / width);
+        }
+        TRACE( "mode %ux%u shown as %ux%u\n", width, height, content_width, content_height );
+        present_screen();
+        pthread_mutex_unlock( &screen_lock );
+    }
+    return DISP_CHANGE_SUCCESSFUL;
+}
+
+/***********************************************************************
+ *           window surfaces
+ */
+/* The screen holds one composed image, so a window must not draw over the
+ * windows above it: a_minus_b splits the part of a that b leaves, into at
+ * most four rectangles, and unoccluded_parts repeats that for every window
+ * above the one being drawn. */
+static UINT a_minus_b( RECT *out, const RECT *a, const RECT *b )
+{
+    RECT overlap;
+    UINT count = 0;
+
+    if (!intersect_rect( &overlap, a, b ))
+    {
+        out[0] = *a;
+        return 1;
+    }
+    if (a->top < overlap.top)
+        SetRect( &out[count++], a->left, a->top, a->right, overlap.top );
+    if (overlap.bottom < a->bottom)
+        SetRect( &out[count++], a->left, overlap.bottom, a->right, a->bottom );
+    if (a->left < overlap.left)
+        SetRect( &out[count++], a->left, overlap.top, overlap.left, overlap.bottom );
+    if (overlap.right < a->right)
+        SetRect( &out[count++], overlap.right, overlap.top, a->right, overlap.bottom );
+    return count;
+}
+
+/* screen_lock held: the parts of rect that the windows above index z leave
+ * visible.  windows is in the desktop's z order, the topmost first. */
+static UINT unoccluded_parts( RECT *parts, UINT max, const RECT *rect, UINT z )
+{
+    UINT count = 1, above, i, n;
+
+    parts[0] = *rect;
+    for (above = 0; above < z && count; above++)
+    {
+        RECT next[PS5_MAX_PARTS];
+
+        if (!windows[above].shown) continue;
+        for (i = 0, n = 0; i < count; i++)
+        {
+            RECT split[4];
+            UINT split_count = a_minus_b( split, &parts[i], &windows[above].visible ), j;
+
+            /* Too many fragments to track: rather than lose the window's own
+             * pixels, stop clipping here and leave the parts found so far. */
+            if (n + split_count > max) return count;
+            for (j = 0; j < split_count; j++) next[n++] = split[j];
+        }
+        memcpy( parts, next, n * sizeof(*parts) );
+        count = n;
+    }
+    return count;
+}
+
+/* screen_lock held: the parts of rect that no shown window other than the one
+ * at index skip covers. */
+static UINT unowned_parts( RECT *parts, UINT max, const RECT *rect, UINT skip )
+{
+    UINT count = 1, i, j, n;
+
+    parts[0] = *rect;
+    for (i = 0; i < window_count && count; i++)
+    {
+        RECT next[PS5_MAX_PARTS];
+
+        if (i == skip || !windows[i].shown) continue;
+        for (j = 0, n = 0; j < count; j++)
+        {
+            RECT split[4];
+            UINT split_count = a_minus_b( split, &parts[j], &windows[i].visible ), k;
+
+            if (n + split_count > max) return count;
+            for (k = 0; k < split_count; k++) next[n++] = split[k];
+        }
+        memcpy( parts, next, n * sizeof(*parts) );
+        count = n;
+    }
+    return count;
+}
+
+/* screen_lock held: the window at index z gives up rect, because it is hiding,
+ * moving or going away.  Only the parts no other window owns are cleared: a
+ * window above it still owns its pixels there, and blanking them would erase a
+ * frame nothing will paint again.  A window below it had been covered, so the
+ * screen holds this window's pixels rather than its own; it is named in repaint
+ * and the caller invalidates it once the lock is dropped. */
+static UINT give_up_screen_rect( const RECT *rect, UINT z, HWND *repaint, UINT max )
+{
+    RECT parts[PS5_MAX_PARTS], overlap;
+    UINT count = unowned_parts( parts, ARRAY_SIZE(parts), rect, z ), i, n = 0;
+
+    for (i = 0; i < count; i++) clear_screen_rect( &parts[i] );
+    for (i = z + 1; i < window_count && n < max; i++)
+        if (windows[i].shown && intersect_rect( &overlap, rect, &windows[i].visible ))
+            repaint[n++] = windows[i].hwnd;
+    return n;
+}
+
+static void ps5_surface_set_clip( struct window_surface *surface, const RECT *rects, UINT count )
+{
+}
+
+static BOOL ps5_surface_flush( struct window_surface *surface, const RECT *rect, const RECT *dirty,
+                               const BITMAPINFO *color_info, const void *color_bits, BOOL shape_changed,
+                               const BITMAPINFO *shape_info, const void *shape_bits )
+{
+    struct ps5_window *window;
+    UINT stride = color_info->bmiHeader.biWidth * 4;
+    RECT target, clip = {0, 0, screen_width, screen_height};
+    RECT parts[PS5_MAX_PARTS];
+    UINT count = 0, i;
+    INT y;
+
+    pthread_mutex_lock( &screen_lock );
+    if ((window = find_window( surface->hwnd )) && window->shown)
+    {
+        /* dirty is relative to the surface, whose origin is the visible rect's */
+        target = *dirty;
+        OffsetRect( &target, window->visible.left, window->visible.top );
+        if (intersect_rect( &target, &target, &clip ) && intersect_rect( &target, &target, &window->visible ))
+            count = unoccluded_parts( parts, ARRAY_SIZE(parts), &target, window - windows );
+
+        for (i = 0; i < count; i++)
+        {
+            for (y = parts[i].top; y < parts[i].bottom; y++)
+            {
+                const BYTE *src = (const BYTE *)color_bits + (y - window->visible.top) * stride +
+                                  (parts[i].left - window->visible.left) * 4;
+                memcpy( screen + y * screen_width + parts[i].left, src,
+                        (parts[i].right - parts[i].left) * 4 );
+            }
+        }
+        if (count) present_screen();
+    }
+    pthread_mutex_unlock( &screen_lock );
+    return TRUE;
+}
+
+static void ps5_surface_destroy( struct window_surface *surface )
+{
+}
+
+static const struct window_surface_funcs ps5_surface_funcs =
+{
+    ps5_surface_set_clip,
+    ps5_surface_flush,
+    ps5_surface_destroy
+};
+
+static BOOL ps5_CreateWindowSurface( HWND hwnd, BOOL layered, const RECT *surface_rect,
+                                     struct window_surface **surface )
+{
+    char buffer[FIELD_OFFSET( BITMAPINFO, bmiColors[256] )];
+    BITMAPINFO *info = (BITMAPINFO *)buffer;
+    struct window_surface *previous = *surface;
+
+    if (previous && previous->funcs == &ps5_surface_funcs && EqualRect( &previous->rect, surface_rect ))
+        return TRUE;
+
+    memset( info, 0, sizeof(*info) );
+    info->bmiHeader.biSize        = sizeof(info->bmiHeader);
+    info->bmiHeader.biWidth       = surface_rect->right - surface_rect->left;
+    info->bmiHeader.biHeight      = -(surface_rect->bottom - surface_rect->top); /* top-down */
+    info->bmiHeader.biPlanes      = 1;
+    info->bmiHeader.biBitCount    = 32;
+    info->bmiHeader.biSizeImage   = get_dib_image_size( info );
+    info->bmiHeader.biCompression = BI_RGB;
+
+    *surface = window_surface_create( sizeof(**surface), &ps5_surface_funcs, hwnd, surface_rect, info, 0 );
+    if (previous) window_surface_release( previous );
+    return TRUE;
+}
+
+/***********************************************************************
+ *           windows
+ */
+/* Let the server wake this thread when the title posts input, as a
+ * display connection's fd does for the other drivers. Once per thread. */
+static void register_input_fd(void)
+{
+    DWORD tid = GetCurrentThreadId();
+    static HANDLE handle;
+    static pthread_mutex_t handle_lock = PTHREAD_MUTEX_INITIALIZER;
+    NTSTATUS status;
+    UINT i;
+    int fd;
+
+    if (!input_fd || (fd = input_fd()) == -1) return;
+    pthread_mutex_lock( &screen_lock );
+    for (i = 0; i < input_thread_count; i++) if (input_threads[i] == tid) break;
+    if (i < input_thread_count || input_thread_count == PS5_MAX_WINDOWS)
+    {
+        pthread_mutex_unlock( &screen_lock );
+        return;
+    }
+    input_threads[input_thread_count++] = tid;
+    pthread_mutex_unlock( &screen_lock );
+
+    /* One persistent handle owns the title's shared wake pipe. Queue poll
+     * objects borrow it; creating separate file owners would double-close it. */
+    pthread_mutex_lock( &handle_lock );
+    status = handle ? 0 : wine_server_fd_to_handle( fd, GENERIC_READ | SYNCHRONIZE, 0, &handle );
+    pthread_mutex_unlock( &handle_lock );
+    if (status) { WARN( "input fd registration failed %#x\n", status ); return; }
+    SERVER_START_REQ( set_queue_fd )
+    {
+        req->handle = wine_server_obj_handle( handle );
+        status = wine_server_call( req );
+    }
+    SERVER_END_REQ;
+    TRACE( "input queue tid=%04x fd=%d status=%#x\n", tid, fd, status );
+}
+
+static BOOL ps5_CreateWindow( HWND hwnd )
+{
+    register_input_fd();
+    return TRUE;
+}
+
+/* No lock held, this calls back into win32u: sort windows into the desktop's
+ * z order, the topmost first, so that a flush knows which windows are above
+ * the one it draws.  A window the desktop no longer lists keeps its place
+ * until DestroyWindow removes it. */
+static void update_z_order(void)
+{
+    HWND *children = list_window_children( get_desktop_window() );
+    UINT next = 0, i, j;
+
+    if (!children) return;
+    pthread_mutex_lock( &screen_lock );
+    for (i = 0; children[i] && next < window_count; i++)
+    {
+        for (j = next; j < window_count; j++) if (windows[j].hwnd == children[i]) break;
+        if (j == window_count) continue;
+        if (j != next)
+        {
+            struct ps5_window moved = windows[j];
+            windows[j] = windows[next];
+            windows[next] = moved;
+        }
+        next++;
+    }
+    pthread_mutex_unlock( &screen_lock );
+    free( children );
+}
+
+static void ps5_WindowPosChanged( HWND hwnd, HWND insert_after, HWND owner_hint, UINT swp_flags,
+                                  const struct window_rects *new_rects, struct window_surface *surface )
+{
+    struct ps5_window *window;
+    BOOL shown = (NtUserGetWindowLongW( hwnd, GWL_STYLE ) & WS_VISIBLE) &&
+                 NtUserGetAncestor( hwnd, GA_PARENT ) == get_desktop_window();
+    HWND uncovered[PS5_MAX_WINDOWS];
+    UINT uncovered_count = 0, i;
+    BOOL repaint = FALSE;
+
+    pthread_mutex_lock( &screen_lock );
+    if (!(window = find_window( hwnd )) && shown && window_count < PS5_MAX_WINDOWS)
+    {
+        window = &windows[window_count++];
+        window->hwnd = hwnd;
+        window->shown = FALSE;
+    }
+    if (window)
+    {
+        if (window->shown && (!shown || !EqualRect( &window->visible, &new_rects->visible )))
+        {
+            uncovered_count = give_up_screen_rect( &window->visible, window - windows,
+                                                   uncovered, ARRAY_SIZE(uncovered) );
+            present_screen();
+        }
+        /* a window just shown may have painted before it had this surface */
+        repaint = shown && !window->shown;
+        window->visible = new_rects->visible;
+        window->shown = shown;
+    }
+    pthread_mutex_unlock( &screen_lock );
+    update_z_order();
+    for (i = 0; i < uncovered_count; i++)
+        NtUserRedrawWindow( uncovered[i], NULL, 0, RDW_INVALIDATE | RDW_ERASE | RDW_FRAME | RDW_ALLCHILDREN );
+    if (repaint) NtUserRedrawWindow( hwnd, NULL, 0, RDW_INVALIDATE | RDW_ERASE | RDW_FRAME | RDW_ALLCHILDREN );
+}
+
+static void ps5_DestroyWindow( HWND hwnd )
+{
+    struct ps5_window *window;
+    HWND uncovered[PS5_MAX_WINDOWS];
+    UINT uncovered_count = 0, i;
+
+    pthread_mutex_lock( &screen_lock );
+    if ((window = find_window( hwnd )))
+    {
+        if (window->shown)
+        {
+            uncovered_count = give_up_screen_rect( &window->visible, window - windows,
+                                                   uncovered, ARRAY_SIZE(uncovered) );
+            present_screen();
+        }
+        /* close the gap, keeping the rest of the z order */
+        memmove( window, window + 1, (windows + --window_count - window) * sizeof(*window) );
+    }
+    pthread_mutex_unlock( &screen_lock );
+    for (i = 0; i < uncovered_count; i++)
+        NtUserRedrawWindow( uncovered[i], NULL, 0, RDW_INVALIDATE | RDW_ERASE | RDW_FRAME | RDW_ALLCHILDREN );
+}
+
+/* No explorer sizes the desktop the server created: make it the monitor. */
+static void ps5_SetDesktopWindow( HWND hwnd )
+{
+    RECT rect = {0, 0, screen_width, screen_height};
+
+    SERVER_START_REQ( set_window_pos )
+    {
+        req->handle    = wine_server_user_handle( hwnd );
+        req->previous  = 0;
+        req->swp_flags = SWP_NOZORDER;
+        req->window    = wine_server_rectangle( rect );
+        req->client    = req->window;
+        wine_server_call( req );
+    }
+    SERVER_END_REQ;
+
+    /* the prefix may hold another driver's display config: publish ours,
+     * which also gives the server the monitor that bounds the cursor */
+    if (!display_published)
+    {
+        display_published = TRUE;
+        update_display_cache( TRUE );
+    }
+}
+
+/***********************************************************************
+ *           input
+ */
+/* the most recently shown top-level window, or 0 */
+static HWND last_shown_window(void)
+{
+    HWND hwnd = 0;
+    UINT i;
+
+    pthread_mutex_lock( &screen_lock );
+    for (i = window_count; i > 0; i--)
+        if (windows[i - 1].shown) { hwnd = windows[i - 1].hwnd; break; }
+    pthread_mutex_unlock( &screen_lock );
+    return hwnd;
+}
+
+/* Windows wheel messages carry a signed 16-bit delta; cap a single poll
+ * before multiplying so rapid free-spin or a corrupt report cannot wrap. */
+static void send_wheel( HWND hwnd, INT ticks )
+{
+    INPUT input = {.type = INPUT_MOUSE};
+
+    input.mi.dwFlags = MOUSEEVENTF_WHEEL;
+    input.mi.mouseData = (DWORD)(min( max( ticks, -273 ), 273 ) * WHEEL_DELTA);
+    NtUserSendHardwareInput( hwnd, 0, &input, 0 );
+}
+
+static void send_mouse( HWND hwnd, DWORD flags, INT x, INT y )
+{
+    INPUT input = {.type = INPUT_MOUSE};
+
+    input.mi.dx = x;
+    input.mi.dy = y;
+    input.mi.dwFlags = flags;
+    NtUserSendHardwareInput( hwnd, 0, &input, 0 );
+}
+
+/* The pointer's position as the server keeps it, in screen coordinates. */
+static BOOL server_cursor_pos( POINT *pos )
+{
+    struct object_lock lock = OBJECT_LOCK_INIT;
+    const desktop_shm_t *desktop_shm;
+    NTSTATUS status;
+
+    while ((status = get_shared_desktop( &lock, &desktop_shm )) == STATUS_PENDING)
+    {
+        pos->x = desktop_shm->cursor.x;
+        pos->y = desktop_shm->cursor.y;
+    }
+    return !status;
+}
+
+/* delta along one axis from pos, stopped at a shown edge (low or high - 1)
+ * that is not the screen's own (0 or screen_high - 1) */
+static INT shown_motion( INT pos, INT delta, INT low, INT high, INT screen_high )
+{
+    if (delta < 0 && low > 0 && pos + delta < low) return min( low - pos, 0 );
+    if (delta > 0 && high < screen_high && pos + delta > high - 1) return max( high - 1 - pos, 0 );
+    return delta;
+}
+
+/* The title's mouse and stick move the pointer by relative motion, as a
+ * mouse does. The server keeps it inside ClipCursor's rectangle and still
+ * reports the motion (WM_INPUT, WM_MOUSEMOVE) while it is held against an
+ * edge, which is what scrolls a strategy game's map, and SetCursorPos moves
+ * the same pointer, as mouse look expects. Where a frame shows only part of
+ * the screen (one window, or a smaller display mode), it stops at what is
+ * shown. It starts in the middle of the first frame. */
+static void move_cursor( HWND hwnd, INT dx, INT dy )
+{
+    static BOOL placed;
+    RECT shown;
+    POINT pos;
+
+    pthread_mutex_lock( &screen_lock );
+    shown = view;
+    pthread_mutex_unlock( &screen_lock );
+    /* win32u coalesces a driver's motion until a button or NOCOALESCE sends
+     * it; each move goes to the server now, so the position read back is it */
+    if (!placed)
+    {
+        placed = TRUE;
+        send_mouse( hwnd, MOUSEEVENTF_MOVE | MOUSEEVENTF_ABSOLUTE | MOUSEEVENTF_MOVE_NOCOALESCE,
+                    (shown.left + shown.right) / 2, (shown.top + shown.bottom) / 2 );
+    }
+    if (!server_cursor_pos( &pos )) return;
+    dx = shown_motion( pos.x, dx, shown.left, shown.right, screen_width );
+    dy = shown_motion( pos.y, dy, shown.top, shown.bottom, screen_height );
+    if (dx || dy) send_mouse( hwnd, MOUSEEVENTF_MOVE | MOUSEEVENTF_MOVE_NOCOALESCE, dx, dy );
+    if (!server_cursor_pos( &pos )) return;
+    pthread_mutex_lock( &screen_lock );
+    if (cursor.x != pos.x || cursor.y != pos.y)
+    {
+        cursor = pos;
+        if (cursor_image) present_screen();     /* the pointer moved on screen */
+    }
+    pthread_mutex_unlock( &screen_lock );
+}
+
+static BOOL ps5_ProcessEvents( DWORD mask )
+{
+    static const DWORD button_flags[3][2] =
+    {
+        {MOUSEEVENTF_LEFTUP, MOUSEEVENTF_LEFTDOWN},
+        {MOUSEEVENTF_RIGHTUP, MOUSEEVENTF_RIGHTDOWN},
+        {MOUSEEVENTF_MIDDLEUP, MOUSEEVENTF_MIDDLEDOWN},
+    };
+    struct ps5_input event;
+    HWND hwnd = NtUserGetForegroundWindow();
+    UINT processed = 0;
+    BOOL wakeup = FALSE;
+
+    if (!next_input) return FALSE;
+    if (!hwnd && (hwnd = last_shown_window()))
+    {
+        /* no window manager activates windows here: the newest one gets
+         * the foreground, so keyboard input has somewhere to go */
+        NtUserSetForegroundWindow( hwnd );
+    }
+    if (input_fd)
+    {
+        /* drain the wake pipe first: input posted from now on wakes again */
+        char buffer[64];
+        int fd = input_fd();
+        if (fd != -1)
+        {
+#ifdef __PROSPERO__
+            /* PS4 refuses non-blocking mode. A second unconditional read
+             * would park the UI thread after draining the available bytes. */
+            struct pollfd wake = { fd, POLLIN, 0 };
+            while (poll( &wake, 1, 0 ) > 0 && (wake.revents & POLLIN))
+            {
+                if (read( fd, buffer, sizeof(buffer) ) <= 0) break;
+                wakeup = TRUE;
+            }
+#else
+            while (read( fd, buffer, sizeof(buffer) ) > 0) wakeup = TRUE;
+#endif
+        }
+    }
+    while (processed < PS5_INPUT_BATCH && next_input( &event ))
+    {
+        INPUT input = {.type = INPUT_KEYBOARD};
+
+        processed++;
+        switch (event.type)
+        {
+        case 1:
+            input.ki.wVk = event.code;
+            input.ki.wScan = NtUserMapVirtualKeyEx( event.code, MAPVK_VK_TO_VSC, NtUserGetKeyboardLayout( 0 ));
+            input.ki.dwFlags = event.down ? 0 : KEYEVENTF_KEYUP;
+            switch (event.code)
+            {
+            case VK_UP:
+            case VK_DOWN:
+            case VK_LEFT:
+            case VK_RIGHT:
+            case VK_INSERT:
+            case VK_DELETE:
+            case VK_HOME:
+            case VK_END:
+            case VK_PRIOR:
+            case VK_NEXT:
+            case VK_RCONTROL:
+            case VK_RMENU:
+            case VK_LWIN:
+            case VK_RWIN:
+            case VK_APPS:
+            case VK_DIVIDE:
+                input.ki.dwFlags |= KEYEVENTF_EXTENDEDKEY;
+                break;
+            }
+            {
+                NTSTATUS status = NtUserSendHardwareInput( hwnd, 0, &input, 0 );
+                TRACE( "key hwnd=%p vk=%#x scan=%#x down=%u status=%#x\n",
+                       hwnd, input.ki.wVk, input.ki.wScan, event.down, status );
+            }
+            break;
+        case 2:
+            move_cursor( hwnd, event.x, event.y );
+            break;
+        case 3:
+            if (event.code < 3) send_mouse( hwnd, button_flags[event.code][event.down != 0], 0, 0 );
+            break;
+        case 4:
+            if (event.x) send_wheel( hwnd, event.x );
+            break;
+        }
+    }
+    /* A thread can consume the shared wake pipe after another GUI thread
+     * already took the queued input. Report the wake as handled anyway, so
+     * win32u clears QS_DRIVER and rearms this queue's fd. */
+    return processed != 0 || wakeup;
+}
+
+/***********************************************************************
+ *           cursor
+ */
+/* A monochrome cursor: the mask bitmap holds the AND mask over the XOR mask.
+ * Invert pixels cannot be drawn over a copy of the screen: they are black.
+ * Adapted from winewayland.drv, itself from wineandroid.drv. */
+static UINT32 *mono_cursor( HBITMAP bitmap, UINT *width, UINT *height )
+{
+    BITMAP bm;
+    BYTE *mask = NULL;
+    UINT32 *image = NULL;
+    UINT stride, i, j;
+
+    if (!NtGdiExtGetObjectW( bitmap, sizeof(bm), &bm ) || bm.bmHeight < 2) return NULL;
+    stride = ((bm.bmWidth + 15) >> 3) & ~1;
+    if (!(mask = malloc( stride * bm.bmHeight )) ||
+        !NtGdiGetBitmapBits( bitmap, stride * bm.bmHeight, mask ) ||
+        !(image = malloc( bm.bmWidth * (bm.bmHeight / 2) * 4 )))
+        goto done;
+    *width = bm.bmWidth;
+    *height = bm.bmHeight / 2;
+    for (i = 0; i < *height; i++)
+        for (j = 0; j < *width; j++)
+        {
+            int and = (mask[i * stride + j / 8] << (j % 8)) & 0x80;
+            int xor = (mask[(i + *height) * stride + j / 8] << (j % 8)) & 0x80;
+            image[i * *width + j] = and && !xor ? 0 : xor && !and ? 0xffffffff : 0xff000000;
+        }
+done:
+    free( mask );
+    return image;
+}
+
+/* A color cursor, its alpha from the bitmap or else from the mask. */
+static UINT32 *color_cursor( HDC hdc, HBITMAP color, HBITMAP mask, UINT *width, UINT *height )
+{
+    char buffer[FIELD_OFFSET( BITMAPINFO, bmiColors[256] )];
+    BITMAPINFO *info = (BITMAPINFO *)buffer;
+    BYTE *mask_bits = NULL;
+    UINT32 *image = NULL;
+    BOOL has_alpha = FALSE;
+    BITMAP bm;
+    UINT i, j;
+
+    if (!NtGdiExtGetObjectW( color, sizeof(bm), &bm )) return NULL;
+    memset( info, 0, sizeof(info->bmiHeader) );
+    info->bmiHeader.biSize = sizeof(info->bmiHeader);
+    info->bmiHeader.biWidth = bm.bmWidth;
+    info->bmiHeader.biHeight = -bm.bmHeight;
+    info->bmiHeader.biPlanes = 1;
+    info->bmiHeader.biBitCount = 32;
+    info->bmiHeader.biCompression = BI_RGB;
+    info->bmiHeader.biSizeImage = bm.bmWidth * bm.bmHeight * 4;
+    if (!(image = malloc( info->bmiHeader.biSizeImage )) ||
+        !NtGdiGetDIBitsInternal( hdc, color, 0, bm.bmHeight, image, info, DIB_RGB_COLORS, 0, 0 ))
+        goto failed;
+    for (i = 0; i < (UINT)(bm.bmWidth * bm.bmHeight) && !has_alpha; i++)
+        has_alpha = (image[i] & 0xff000000) != 0;
+    if (!has_alpha)
+    {
+        UINT width_bytes = (bm.bmWidth + 31) / 32 * 4;
+        info->bmiHeader.biBitCount = 1;
+        info->bmiHeader.biSizeImage = width_bytes * bm.bmHeight;
+        if (!(mask_bits = malloc( info->bmiHeader.biSizeImage )) ||
+            !NtGdiGetDIBitsInternal( hdc, mask, 0, bm.bmHeight, mask_bits, info, DIB_RGB_COLORS, 0, 0 ))
+            goto failed;
+        for (i = 0; i < (UINT)bm.bmHeight; i++)
+            for (j = 0; j < (UINT)bm.bmWidth; j++)
+                if (!((mask_bits[i * width_bytes + j / 8] << (j % 8)) & 0x80))
+                    image[i * bm.bmWidth + j] |= 0xff000000;
+                else
+                    image[i * bm.bmWidth + j] = 0;
+        free( mask_bits );
+    }
+    *width = bm.bmWidth;
+    *height = bm.bmHeight;
+    return image;
+failed:
+    free( mask_bits );
+    free( image );
+    return NULL;
+}
+
+/* The bounding box of an image's non-transparent pixels, empty if none */
+static RECT visible_box( const UINT32 *image, UINT width, UINT height )
+{
+    RECT box = {width, height, 0, 0};
+    UINT x, y;
+
+    for (y = 0; y < height; y++)
+        for (x = 0; x < width; x++)
+        {
+            if (!(image[y * width + x] >> 24)) continue;
+            box.left = min( box.left, (LONG)x );
+            box.top = min( box.top, (LONG)y );
+            box.right = max( box.right, (LONG)x + 1 );
+            box.bottom = max( box.bottom, (LONG)y + 1 );
+        }
+    if (box.right <= box.left) SetRectEmpty( &box );
+    return box;
+}
+
+static void ps5_SetCursor( HWND hwnd, HCURSOR handle )
+{
+    UINT32 *image = NULL, *old;
+    UINT width = 0, height = 0;
+    ICONINFO info;
+    RECT box = {0, 0, 0, 0};
+
+    if (handle && NtUserGetIconInfo( handle, &info, NULL, NULL, NULL, 0 ))
+    {
+        if (info.hbmColor)
+        {
+            HDC hdc = NtGdiCreateCompatibleDC( 0 );
+            image = color_cursor( hdc, info.hbmColor, info.hbmMask, &width, &height );
+            NtGdiDeleteObjectApp( hdc );
+            NtGdiDeleteObjectApp( info.hbmColor );
+        }
+        else image = mono_cursor( info.hbmMask, &width, &height );
+        if (info.hbmMask) NtGdiDeleteObjectApp( info.hbmMask );
+        if (image && (info.xHotspot >= width || info.yHotspot >= height))
+            info.xHotspot = info.yHotspot = 0;
+        if (image) box = visible_box( image, width, height );
+    }
+    pthread_mutex_lock( &screen_lock );
+    old = cursor_image;
+    cursor_image = image;
+    cursor_width = width;
+    cursor_height = height;
+    cursor_box = box;
+    if (image) cursor_hotspot = (POINT){info.xHotspot, info.yHotspot};
+    if (old || image) present_screen();
+    pthread_mutex_unlock( &screen_lock );
+    free( old );
+    TRACE( "cursor %p: %ux%u\n", handle, width, height );
+}
+
+/* For OpenGL frames, which reach the screen without this driver's
+ * composition: the cursor image (straight-alpha ARGB, NULL when hidden),
+ * its size and where its top-left corner is on the screen. The image stays
+ * valid until ps5drv_unlock_cursor(). */
+const UINT32 *ps5drv_lock_cursor( UINT *width, UINT *height, POINT *top_left )
+{
+    pthread_mutex_lock( &screen_lock );
+    *width = cursor_width;
+    *height = cursor_height;
+    top_left->x = cursor.x - cursor_hotspot.x;
+    top_left->y = cursor.y - cursor_hotspot.y;
+    return cursor_image;
+}
+
+void ps5drv_unlock_cursor(void)
+{
+    pthread_mutex_unlock( &screen_lock );
+}
+
+#ifdef SONAME_LIBVULKAN
+/* Vulkan frames reach the screen through the GPU driver's own video output
+ * (patch 0460), which this driver does not compose, so after each present
+ * libvulkan.prx shows the cursor with VideoOut's hardware cursor
+ * (pw_videoout_cursor): the image, NULL when hidden, at its place on the
+ * desktop, which the output shows whole. */
+void ps5drv_vulkan_cursor( void *vulkan_handle )
+{
+    static int (*show)( const UINT32 *, UINT, UINT, INT, INT, UINT, UINT );
+    static BOOL looked;
+    static BOOL reported, last_visible;
+    static int last_result;
+    const UINT32 *image;
+    UINT width, height;
+    POINT top_left;
+
+    if (!looked)
+    {
+        looked = TRUE;
+        show = dlsym( vulkan_handle, "pw_videoout_cursor" );
+    }
+    if (!show)
+    {
+        if (!reported) ERR( "PW_VK_CURSOR missing pw_videoout_cursor export\n" );
+        reported = TRUE;
+        return;
+    }
+    image = ps5drv_lock_cursor( &width, &height, &top_left );
+    {
+        BOOL visible = image && width && height;
+        int result = show( visible ? image : NULL, width, height, top_left.x, top_left.y,
+                           screen_width, screen_height );
+
+        if (!reported || visible != last_visible || result != last_result)
+            ERR( "PW_VK_CURSOR visible=%u image=%p size=%ux%u pos=%d,%d desktop=%ux%u result=%d\n",
+                 visible, image, width, height, top_left.x, top_left.y, screen_width,
+                 screen_height, result );
+        reported = TRUE;
+        last_visible = visible;
+        last_result = result;
+    }
+    ps5drv_unlock_cursor();
+}
