+    RECORD( glBindTexture );
+    RECORD( glEnable );
+    RECORD( glDisable );
+    RECORD( glTexEnvf );
+    RECORD( glTexEnvi );
+    RECORD( glBlendFunc );
+    RECORD( glDepthMask );
+    RECORD( glDepthFunc );
+    RECORD( glDepthRange );
+    RECORD( glAlphaFunc );
+    RECORD( glShadeModel );
+    RECORD( glCullFace );
+    RECORD( glFrontFace );
