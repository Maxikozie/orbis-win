+/* A composition swapchain is one that has no window: the caller means to hand
+ * its buffers to DirectComposition and let the compositor place them. There is
+ * no compositor here, and there is no window system either -- the ps5 driver
+ * answers every surface request with a headless surface whatever HWND it is
+ * given (dlls/win32u/ps5drv.c), and RADV scans that out with
+ * sceVideoOutSubmitFlip. The window a composition swapchain lacks is therefore
+ * the one thing it costs nothing to invent, and inventing it is the whole
+ * difference between a swapchain and E_NOTIMPL.
+ *
+ * GTA IV reaches this through 1911.dll, which creates a DirectComposition
+ * device and then asks for its swapchain here. With the stub it received none,
+ * presented nothing, and spun on a full core with the screen never painted.
+ *
+ * ⚠ The window outlives the swapchain. Releasing a swapchain does not come
+ * back through the factory, so there is nowhere to destroy it from; one
+ * desktop child per composition swapchain is left behind. Games create these
+ * once, so the cost is bounded, and leaking a window is better than failing
+ * the call -- but a caller that recreates its swapchain per resize would
+ * accumulate them. */
 static HRESULT STDMETHODCALLTYPE dxgi_factory_CreateSwapChainForComposition(IWineDXGIFactory *iface,
         IUnknown *device, const DXGI_SWAP_CHAIN_DESC1 *desc, IDXGIOutput *output, IDXGISwapChain1 **swapchain)
 {
-    FIXME("iface %p, device %p, desc %p, output %p, swapchain %p stub!\n",
+    DXGI_SWAP_CHAIN_FULLSCREEN_DESC fullscreen_desc = {.Windowed = TRUE};
+    unsigned int width, height;
+    HWND window;
+    HRESULT hr;
+
+    TRACE("iface %p, device %p, desc %p, output %p, swapchain %p.\n",
             iface, device, desc, output, swapchain);
 
-    return E_NOTIMPL;
+    if (!device || !desc || !swapchain)
+    {
+        WARN("Invalid pointer.\n");
+        return DXGI_ERROR_INVALID_CALL;
+    }
+
+    /* A zero extent means "ask the window", and the window is ours, so it has
+     * to be the desktop rather than whatever a default-sized popup came out as. */
+    if (!(width = desc->Width)) width = GetSystemMetrics(SM_CXSCREEN);
+    if (!(height = desc->Height)) height = GetSystemMetrics(SM_CYSCREEN);
+
+    if (!(window = CreateWindowExW(WS_EX_NOACTIVATE, L"Static", NULL, WS_POPUP,
+            0, 0, width, height, NULL, NULL, NULL, NULL)))
+    {
+        ERR("Failed to create a window for a composition swapchain.\n");
+        return DXGI_ERROR_UNSUPPORTED;
+    }
+
+    hr = IWineDXGIFactory_CreateSwapChainForHwnd(iface, device, window, desc,
+            &fullscreen_desc, output, swapchain);
+    if (FAILED(hr)) DestroyWindow( window );
+    return hr;
 }
 
