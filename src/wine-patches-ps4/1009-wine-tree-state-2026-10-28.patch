+                    for (i = 0; i < 128 && probe[1] != -1; i++)
+                    {
+                        unsigned int word, cs[6], debug[8], dup = 0;
+                        char name[48];
+                        if (!ps5_peek( probe, esp + 4 * i, &word, sizeof(word) )) break;
+                        if (word < 0x10000 || word >= 0x7fff0000 || (word & 3)) continue;
+                        for (k = 0; k < nseen; k++) dup |= seen[k] == word;
+                        if (dup) continue;
+                        if (!ps5_peek( probe, word, cs, sizeof(cs) )) continue;
+                        if (cs[0] < 0x10000 || cs[0] >= 0x7fff0000 || cs[0] == 0xffffffff) continue;
+                        if (!ps5_peek( probe, cs[0], debug, sizeof(debug) ) || debug[1] != word) continue;
+                        if (nseen < 16) seen[nseen++] = word;
+                        name[0] = 0;
+                        /* Wine keeps the section's name in DebugInfo->Spare[0], dword 6 in i386 */
+                        if (debug[6] && ps5_peek( probe, debug[6], name, sizeof(name) - 1 )) name[sizeof(name) - 1] = 0;
+                        else name[0] = 0;
+                        fprintf( stderr, "wine-ps5: guest tid=%04x cs=%08x name=%.40s lock=%d recursion=%d owner=%04x sem=%08x\n",
+                                 thread->id, word, name[0] ? name : "-", (int)cs[1], (int)cs[2], cs[3], cs[4] );
+                    }
+                }
+            }
+        }
+    }
+    {
+        struct process *last = NULL;
+        LIST_FOR_EACH_ENTRY( thread, &thread_list, struct thread, entry )
+            if (thread->process != last) dump_process_asyncs( last = thread->process );
+    }
+    LIST_FOR_EACH_ENTRY( thread, &thread_list, struct thread, entry )
+    {
+        if (thread->queue)
+        {
+            fprintf( stderr, "wine-ps5: queue tid=%04x ", thread->id );
