+static void pw_ps4_fault_entry( int signal, void *ucontext )
+{
+    void (*handler)( int, siginfo_t *, void * );
+    siginfo_t info;
+    uint64_t addr = 0;
+
+    if (signal < 0 || signal >= PW_PS4_NSIG) return;
+    handler = pw_ps4_fault_handler[signal];
+    if (!handler) return;
