+static uintptr_t *shared_mutex_slot( obj_handle_t handle, int allocate )
+{
+    unsigned int index = (handle >> 2) - 1;
+    unsigned int page = index / PW_MUTEX_CACHE_SLOTS;
+    uintptr_t *slots;
+    if (page >= PW_MUTEX_CACHE_PAGES) return NULL;
+    slots = __atomic_load_n( &shared_mutex_pages[page], __ATOMIC_ACQUIRE );
+    if (!slots && allocate)
