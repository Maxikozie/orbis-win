+    if (!__atomic_load_n( &inprocess_direct_ok, __ATOMIC_ACQUIRE ) || !is_direct_request( req ) || size > sizeof(data)) return 1;
+    for (i = 0; i < info->data_count && i < __SERVER_MAX_DATA; i++)
+    {
+        if (info->data[i].size > size - pos) return 1;
+        memcpy( data + pos, info->data[i].ptr, info->data[i].size );
+        pos += info->data[i].size;
+    }
+    if (pos != size) return 1;
+
+    lock_server_for_client();
+    if (!__atomic_load_n( &inprocess_direct_ok, __ATOMIC_ACQUIRE ) || !(thread = get_thread_from_id( tid )))
+    {
+        ps5_mutex_server_reconcile();
+        pthread_mutex_unlock( &inprocess_server_mutex );
+        return 1;
+    }
