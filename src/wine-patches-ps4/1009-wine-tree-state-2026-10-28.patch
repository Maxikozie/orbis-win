+#ifdef __PROSPERO__
+/* The console has no inotify, no dnotify and no kqueue. A directory that is watched is polled: its entries
+ * (and those below it, when the whole subtree is watched) are listed with their identity, size and times,
+ * the list is compared with the last one, and what differs is reported the way inotify would: a name that
+ * appeared or went, a name that went and another with the same file identity that came (a rename), a file
+ * whose size or times changed. Names in a changed file's directory that do not themselves change are not
+ * reported, as on Windows. A watch that takes long to list is polled less often. */
+
+#define POLL_TICKS_PER_SEC  10000000
+#define POLL_MIN_INTERVAL   (POLL_TICKS_PER_SEC / 40)
+#define POLL_MAX_INTERVAL   (2 * POLL_TICKS_PER_SEC)
+#define POLL_MAX_ITEMS      200000
+#define POLL_MAX_DEPTH      32
+
+struct poll_item
+{
+    char   *path;        /* relative to the watched directory, '/' separated */
+    dev_t   dev;
+    ino_t   ino;
+    mode_t  mode;
+    off_t   size;
+    time_t  mtime;
+    long    mtime_nsec;
+};
+
+struct poll_watch
+{
+    struct timeout_user *timeout;
+    struct poll_item    *items;
+    unsigned int         count;
+    timeout_t            interval;
+    unsigned int         cookie;
+};
+
+static void poll_free_items( struct poll_item *items, unsigned int count )
+{
+    unsigned int i;
+    for (i = 0; i < count; i++) free( items[i].path );
+    free( items );
+}
+
+static int poll_add_item( struct poll_item **items, unsigned int *count, unsigned int *size,
+                          const char *path, const struct stat *st )
+{
+    struct poll_item *item;
+
+    if (*count >= POLL_MAX_ITEMS) return 0;
+    if (*count == *size)
+    {
+        unsigned int new_size = *size ? *size * 2 : 64;
+        struct poll_item *new_items = realloc( *items, new_size * sizeof(**items) );
+        if (!new_items) return 0;
+        *items = new_items;
+        *size = new_size;
+    }
+    item = &(*items)[*count];
+    if (!(item->path = strdup( path ))) return 0;
+    item->dev = st->st_dev;
+    item->ino = st->st_ino;
+    item->mode = st->st_mode;
+    item->size = st->st_size;
+    item->mtime = st->st_mtime;
+#ifdef __APPLE__
+    item->mtime_nsec = st->st_mtimespec.tv_nsec;
+#else
+    item->mtime_nsec = st->st_mtim.tv_nsec;
+#endif
+    (*count)++;
+    return 1;
+}
+
+static void poll_scan( const char *base, const char *rel, int subtree, int depth,
+                       struct poll_item **items, unsigned int *count, unsigned int *size )
+{
+    DIR *dp;
+    struct dirent *entry;
+    char *path;
+    size_t len = strlen( base ) + strlen( rel ) + 2;
+
+    if (!(path = malloc( len + 1 ))) return;
+    snprintf( path, len + 1, "%s%s%s", base, rel[0] ? "/" : "", rel );
+    if (!(dp = opendir( path )))
+    {
+        free( path );
+        return;
+    }
+    while ((entry = readdir( dp )))
+    {
+        char *child, *full;
+        struct stat st;
+        size_t child_len;
+
+        if (!strcmp( entry->d_name, "." ) || !strcmp( entry->d_name, ".." )) continue;
+        child_len = strlen( rel ) + strlen( entry->d_name ) + 2;
+        if (!(child = malloc( child_len + 1 ))) break;
+        snprintf( child, child_len + 1, "%s%s%s", rel, rel[0] ? "/" : "", entry->d_name );
+        if (!(full = malloc( strlen( base ) + child_len + 2 ))) { free( child ); break; }
+        sprintf( full, "%s/%s", base, child );
+        if (!lstat( full, &st ) && poll_add_item( items, count, size, child, &st ) &&
+            subtree && S_ISDIR(st.st_mode) && depth < POLL_MAX_DEPTH)
+            poll_scan( base, child, subtree, depth + 1, items, count, size );
+        free( full );
+        free( child );
+    }
+    closedir( dp );
+    free( path );
+}
