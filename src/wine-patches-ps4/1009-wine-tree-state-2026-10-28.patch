+/* Copy bytes of this process's memory if they can be read: write() reports
+ * EFAULT for an unreadable source instead of faulting. */
+static int ps5_peek( int probe[2], uintptr_t address, void *out, size_t size )
+{
+    if (write( probe[1], (const void *)(ULONG_PTR)address, size ) != (ssize_t)size) return 0;
+    return read( probe[0], out, size ) == (ssize_t)size;
+}
