+ * application's (the open requests of named objects, which carry the
+ * caller's name buffer, stay on the pipe, where a bad pointer fails the write
+ * instead of faulting; create_file carries ntdll's copy of the attributes).
+ * create_file's open() of the Unix file and get_handle_fd's sendmsg() of
+ * the descriptor are what the server thread would do for the same request.
+ * Everything else goes through the server thread. */
+static int is_direct_request( enum request req )
+{
+    switch (req)
+    {
+    case REQ_select:
+    case REQ_create_event:
+    case REQ_event_op:
+    case REQ_query_event:
+    case REQ_create_keyed_event:
+    case REQ_create_mutex:
+    case REQ_release_mutex:
+    case REQ_query_mutex:
+    case REQ_create_semaphore:
+    case REQ_release_semaphore:
+    case REQ_query_semaphore:
+    case REQ_close_handle:
+    case REQ_dup_handle:
+    case REQ_create_file:
+    case REQ_get_handle_fd:
+        return 1;
+    default:
+        return 0;
+    }
+}
