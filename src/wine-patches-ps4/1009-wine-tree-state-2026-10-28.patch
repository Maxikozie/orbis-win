+    uint32_t lines;         /* lines in use, at most PW_TITLE_MENU_LINES */
+    int32_t selected;       /* the highlighted line, or -1 */
+    char title[PW_TITLE_MENU_COLUMNS];
+    char line[PW_TITLE_MENU_LINES][PW_TITLE_MENU_COLUMNS];
+};
