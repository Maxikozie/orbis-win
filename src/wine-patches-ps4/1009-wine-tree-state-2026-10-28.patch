+    LIST_FOR_EACH_ENTRY( thread, &thread_list, struct thread, entry )
+    {
+        fprintf( stderr, "wine-ps5: thread tid=%04x suspend=%d/%d state=%d waiting=%d last_req=%d age_ms=%lld\n",
+                 thread->id, thread->suspend, thread->process->suspend, thread->state, thread->wait != NULL,
+                 thread->ps5_last_req, (long long)((monotonic_time - thread->ps5_last_req_time) / 10000) );
