From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ps4-gladius <ps4-gladius@invalid>
Date: Fri, 16 Oct 2026 16:00:00 -0700
Subject: [PATCH] server: safely probe WoW64 state in wait watchdog

The optional wait watchdog reads a WoW64 CPU pointer from a guest TEB. The
pointer can be stale or invalid, and a direct read crashes the title while
collecting diagnostics. Use the existing pipe-based fault-tolerant probe for
the TEB slot, CPU header, context fields, and guest stack words.

---
diff --git a/server/thread.c b/server/thread.c
--- a/server/thread.c
+++ b/server/thread.c
@@ -26,6 +26,7 @@
 #include <signal.h>
 #include <stdarg.h>
 #include <stdio.h>
+#include <stdint.h>
 #include <stdlib.h>
 #include <string.h>
 #include <sys/types.h>
@@ -1131,7 +1132,7 @@
 
 /* Copy bytes of this process's memory if they can be read: write() reports
  * EFAULT for an unreadable source instead of faulting. */
-static int ps5_peek( int probe[2], unsigned int address, void *out, size_t size )
+static int ps5_peek( int probe[2], uintptr_t address, void *out, size_t size )
 {
     if (write( probe[1], (const void *)(ULONG_PTR)address, size ) != (ssize_t)size) return 0;
     return read( probe[0], out, size ) == (ssize_t)size;
@@ -1141,8 +1142,10 @@
 {
     struct thread *thread;
     struct thread_wait *wait;
+    static int probe[2] = { -1, -1 };
     int i;
 
+    if (probe[0] == -1 && pipe( probe )) probe[0] = probe[1] = -1;
     fprintf( stderr, "wine-ps5: wait snapshot\n" );
     LIST_FOR_EACH_ENTRY( thread, &thread_list, struct thread, entry )
     {
@@ -1154,22 +1157,35 @@
          * The server runs in the game's process, so it can read it. */
         if (!thread->wait && thread->teb && monotonic_time - thread->ps5_last_req_time > TICKS_PER_SEC)
         {
-            const unsigned char *cpu = *(unsigned char * const *)(ULONG_PTR)(thread->teb + 0x1480 + 8);
-            if (cpu && *(const unsigned short *)(cpu + 2) == 0x14c /* IMAGE_FILE_MACHINE_I386 */)
+            uintptr_t teb = (uintptr_t)thread->teb, cpu = 0;
+            unsigned short machine;
+            unsigned int eip, esp;
+
+            /* The game thread may be running or have torn down its WoW64
+             * context. Probe every read: the watchdog must not crash the title
+             * while trying to inspect an absent or stale CPU pointer. */
+            if (probe[1] != -1 && teb <= UINTPTR_MAX - 0x1488 &&
+                ps5_peek( probe, teb + 0x1488, &cpu, sizeof(cpu) ) && cpu &&
+                cpu <= UINTPTR_MAX - (4 + 0xc8) &&
+                ps5_peek( probe, cpu + 2, &machine, sizeof(machine) ) &&
+                machine == 0x14c /* IMAGE_FILE_MACHINE_I386 */ &&
+                ps5_peek( probe, cpu + 4 + 0xb8, &eip, sizeof(eip) ) &&
+                ps5_peek( probe, cpu + 4 + 0xc4, &esp, sizeof(esp) ))
             {
-                const unsigned char *context = cpu + 4;
-                unsigned int eip = *(const unsigned int *)(context + 0xb8), esp = *(const unsigned int *)(context + 0xc4);
                 fprintf( stderr, "wine-ps5: guest tid=%04x eip=%08x esp=%08x:", thread->id, eip, esp );
-                if (esp) for (i = 0; i < 32; i++) fprintf( stderr, " %08x", ((const unsigned int *)(ULONG_PTR)esp)[i] );
+                if (esp) for (i = 0; i < 32; i++)
+                {
+                    unsigned int word;
+                    if (!ps5_peek( probe, (uintptr_t)esp + 4 * i, &word, sizeof(word) )) break;
+                    fprintf( stderr, " %08x", word );
+                }
                 fprintf( stderr, "\n" );
                 /* Critical sections among the stack's pointers: a pointer whose
                  * DebugInfo points back at it. Memory is read only after write()
                  * to a pipe accepts it, so a bad pointer is skipped, not a crash. */
                 if (esp)
                 {
-                    static int probe[2] = { -1, -1 };
                     unsigned int seen[16], nseen = 0, k;
-                    if (probe[0] == -1 && pipe( probe )) probe[0] = probe[1] = -1;
                     for (i = 0; i < 128 && probe[1] != -1; i++)
                     {
                         unsigned int word, cs[6], debug[8], dup = 0;
