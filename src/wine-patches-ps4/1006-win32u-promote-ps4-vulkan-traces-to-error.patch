From 5bc8bd11b8f4482898b40e251371a5c4 Mon Sep 17 00:00:00 2001
From: Codex <codex@localhost>
Date: Wed, 28 Oct 2026 10:30:00 -0700
Subject: [PATCH] win32u: promote bounded PS4 Vulkan traces to error level

The PS4 runtime log retained the error-level cursor-hook trace but omitted
warning-level surface, swapchain, and queue-present checkpoints in the 1016
black-screen run. Keep the existing bounded checkpoints and promote them so
the next capture identifies the last completed Vulkan presentation stage.

---
diff --git a/dlls/win32u/vulkan.c b/dlls/win32u/vulkan.c
index 740fbc338f..b5d4901c8e 100644
--- a/dlls/win32u/vulkan.c
+++ b/dlls/win32u/vulkan.c
@@ -615,13 +615,13 @@ static VkResult win32u_vkCreateInstance( const VkInstanceCreateInfo *client_crea
     list_init( &instance->utils_messengers );
     list_init( &instance->report_callbacks );
 
-    WARN( "PS4 Vulkan instance phase=convert-begin extensions=%u layers=%u\n",
+    ERR( "PS4 Vulkan instance phase=convert-begin extensions=%u layers=%u\n",
           create_info->enabledExtensionCount, create_info->enabledLayerCount );
     if ((res = convert_instance_create_info( &pool, create_info, instance ))) goto failed;
-    WARN( "PS4 Vulkan instance phase=convert-end res=%d\n", res );
-    WARN( "PS4 Vulkan instance phase=host-create-begin\n" );
+    ERR( "PS4 Vulkan instance phase=convert-end res=%d\n", res );
+    ERR( "PS4 Vulkan instance phase=host-create-begin\n" );
     if ((res = p_vkCreateInstance( create_info, NULL /* allocator */, &host_instance ))) goto failed;
-    WARN( "PS4 Vulkan instance phase=host-create-end res=%d host=%p\n", res, host_instance );
+    ERR( "PS4 Vulkan instance phase=host-create-end res=%d host=%p\n", res, host_instance );
 
     vulkan_object_init_ptr( &instance->obj.obj, (UINT_PTR)host_instance, &client_instance->obj );
     instance->obj.p_insert_object = vulkan_instance_insert_object;
@@ -1547,7 +1547,7 @@ static VkResult win32u_vkCreateWin32SurfaceKHR( VkInstance client_instance, cons
     {
         unsigned int count = __atomic_add_fetch( &ps4_surface_create_count, 1, __ATOMIC_RELAXED );
         if (count <= 8)
-            WARN( "PS4 Vulkan surface create enter #%u hwnd=%p instance=%p\n",
+            ERR( "PS4 Vulkan surface create enter #%u hwnd=%p instance=%p\n",
                   count, create_info->hwnd, instance );
     }
 #endif
@@ -1555,7 +1555,7 @@ static VkResult win32u_vkCreateWin32SurfaceKHR( VkInstance client_instance, cons
     if (!(surface = calloc( 1, sizeof(*surface) )))
     {
 #ifdef __PROSPERO__
-        WARN( "PS4 Vulkan surface create result=out-of-host-memory\n" );
+        ERR( "PS4 Vulkan surface create result=out-of-host-memory\n" );
 #endif
         return VK_ERROR_OUT_OF_HOST_MEMORY;
     }
@@ -1580,7 +1580,7 @@ static VkResult win32u_vkCreateWin32SurfaceKHR( VkInstance client_instance, cons
 
 #ifdef __PROSPERO__
     if (ps4_surface_create_count <= 8)
-        WARN( "PS4 Vulkan surface host result=%d hwnd=%p client=%p host=%p\n",
+        ERR( "PS4 Vulkan surface host result=%d hwnd=%p client=%p host=%p\n",
               res, surface->hwnd, surface->client, host_surface );
 #endif
 
@@ -1602,7 +1602,7 @@ static VkResult win32u_vkCreateWin32SurfaceKHR( VkInstance client_instance, cons
     *ret = surface->obj.client.surface;
 #ifdef __PROSPERO__
     if (ps4_surface_create_count <= 8)
-        WARN( "PS4 Vulkan surface create success client=%p\n", *ret );
+        ERR( "PS4 Vulkan surface create success client=%p\n", *ret );
 #endif
     return VK_SUCCESS;
 }
@@ -1945,7 +1945,7 @@ static VkResult win32u_vkCreateSwapchainKHR( VkDevice client_device, const VkSwa
     {
         unsigned int count = __atomic_add_fetch( &ps4_swapchain_attempt_count, 1, __ATOMIC_RELAXED );
         if (count <= 8)
-            WARN( "PS4 Vulkan swapchain enter #%u hwnd=%p client=%ux%u format=%u mode=%u images=%u\n",
+            ERR( "PS4 Vulkan swapchain enter #%u hwnd=%p client=%ux%u format=%u mode=%u images=%u\n",
                   count, surface->hwnd, create_info->imageExtent.width, create_info->imageExtent.height,
                   create_info->imageFormat, create_info->presentMode, create_info->minImageCount );
     }
@@ -1955,7 +1955,7 @@ static VkResult win32u_vkCreateSwapchainKHR( VkDevice client_device, const VkSwa
     {
         ERR( "surface %p, hwnd %p is invalid!\n", surface, surface->hwnd );
 #ifdef __PROSPERO__
-        WARN( "PS4 Vulkan swapchain surface-invalid hwnd=%p\n", surface->hwnd );
+        ERR( "PS4 Vulkan swapchain surface-invalid hwnd=%p\n", surface->hwnd );
 #endif
         return VK_ERROR_INITIALIZATION_FAILED;
     }
@@ -1967,7 +1967,7 @@ static VkResult win32u_vkCreateSwapchainKHR( VkDevice client_device, const VkSwa
     res = instance->p_vkGetPhysicalDeviceSurfaceCapabilitiesKHR( physical_device->host.physical_device, surface->obj.host.surface, &capabilities );
 #ifdef __PROSPERO__
     if (ps4_swapchain_attempt_count <= 8)
-        WARN( "PS4 Vulkan swapchain capabilities result=%d host=%ux%u extent=%ux%u..%ux%u images=%u..%u\n",
+        ERR( "PS4 Vulkan swapchain capabilities result=%d host=%ux%u extent=%ux%u..%ux%u images=%u..%u\n",
               res, capabilities.currentExtent.width, capabilities.currentExtent.height,
               capabilities.minImageExtent.width, capabilities.minImageExtent.height,
               capabilities.maxImageExtent.width, capabilities.maxImageExtent.height,
@@ -2004,21 +2004,21 @@ static VkResult win32u_vkCreateSwapchainKHR( VkDevice client_device, const VkSwa
     if (!(swapchain = calloc( 1, sizeof(*swapchain) )))
     {
 #ifdef __PROSPERO__
-        WARN( "PS4 Vulkan swapchain allocation failed\n" );
+        ERR( "PS4 Vulkan swapchain allocation failed\n" );
 #endif
         return VK_ERROR_OUT_OF_HOST_MEMORY;
     }
 
 #ifdef __PROSPERO__
     if (ps4_swapchain_attempt_count <= 8)
-        WARN( "PS4 Vulkan swapchain host-create begin extent=%ux%u images=%u format=%u mode=%u\n",
+        ERR( "PS4 Vulkan swapchain host-create begin extent=%ux%u images=%u format=%u mode=%u\n",
               create_info_host.imageExtent.width, create_info_host.imageExtent.height,
               create_info_host.minImageCount, create_info_host.imageFormat, create_info_host.presentMode );
 #endif
     res = device->p_vkCreateSwapchainKHR( device->host.device, &create_info_host, NULL, &host_swapchain );
 #ifdef __PROSPERO__
     if (ps4_swapchain_attempt_count <= 8)
-        WARN( "PS4 Vulkan swapchain host-create result=%d host=%p\n", res, host_swapchain );
+        ERR( "PS4 Vulkan swapchain host-create result=%d host=%p\n", res, host_swapchain );
 #endif
     if (res)
     {
@@ -2051,7 +2051,7 @@ static VkResult win32u_vkCreateSwapchainKHR( VkDevice client_device, const VkSwa
     {
         unsigned int count = __atomic_add_fetch( &ps4_swapchain_create_count, 1, __ATOMIC_RELAXED );
         if (count <= 8)
-            WARN( "PS4 Vulkan swapchain created #%u client=%ux%u host=%ux%u images=%u format=%u mode=%u\n",
+            ERR( "PS4 Vulkan swapchain created #%u client=%ux%u host=%ux%u images=%u format=%u mode=%u\n",
                   count, create_info->imageExtent.width, create_info->imageExtent.height,
                   create_info_host.imageExtent.width, create_info_host.imageExtent.height,
                   create_info_host.minImageCount, create_info_host.imageFormat,
@@ -2153,7 +2153,7 @@ static VkResult win32u_vkQueuePresentKHR( VkQueue client_queue, const VkPresentI
     {
         unsigned int count = __atomic_add_fetch( &ps4_queue_present_entry_count, 1, __ATOMIC_RELAXED );
         if (count <= 8)
-            WARN( "PS4 Vulkan present enter #%u queue=%p swapchains=%u waits=%u\n",
+            ERR( "PS4 Vulkan present enter #%u queue=%p swapchains=%u waits=%u\n",
                   count, queue, present_info->swapchainCount, present_info->waitSemaphoreCount );
     }
 #endif
@@ -2162,7 +2162,7 @@ static VkResult win32u_vkQueuePresentKHR( VkQueue client_queue, const VkPresentI
         !(swapchains = malloc( present_info->swapchainCount * sizeof(*swapchains) )))
     {
 #ifdef __PROSPERO__
-        WARN( "PS4 Vulkan present allocation failed swapchains=%u\n", present_info->swapchainCount );
+        ERR( "PS4 Vulkan present allocation failed swapchains=%u\n", present_info->swapchainCount );
 #endif
         return VK_ERROR_OUT_OF_HOST_MEMORY;
     }
@@ -2201,7 +2201,7 @@ static VkResult win32u_vkQueuePresentKHR( VkQueue client_queue, const VkPresentI
                                      present_info->pResults[0] : res;
             unsigned int image = present_info->swapchainCount && present_info->pImageIndices ?
                                  present_info->pImageIndices[0] : 0;
-            WARN( "PS4 Vulkan present #%u result=%d first=%d swapchains=%u waits=%u image=%u\n",
+            ERR( "PS4 Vulkan present #%u result=%d first=%d swapchains=%u waits=%u image=%u\n",
                   count, res, swapchain_res, present_info->swapchainCount,
                   present_info->waitSemaphoreCount, image );
         }
