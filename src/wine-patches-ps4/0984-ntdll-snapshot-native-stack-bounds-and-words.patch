From: Codex <codex@local>
Subject: ntdll: record native stack bounds and words for samples

Expose the sampled native TEB stack bounds and a bounded window of words at
the interrupted stack pointer. This diagnoses why guarded frame-chain capture
can return empty records.

---
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -104,6 +104,8 @@
 static volatile unsigned long long pw_native_pc_rsp0;
 static volatile unsigned long long pw_native_pc_teb;
 static volatile unsigned long long pw_native_pc_frames64[8];
+static volatile unsigned long long pw_native_pc_stack_limit, pw_native_pc_stack_base;
+static volatile unsigned long long pw_native_pc_stack_words[8];
 
 __attribute__((visibility("default")))
 unsigned int __wine_prospero_native_wow64_caps( unsigned int version )
@@ -124,7 +126,10 @@
                                                      unsigned long long *rbp,
                                                      unsigned long long *rsp0,
                                                      unsigned long long *sample_teb,
-                                                     unsigned long long *frames64 )
+                                                     unsigned long long *frames64,
+                                                     unsigned long long *stack_limit,
+                                                     unsigned long long *stack_base,
+                                                     unsigned long long *stack_words )
 {
     unsigned long long seq = __atomic_load_n( &pw_native_pc_sequence, __ATOMIC_ACQUIRE );
     if (sequence) *sequence = seq;
@@ -141,6 +146,10 @@
     if (sample_teb) *sample_teb = __atomic_load_n( &pw_native_pc_teb, __ATOMIC_RELAXED );
     if (frames64) for (unsigned int i = 0; i < 8; ++i)
         frames64[i] = __atomic_load_n( &pw_native_pc_frames64[i], __ATOMIC_RELAXED );
+    if (stack_limit) *stack_limit = __atomic_load_n( &pw_native_pc_stack_limit, __ATOMIC_RELAXED );
+    if (stack_base) *stack_base = __atomic_load_n( &pw_native_pc_stack_base, __ATOMIC_RELAXED );
+    if (stack_words) for (unsigned int i = 0; i < 8; ++i)
+        stack_words[i] = __atomic_load_n( &pw_native_pc_stack_words[i], __ATOMIC_RELAXED );
     return 1;
 }
 
@@ -1116,12 +1125,27 @@
     __atomic_store_n( &pw_native_pc_rbp, RBP_sig(context), __ATOMIC_RELAXED );
     __atomic_store_n( &pw_native_pc_teb, (uintptr_t)data->teb, __ATOMIC_RELAXED );
     for (unsigned int i = 0; i < 8; ++i)
+    {
         __atomic_store_n( &pw_native_pc_frames64[i], 0, __ATOMIC_RELAXED );
-    if (data->teb && (CS_sig(context) & 0xffff) == 0x43)
-    {
-        ULONG_PTR frame = RBP_sig(context);
-        ULONG_PTR stack_limit = (ULONG_PTR)data->teb->Tib.StackLimit;
-        ULONG_PTR stack_base = (ULONG_PTR)data->teb->Tib.StackBase;
+        __atomic_store_n( &pw_native_pc_stack_words[i], 0, __ATOMIC_RELAXED );
+    }
+    {
+        ULONG_PTR stack_limit = data->teb ? (ULONG_PTR)data->teb->Tib.StackLimit : 0;
+        ULONG_PTR stack_base = data->teb ? (ULONG_PTR)data->teb->Tib.StackBase : 0;
+        ULONG_PTR rsp = RSP_sig(context);
+        __atomic_store_n( &pw_native_pc_stack_limit, stack_limit, __ATOMIC_RELAXED );
+        __atomic_store_n( &pw_native_pc_stack_base, stack_base, __ATOMIC_RELAXED );
+        if ((CS_sig(context) & 0xffff) == 0x43 && stack_base > stack_limit &&
+            rsp >= stack_limit && rsp <= stack_base - sizeof(ULONG_PTR))
+        {
+            for (unsigned int i = 0; i < 8 && rsp <= stack_base - (i + 1) * sizeof(ULONG_PTR); ++i)
+                __atomic_store_n( &pw_native_pc_stack_words[i],
+                                  *(const volatile ULONG_PTR *)(rsp + i * sizeof(ULONG_PTR)),
+                                  __ATOMIC_RELAXED );
+        }
+        if (data->teb && (CS_sig(context) & 0xffff) == 0x43)
+        {
+            ULONG_PTR frame = RBP_sig(context);
         if (stack_base > stack_limit && stack_base - stack_limit >= 2 * sizeof(ULONG_PTR) &&
             (frame & 7) == 0 && frame >= stack_limit && frame <= stack_base - 2 * sizeof(ULONG_PTR))
         {
@@ -1135,6 +1159,7 @@
                     previous - frame > 0x100000) break;
                 frame = previous;
             }
+        }
         }
     }
     {
