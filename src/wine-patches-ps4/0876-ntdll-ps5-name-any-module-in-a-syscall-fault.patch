From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: prospero-win <prospero-win@invalid>
Subject: [PATCH] ntdll: Name the module and syscall in a syscall fault on ps5.

With the loader finished, GTA IV runs its own code and ends on a fault
inside a syscall: c0000005, the same registers on every run, rcx holding
0x58585858. The existing report fell to its bare-address branch, because
dladdr here is pw_wine_dl, which knows only the modules it opened or
adopted -- ours -- and this address was below ntdll's base.

Fall back to the kernel, which knows every module. sceKernelGetModuleInfo
is already declared in this file as (int32_t, void *) and the SDK's own
types are not in scope, so take the buffer the way pw_native_resolve_kernel
does -- 0x160 opaque bytes with its size at the front -- using the layout
native_libkernel_resolver.c already settles: name at 8, four 16-byte
segments at 0x108, their count at 0x148.

That named it libSceLibcInternal.sprx+0x51eca, faulting on 2202daf860:
Sony's own libc, called from a Wine syscall and walking off a buffer.
Which syscall the module cannot say, so print syscall_id as well -- its
low bits index the table and bit 12 picks win32u's over ntdll's -- and
the return ip. The fault arrives during USER32's PROCESS_ATTACH, directly
after Wine reports no FreeType, so a win32u font call is the one to
expect; this says so rather than assuming it.

Diagnostic only; no behaviour changes.

diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
index 2956c64e1c..491f702643 100644
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -2151,6 +2151,56 @@ static BOOL check_atl_thunk( struct thread_data *data, ucontext_t *sigcontext,
 }
 
 
+#ifdef __PROSPERO__
+/* ⚠ dladdr only knows the modules pw_wine_dl opened or adopted, which is ours
+ * and nothing else, so a syscall faulting inside the shared libc -- or any
+ * module the system loader brought in -- printed a bare address. GTA IV's did,
+ * at 8000e1eca, identically on every run, and three of our own PRXs have a
+ * plausible symbol at that offset, so the address alone settles nothing.
+ *
+ * The kernel knows them all. Ask it which module's segments contain the
+ * address; for a module we have no symbols for, the name is worth more than a
+ * symbol would be anyway. */
+static int pw_module_at( const void *address, char *name, size_t size, unsigned long *offset )
+{
+    /* ⚠ sceKernelGetModuleInfo is already declared above as (int32_t, void *),
+     * and the SDK's own types are not in scope here, so take the buffer the way
+     * pw_native_resolve_kernel does: 0x160 opaque bytes with its size written
+     * at the front. native_libkernel_resolver.c settles the layout -- name at
+     * 8, four 16-byte segments {address, size, prot} at 0x108, their count at
+     * 0x148. That is OrbisKernelModuleInfo exactly: 8 + 256 + 64 + 4 + 20. */
+    extern int sceKernelGetModuleList( int32_t *array, size_t count, size_t *available );
+    unsigned char info[0x160];
+    int32_t handles[192];
+    size_t available = 0, i;
+    unsigned int seg, count;
+    uint64_t want = sizeof(info), base;
+    uint32_t span;
+
+    if (sceKernelGetModuleList( handles, ARRAY_SIZE(handles), &available )) return 0;
+    if (available > ARRAY_SIZE(handles)) available = ARRAY_SIZE(handles);
+    for (i = 0; i < available; i++)
+    {
+        memset( info, 0, sizeof(info) );
+        memcpy( info, &want, sizeof(want) );
+        if (sceKernelGetModuleInfo( handles[i], info )) continue;
+        memcpy( &count, info + 0x148, sizeof(count) );
+        for (seg = 0; seg < count && seg < 4; seg++)
+        {
+            memcpy( &base, info + 0x108 + seg * 16, sizeof(base) );
+            memcpy( &span, info + 0x108 + seg * 16 + 8, sizeof(span) );
+            if ((uintptr_t)address < base) continue;
+            if ((uintptr_t)address >= base + span) continue;
+            info[8 + 255] = 0;
+            snprintf( name, size, "%s", (const char *)info + 8 );
+            *offset = (unsigned long)((uintptr_t)address - base);
+            return 1;
+        }
+    }
+    return 0;
+}
+#endif
+
 /***********************************************************************
  *           handle_syscall_fault
  *
@@ -2183,18 +2233,60 @@ static BOOL handle_syscall_fault( struct thread_data *data, ucontext_t *sigconte
          * success: user32 took STATUS_ACCESS_VIOLATION for a class atom. */
         void *where = context->Rip ? (void *)context->Rip : context->Rsp ? *(void **)context->Rsp : NULL;
         Dl_info info;
+        char pw_modname[256];
+        unsigned long pw_modoff = 0;
 
         if (where && dladdr( where, &info ) && info.dli_fname)
             ERR_(seh)( "syscall fault %#x %s %s+%#lx, address %p\n", (int)rec->ExceptionCode,
                        context->Rip ? "at" : "calling NULL from", info.dli_fname,
                        (unsigned long)((char *)where - (char *)info.dli_fbase),
                        rec->NumberParameters > 1 ? (void *)rec->ExceptionInformation[1] : NULL );
+        else if (where && pw_module_at( where, pw_modname, sizeof(pw_modname), &pw_modoff ))
+            ERR_(seh)( "syscall fault %#x %s %s+%#lx, address %p\n", (int)rec->ExceptionCode,
+                       context->Rip ? "at" : "calling NULL from", pw_modname, pw_modoff,
+                       rec->NumberParameters > 1 ? (void *)rec->ExceptionInformation[1] : NULL );
         else
             ERR_(seh)( "syscall fault %#x %s %p\n", (int)rec->ExceptionCode,
                        context->Rip ? "at" : "calling NULL from", where );
     }
 #endif
 
+#ifdef __PROSPERO__
+    /* ⚠ The module says where it died, not what was running. syscall_id names
+     * the call: its low bits index the table, bit 12 picks win32u's over
+     * ntdll's, so a fault reached through a font or window call is told apart
+     * from one in a file or memory call without reading the stack. GTA IV's
+     * arrives during USER32's PROCESS_ATTACH, right after Wine reports no
+     * FreeType, which makes a win32u font call the one to expect. */
+    if ((frame = get_syscall_frame( data )))
+        ERR_(seh)( "syscall fault in syscall %#x (%s #%u), return ip %p\n",
+                   (unsigned int)frame->syscall_id,
+                   (frame->syscall_id & 0x1000) ? "win32u" : "ntdll",
+                   (unsigned int)(frame->syscall_id & 0xfff), (void *)frame->rip );
+
+    /* ⚠ And that name can be stale. get_syscall_frame returns the most recent
+     * frame, not necessarily a live one: on GTA IV's crash it named win32u
+     * #828 (NtUserCallNoParam) while staging thread_detach showed that call
+     * running to completion 1.6 ms earlier. Read the line above as "the last
+     * syscall this thread made", not as where it died.
+     *
+     * The registers are not stale, and they are already dumped a few lines up
+     * at TRACE -- which is off in every configuration this port runs. A
+     * syscall fault is rare enough to afford them at ERR, and the faulting
+     * address is only interpretable once it can be traced to a register: GTA
+     * IV's has the shape 0x453a_<32 bits> across three runs, the same top half
+     * with a plausible i386 address below it. */
+    ERR_(seh)( "fault regs rip=%016lx rsp=%016lx rbp=%016lx rax=%016lx rbx=%016lx\n",
+               context->Rip, context->Rsp, context->Rbp, context->Rax, context->Rbx );
+    ERR_(seh)( "fault regs rcx=%016lx rdx=%016lx rsi=%016lx rdi=%016lx r8=%016lx\n",
+               context->Rcx, context->Rdx, context->Rsi, context->Rdi, context->R8 );
+    ERR_(seh)( "fault regs r9=%016lx r10=%016lx r11=%016lx r12=%016lx r13=%016lx\n",
+               context->R9, context->R10, context->R11, context->R12, context->R13 );
+    ERR_(seh)( "fault regs r14=%016lx r15=%016lx\n", context->R14, context->R15 );
+
+    /* Context.Rsp can be an unmapped WoW64 stack address. */
+#endif
+
     if (data->jmp_buf)
     {
         TRACE_(seh)( "returning to handler\n" );
