+                     uint64_t live_lo = 0, live_hi = 0;
+                     uint32_t live_bo = 0;
+                     if (orbis_va_mapping_of(base, &live_lo, &live_hi, &live_bo))
+                        mesa_logi("orbis-drm:   V# candidate[%u] base 0x%" PRIx64 " -> live BO %u, offset 0x%" PRIx64
+                                  ", 0x%" PRIx64 " bytes remain", d, base, live_bo, base - live_lo, live_hi - base);
+                     else
+                        mesa_logi("orbis-drm:   V# candidate[%u] base 0x%" PRIx64 " is not in a live BO mapping", d,
+                                  base);
+                  }
                }
