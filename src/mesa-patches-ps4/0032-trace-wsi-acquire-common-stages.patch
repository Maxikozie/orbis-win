 #include "util/macros.h"
 #include "util/os_file.h"
 #include "util/os_time.h"
@@ -51,6 +54,9 @@
 #endif
 
 uint64_t WSI_DEBUG;
+#ifdef HAVE_ORBIS_PLATFORM
+static int32_t orbis_acquire_stage_count;
