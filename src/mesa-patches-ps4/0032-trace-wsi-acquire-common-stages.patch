    if (result != VK_SUCCESS && result != VK_SUBOPTIMAL_KHR)
       return result;
    struct wsi_image *image =
@@ -2299,23 +2321,55 @@ wsi_common_acquire_next_image2(const struct wsi_device *wsi,
