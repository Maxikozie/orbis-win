+      if (trace_this)
+         mesa_logi("wsi/orbis: 0032 acquire #%d semaphore signal return result=%d",
+                   trace, signal_result);
+#endif
       if (signal_result != VK_SUCCESS)
          return signal_result;
    }
 
    if (pAcquireInfo->fence != VK_NULL_HANDLE) {
+#ifdef HAVE_ORBIS_PLATFORM
+      if (trace_this)
+         mesa_logi("wsi/orbis: 0032 acquire #%d fence signal enter", trace);
+#endif
       VkResult signal_result =
          wsi_signal_fence_for_image(device, swapchain, image,
