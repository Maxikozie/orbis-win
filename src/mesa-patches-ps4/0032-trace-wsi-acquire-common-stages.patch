+#ifdef HAVE_ORBIS_PLATFORM
+      if (trace_this)
+         mesa_logi("wsi/orbis: 0032 acquire #%d memory ownership enter", trace);
+#endif
       wsi->set_memory_ownership(swapchain->device, image->memory, true);
+#ifdef HAVE_ORBIS_PLATFORM
+      if (trace_this)
+         mesa_logi("wsi/orbis: 0032 acquire #%d memory ownership return", trace);
+#endif
+   }
+
+#ifdef HAVE_ORBIS_PLATFORM
