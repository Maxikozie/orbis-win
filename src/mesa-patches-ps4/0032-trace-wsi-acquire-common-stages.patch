 static const struct debug_control debug_control[] = {
    { "buffer",       WSI_DEBUG_BUFFER },
@@ -2289,8 +2295,24 @@ wsi_common_acquire_next_image2(const struct wsi_device *wsi,
    VK_FROM_HANDLE(wsi_swapchain, swapchain, pAcquireInfo->swapchain);
    VK_FROM_HANDLE(vk_device, device, _device);
 
+#ifdef HAVE_ORBIS_PLATFORM
+   const int32_t trace = p_atomic_inc_return(&orbis_acquire_stage_count);
+   const bool trace_this = trace <= 8 || trace >= 1024;
+   if (trace_this)
+      mesa_logi("wsi/orbis: 0032 acquire #%d common entry timeout=%llu sem=%u fence=%u",
+                trace, (unsigned long long)pAcquireInfo->timeout,
+                pAcquireInfo->semaphore != VK_NULL_HANDLE,
+                pAcquireInfo->fence != VK_NULL_HANDLE);
+   if (trace_this)
+      mesa_logi("wsi/orbis: 0032 acquire #%d image callback enter", trace);
+#endif
    VkResult result = swapchain->acquire_next_image(swapchain, pAcquireInfo,
                                                    pImageIndex);
+#ifdef HAVE_ORBIS_PLATFORM
+   if (trace_this)
+      mesa_logi("wsi/orbis: 0032 acquire #%d image callback return result=%d image=%u",
+                trace, result, pImageIndex != NULL ? *pImageIndex : 0);
