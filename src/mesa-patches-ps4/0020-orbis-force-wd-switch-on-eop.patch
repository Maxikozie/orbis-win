+static bool
+radv_orbis_force_wd_switch_on_eop(void)
+{
+   static int force = -1;
+
+   if (force < 0) {
+      const char *const e = getenv("ORBIS_FORCE_WD_SWITCH_ON_EOP");
+      force = e && e[0] == '1' && e[1] == '\0';
+      if (force)
+         mesa_logi("radv/orbis: forcing WD_SWITCH_ON_EOP for the Neo draw-path experiment");
+   }
+
+   return force;
+}
+
+static bool
+radv_orbis_disable_ia_switch_on_eoi(void)
+{
+   static int disable = -1;
+
+   if (disable < 0) {
+      const char *const e = getenv("ORBIS_DISABLE_IA_SWITCH_ON_EOI");
+      disable = e && e[0] == '1' && e[1] == '\0';
+      if (disable)
+         mesa_logi("radv/orbis: disabling IA_SWITCH_ON_EOI for the Neo draw-path experiment");
+   }
+
+   return disable;
+}
